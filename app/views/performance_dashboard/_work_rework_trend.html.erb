<% keys = @selected_owners.map { |owner| owner.id.to_s } %>
<% dates = @work_rework_months.fetch(keys.first).keys %>
<% plot = dates.map { |day| keys.to_h { |id| [id, TicketJourneyWorkRework.rework_percent(@work_rework_months.fetch(id).fetch(day))] } } %>
<% geometry = performance_leaderboard_geometry(plot, keys: keys, scale_values: [100], percent: true) %>
<details class="performance-leaderboard" data-performance-leaderboard>
  <summary>Show five-month Rework % trend</summary>
  <p>Lower is better. Each point covers <%= @periodic_time ? 'tickets completed in that month' : 'tickets open at that month end' %> and their visible hours through month end.</p>
  <div class="performance-leaderboard-layout">
    <div class="autoscroll">
      <svg class="performance-trend-chart" viewBox="0 0 860 285" role="img" aria-labelledby="work-rework-trend-title">
        <title id="work-rework-trend-title">Rework percentage by owner over five completed months</title>
        <% geometry[:ticks].each do |tick| %>
          <% y = 235 - tick / geometry[:maximum] * 200 %>
          <line class="performance-trend-grid" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>"/>
          <text x="78" y="<%= y + 5 %>" text-anchor="end"><%= performance_number(tick) %>%</text>
        <% end %>
        <% dates.each_with_index do |day, index| %>
          <text x="<%= geometry[:series].first[index][:x] %>" y="268" text-anchor="middle"><%= day.strftime('%b %Y') %></text>
        <% end %>
        <% @selected_owners.each_with_index do |owner, index| %>
          <% series = geometry[:series][index] %>
          <g class="performance-trend-series" data-leaderboard-series="<%= owner.id %>" style="stroke:<%= performance_owner_color(owner.id) %>;fill:<%= performance_owner_color(owner.id) %>">
            <% series.each_cons(2) do |left, right| %>
              <% if left[:y] && right[:y] %><line x1="<%= left[:x] %>" y1="<%= left[:y] %>" x2="<%= right[:x] %>" y2="<%= right[:y] %>"/><% end %>
            <% end %>
            <% series.each do |point| %>
              <% next unless point[:y] %>
              <% label = "#{owner.name} · #{format_date(dates[point[:index]])}: #{performance_number(plot[point[:index]][owner.id.to_s])}%" %>
              <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="5" tabindex="0" aria-label="<%= label %>"><title><%= label %></title></circle>
            <% end %>
          </g>
        <% end %>
      </svg>
    </div>
    <div class="performance-leaderboard-legend">
      <% @selected_owners.each do |owner| %>
        <button type="button" data-leaderboard-toggle="<%= owner.id %>" data-owner-name="<%= owner.name %>" aria-pressed="true" aria-label="Hide <%= owner.name %> line"><span class="performance-leaderboard-swatch" style="border-color:<%= performance_owner_color(owner.id) %>" aria-hidden="true"></span><%= owner.name %></button>
      <% end %>
    </div>
  </div>
  <div class="autoscroll"><table class="list">
    <thead><tr><th scope="col">Owner</th><% dates.each do |day| %><th scope="col"><%= day.strftime('%b %Y') %></th><% end %></tr></thead>
    <tbody><% @selected_owners.each do |owner| %>
      <tr><th scope="row"><%= owner.name %></th><% plot.each do |point| %><td><%= point[owner.id.to_s].nil? ? 'N/A' : "#{performance_number(point[owner.id.to_s])}%" %></td><% end %></tr>
    <% end %></tbody>
  </table></div>
</details>
