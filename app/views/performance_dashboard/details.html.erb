<% html_title 'Performance', @detail_title %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'performance', plugin: 'redmine_ticket_journey' %>
  <%= javascript_include_tag 'performance_navigation', plugin: 'redmine_ticket_journey', defer: true %>
<% end %>
<%= render 'header', page_title: @detail_title, show_filters: false %>
<p><%= link_to '← Back to Performance', performance_dashboard_path(@project, **performance_owner_params, as_of: @date.iso8601), data: { performance_back: true }, title: 'Return to the previous Performance report when available. Click Apply there to refresh its results.' %></p>
<p><strong><%= @owner_label %></strong> · As of <%= format_date(@date) %> · <%= @detail_count %> tickets · Total usable complexity weight: <%= performance_number(@detail_weight) %></p>
<p>Scope: Selected project and all subprojects, limited to visible projects and tickets.</p>
<p class="info">Current Ticket Owner is used; status reflects the selected date. Project, title/subject, tracker, priority, PM estimate, due date and complexity weight are current. Time Spent is lifetime visible hours logged directly against the ticket, excluding child-ticket rollups; it is not limited to the report date. PM Estimate is Redmine's Estimated time in hours. These are the same ticket sets used by the dashboard, recalculated with your current permissions; edits since opening the dashboard may change results. Unavailable weights contribute zero to the total.</p>
<% if %w[open not_overdue started untouched stopped due_soon missing_due].include?(@metric) %><p>Open-ticket metrics exclude New and On-Hold based on status at the selected report date. Stopped includes Pending only.</p><% end %>
<% if %w[due done delivered delivered_weight missing_delivery].include?(@metric) %><p>Section 2 excludes Archived and Ongoing tickets based on their status at the selected report date.</p><% end %>
<% if %w[delivered delivered_weight].include?(@metric) %><p>Monthly contributors from <%= format_date(@report[:monthly_start_date]) %> through <%= format_date(@report[:monthly_end_date]) %>. The dashboard divides these totals by 3, including zero-delivery months, then by <%= @selected_owners.size %> selected owner(s) for per-owner actuals. This list contains all contributors. The selected date's month is excluded; current owner is used; status still reflects the selected date.</p><% end %>
<details class="performance-list-options">
  <summary>Options → Columns and grouping</summary>
  <%= form_tag performance_dashboard_path(@project), method: :get do %>
    <% performance_owner_params.each do |key, value| %>
      <% Array(value).each do |owner_id| %><%= hidden_field_tag(key == :owner_ids ? 'owner_ids[]' : 'owner_id', owner_id, id: nil) %><% end %>
    <% end %>
    <%= hidden_field_tag :as_of, @date.iso8601 %><%= hidden_field_tag :metric, @metric %>
    <%= hidden_field_tag :sort, @sort %><%= hidden_field_tag :direction, @direction %>
    <%= hidden_field_tag :detail_options, '1' %>
    <fieldset><legend>Columns</legend>
      <span>Ticket (always shown)</span>
      <% TicketJourneyPerformance::DETAIL_COLUMNS.except('id').each do |key, label| %>
        <label title="<%= performance_detail_column_tip(key) %>"><%= check_box_tag 'detail_columns[]', key, @detail_columns.include?(key), id: "detail-column-#{key}" %> <%= label %></label>
      <% end %>
    </fieldset>
    <%= label_tag :group_by, 'Group by' %>
    <%= select_tag :group_by, options_for_select([['None', ''], ['Project', 'project'], ['Tracker', 'tracker'], ['Ticket Owner (current)', 'owner'], ['Status (as of date)', 'status']], @group_by) %>
    <%= submit_tag 'Apply Options', name: nil %>
  <% end %>
</details>
<p>Click a sortable column heading to sort <%= @group_by ? 'within the selected groups' : 'across the whole list' %>. Sorting and grouping apply before pagination; missing values stay last. Group totals, when enabled, cover all pages.</p>
<% if @matching_issue_ids.any? %>
  <p><%= link_to 'Open matching tickets in Issues (current values)', performance_current_issues_path, title: 'Open all matching ticket IDs in the standard Redmine Issues list. Owner, status, and other fields show current values. You can change columns, grouping, and save the query there.' %></p>
<% end %>
<% if @detail_rows.empty? %>
  <p class="nodata">No tickets match this metric.</p>
<% else %>
  <div class="autoscroll"><table class="list issues">
    <thead><tr><% @detail_columns.each do |key| %><th scope="col" title="<%= performance_detail_column_tip(key) %>"><%= TicketJourneyPerformance::DETAIL_SORT_KEYS.include?(key) ? performance_sort_heading(TicketJourneyPerformance::DETAIL_COLUMNS.fetch(key), key) : TicketJourneyPerformance::DETAIL_COLUMNS.fetch(key) %></th><% end %></tr></thead>
        <tbody><% @detail_rows.group_by { |row| TicketJourneyPerformance.detail_group_key(row, @group_by) }.each do |group_key, page_rows| %>
      <% if @group_by %>
        <% totals = @group_totals.fetch(group_key) %>
        <tr class="group"><th colspan="<%= @detail_columns.size %>" scope="rowgroup"><%= page_rows.first[TicketJourneyPerformance::DETAIL_GROUPS.fetch(@group_by)].presence || 'Unknown' %> — <%= totals[:count] %> tickets · Complexity Weight: <%= performance_number(totals[:weight]) %> (whole group; <%= page_rows.size %> tickets on this page)</th></tr>
      <% end %>
      <% page_rows.each do |row| %>
      <% issue = @detail_issues.fetch(row[:id]) %>
      <tr class="performance-ticket-row"><% @detail_columns.each do |key| %><td class="<%= 'subject' if key == 'subject' %>"><%= performance_detail_cell(key, row, issue) %></td><% end %></tr>
    <% end %><% end %></tbody>
  </table></div>
<% end %>
<p>Page <%= @page %> of <%= @page_count %> · Up to 100 tickets per page
  <% if @page > 1 %> · <%= link_to 'Previous', performance_dashboard_path(@project, **performance_detail_params(page: @page - 1)) %><% end %>
  <% if @page < @page_count %> · <%= link_to 'Next', performance_dashboard_path(@project, **performance_detail_params(page: @page + 1)) %><% end %>
</p>
