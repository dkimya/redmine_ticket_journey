<section class="performance-leaderboard-report-month">
  <% slot_width = 680.0 / entries.size %>
  <% bar_width = [slot_width * 0.65, 60].min %>
  <% height_for = ->(weight) { weight / geometry[:maximum] * 200 } %>
  <% targets = entries.map { |entry| entry[:target] } %>
  <% shared_target = targets.first if targets.uniq.one? %>
  <div class="autoscroll">
    <svg class="performance-trend-chart performance-leaderboard-chart" viewBox="0 0 860 285" role="img" aria-labelledby="report-month-chart-title">
      <title id="report-month-chart-title">Report Month — Delivered + Open · <%= report_range %></title>
      <text x="90" y="18" class="performance-report-month-title">Report Month — Delivered + Open</text>
      <% geometry[:ticks].each do |tick| %>
        <% y = 235 - height_for.call(tick) %>
        <line class="performance-trend-grid" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>" />
        <text x="78" y="<%= y + 5 %>" text-anchor="end"><%= performance_number(tick) %></text>
      <% end %>
      <% entries.each_with_index do |entry, index| %>
        <% month = entry.fetch(:report_month) %>
        <% delivered, open = month.values_at(:delivered_weight, :open_weight) %>
        <% x = 90 + (index + 0.5) * slot_width %>
        <% delivered_height = height_for.call(delivered); open_height = height_for.call(open) %>
        <% description = "#{entry[:owner].name}: #{performance_number(delivered)} CW delivered, #{performance_number(open)} CW open" %>
        <g class="performance-report-month-column" tabindex="0" role="img" aria-label="<%= description %>">
          <title><%= description %></title>
          <rect class="performance-report-month-delivered" x="<%= x - bar_width / 2 %>" y="<%= 235 - delivered_height %>" width="<%= bar_width %>" height="<%= delivered_height %>" />
          <rect class="performance-report-month-open" x="<%= x - bar_width / 2 %>" y="<%= 235 - delivered_height - open_height %>" width="<%= bar_width %>" height="<%= open_height %>" />
        </g>
        <% if shared_target.nil? && entry[:target] %>
          <% y = 235 - height_for.call(entry[:target]) %>
          <line class="performance-report-month-target" x1="<%= x - slot_width * 0.45 %>" x2="<%= x + slot_width * 0.45 %>" y1="<%= y %>" y2="<%= y %>"><title>Target: <%= performance_number(entry[:target]) %> CW</title></line>
        <% end %>
        <text x="<%= x %>" y="268" text-anchor="middle"><%= index + 1 %></text>
      <% end %>
      <% if shared_target %>
        <% y = 235 - height_for.call(shared_target) %>
        <line class="performance-report-month-target" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>" />
        <text class="performance-leaderboard-target-label" x="100" y="<%= y - 5 %>">Target: <%= performance_number(shared_target) %></text>
      <% end %>
    </svg>
  </div>
  <p><%= report_range %> · CW = usable complexity weight</p>
  <p><span class="performance-dot performance-report-month-delivered" aria-hidden="true"></span> Delivered
     · <span class="performance-dot performance-report-month-open" aria-hidden="true"></span> Open
     · Dashed marks show full-month targets</p>
  <p><%= entries.each_with_index.map { |entry, index| "#{index + 1}. #{entry[:owner].name}" }.join(' · ') %></p>
  <details class="performance-trend-values"><summary>View owner values and ticket counts</summary>
    <div class="autoscroll"><table class="list">
      <thead><tr><th>Owner</th><th>Delivered</th><th>Open</th><th>Open and due</th><th>Monthly target</th></tr></thead>
      <tbody>
        <% entries.each_with_index do |entry, index| %>
          <% month = entry.fetch(:report_month) %>
          <tr class="performance-report-month-owner">
            <th scope="row"><%= index + 1 %>. <%= entry[:owner].name %></th>
            <td><%= performance_number(month[:delivered_weight]) %> CW · <%= pluralize(month[:delivered_count], 'ticket') %></td>
            <td><%= performance_number(month[:open_weight]) %> CW · <%= pluralize(month[:open_count], 'ticket') %></td>
            <td><%= performance_number(month[:due_open_weight]) %> CW · <%= pluralize(month[:due_open_count], 'ticket') %></td>
            <td><%= performance_number(entry[:target]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  </details>
</section>
