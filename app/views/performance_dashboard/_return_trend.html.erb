<div class="performance-return-trend">
  <h4>Return Ticket Metric Trend — Open Tickets <%= performance_tip('Each completed month-end uses its open tickets and all their qualifying returns through that date. Divide incidents by open tickets with at least one return. No returned tickets means N/A. This is a snapshot, not returns occurring only within the month. Current owner, project scope and visibility apply.') %></h4>
  <p>Month-end snapshots · Same selected owners · Cards above show <%= format_date(@date) %></p>
  <ul class="performance-trend-legend"><li><span class="performance-trend-swatch"></span>All incidents / returned open tickets · Lower is better</li></ul>
  <% geometry = performance_return_trend_geometry(points, keys: [:ratio], minimum: 1.0) %>
  <div class="autoscroll">
    <svg class="performance-trend-chart" viewBox="0 0 860 285" role="img" aria-labelledby="return-trend-title return-trend-description">
      <title id="return-trend-title">Incidents per returned open ticket at the last five month ends</title>
      <desc id="return-trend-description">Average incident counts, not percentages. Missing points are not joined. Exact values and contributing counts are in the table below.</desc>
      <% 0.upto(4) do |index| %>
        <% y = 235 - index * 50 %>
        <line class="performance-trend-grid" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>" />
        <text x="78" y="<%= y + 5 %>" text-anchor="end"><%= performance_number(index * geometry[:step]) %></text>
      <% end %>
      <% points.each_with_index do |point, index| %>
        <text x="<%= geometry[:series].first[index][:x] %>" y="268" text-anchor="middle"><%= format_date(point[:date]) %></text>
      <% end %>
      <% geometry[:series].each do |series| %>
        <g class="performance-trend-series">
          <% series.each_cons(2) do |left, right| %>
            <% if left[:y] && right[:y] %><line x1="<%= left[:x] %>" y1="<%= left[:y] %>" x2="<%= right[:x] %>" y2="<%= right[:y] %>" /><% end %>
          <% end %>
          <% series.each do |coordinate| %>
            <% next unless coordinate[:y] %>
            <% point = points[coordinate[:index]] %>
            <% description = "#{format_date(point[:date])}: #{performance_number(point[:ratio])} incidents per returned ticket; #{point[:incidents]} incidents / #{point[:returned]} returned open tickets; #{point[:open]} open tickets overall" %>
            <circle cx="<%= coordinate[:x] %>" cy="<%= coordinate[:y] %>" r="7" tabindex="0" role="img" aria-label="<%= description %>"><title><%= description %></title></circle>
          <% end %>
        </g>
      <% end %>
    </svg>
  </div>
  <details class="performance-trend-values"><summary>View monthly values and counts</summary>
    <div class="autoscroll"><table class="list">
      <thead><tr><th>Month end</th><th>Open Tickets</th><th>Returned Open Tickets</th><th>Total Return Incidents</th><th>Incidents / Returned Open Tickets</th><th>Non-Merge Incidents</th><th>Legacy Non-Merge / All Open Tickets (%)</th></tr></thead>
      <tbody><% points.each do |point| %><tr>
        <th><%= format_date(point[:date]) %></th><td><%= point[:open] %></td><td><%= point[:returned] %></td><td><%= point[:incidents] %></td>
        <td><%= point[:ratio].nil? ? (point[:open].zero? ? 'N/A — no open tickets' : 'N/A — no returned tickets') : performance_number(point[:ratio]) %></td>
        <td><%= point[:unknown].positive? ? "#{point[:non_merge]} known; #{point[:unknown]} reasons unavailable" : point[:non_merge] %></td>
        <td><%= point[:adjusted_ratio].nil? ? (point[:open].zero? ? 'N/A — no open tickets' : 'N/A — missing or hidden Return Reason') : "#{performance_number(point[:adjusted_ratio])}%" %></td>
      </tr><% end %></tbody>
    </table></div>
  </details>
  <p class="performance-trend-note">Each point includes all recorded returns through that month-end for its open-ticket population. Gaps mean unavailable data, not zero.</p>
</div>
