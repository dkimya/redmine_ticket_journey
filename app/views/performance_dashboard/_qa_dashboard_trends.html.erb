<% charts = [
     { key: 'score', title: 'QA Score Trends', axis: 'Points',
       series: [['found', 'Bugs Found', '#0072b2'], ['false_passes', 'False Passes', '#b35a00'],
                ['escapes', 'Test Escapes', '#bd3543'], ['score', 'Total Score', '#17365d']] },
     { key: 'duration', title: 'Average Calendar Duration', axis: 'Days',
       series: [['duration', 'Time in gate', '#0072b2']] },
     { key: 'efficiency', title: 'Processed CW/h', axis: 'CW/h',
       series: [['efficiency', 'Processed CW/h', '#00865e']] }
   ] %>
<section class="performance-section">
  <h3>Periodic QA Trends</h3>
  <p>Intervals group tickets by closure date. False Pass and Test Escape lines show penalty amounts, where lower is better.</p>
  <div class="performance-qa-trend-grid">
    <% charts.each do |chart| %>
      <% keys = chart[:series].map(&:first)
         points = @qa_trends.map do |interval|
           if chart[:key] == 'score'
             interval[:points].stringify_keys.merge('score' => interval[:points][:total])
           else
             { chart[:key] => interval[chart[:key].to_sym] }
           end
         end
         minimum = [0, points.flat_map { |point| keys.filter_map { |key| point[key] } }.min.to_f].min.floor
         plot = points.map { |point| point.transform_values { |value| value - minimum unless value.nil? } }
         geometry = performance_leaderboard_geometry(plot, keys: keys, scale_values: [], percent: false)
         title_id = "qa-trend-#{chart[:key]}"
         date_step = [(@qa_trends.size / 7.0).ceil, 1].max
      %>
      <article class="performance-metric">
        <h4><%= chart[:title] %></h4>
        <ul class="performance-trend-legend">
          <% chart[:series].each do |_key, label, color| %>
            <li><span class="performance-trend-swatch" style="border-color:<%= color %>" aria-hidden="true"></span><%= label %></li>
          <% end %>
        </ul>
        <div class="autoscroll">
          <svg class="performance-trend-chart" viewBox="0 0 860 285" role="img" aria-labelledby="<%= title_id %>">
            <title id="<%= title_id %>"><%= chart[:title] %> by closure interval. Select a point to open the contributing tickets.</title>
            <%= performance_y_axis_title(chart[:axis]) %>
            <% geometry[:ticks].each do |tick| %>
              <% y = 235 - tick / geometry[:maximum] * 200 %>
              <line class="performance-trend-grid" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>" />
              <text x="78" y="<%= y + 5 %>" text-anchor="end"><%= performance_number(tick + minimum) %></text>
            <% end %>
            <% @qa_trends.each_with_index do |interval, index| %>
              <% next unless (index % date_step).zero? || index == @qa_trends.size - 1 %>
              <text x="<%= geometry[:series].first[index][:x] %>" y="268" text-anchor="middle"><%= interval[:date].strftime('%d %b %y') %></text>
            <% end %>
            <% chart[:series].each_with_index do |(key, label, color), position| %>
              <% coordinates = geometry[:series][position] %>
              <g class="performance-trend-series" style="stroke:<%= color %>;fill:<%= color %>">
                <% coordinates.each_cons(2) do |left, right| %>
                  <% next unless left[:y] && right[:y] %>
                  <line x1="<%= left[:x] %>" y1="<%= left[:y] %>" x2="<%= right[:x] %>" y2="<%= right[:y] %>" />
                <% end %>
                <% coordinates.each_with_index do |coordinate, index| %>
                  <% next unless coordinate[:y] %>
                  <% date = @qa_trends[index][:date]; description = "#{label} · #{format_date(date)} · #{performance_number(points[index][key])} #{chart[:axis]}" %>
                  <a href="<%= performance_dashboard_path(@project, **@qa_params.merge(qa_detail: key, qa_bucket: date.iso8601)) %>" target="_blank" rel="noopener" aria-label="<%= description %>">
                    <circle cx="<%= coordinate[:x] %>" cy="<%= coordinate[:y] %>" r="5"><title><%= description %></title></circle>
                  </a>
                <% end %>
              </g>
            <% end %>
          </svg>
        </div>
        <details class="performance-trend-values">
          <summary>View interval values</summary>
          <div class="autoscroll"><table class="list performance-qa-table">
            <thead><tr><th scope="col">Interval end</th><% chart[:series].each do |_key, label, _color| %><th scope="col"><%= label %></th><% end %></tr></thead>
            <tbody>
              <% @qa_trends.each_with_index do |interval, index| %>
                <tr><th scope="row"><%= format_date(interval[:date]) %></th>
                  <% keys.each do |key| %><td><%= qa_number_link(points[index][key], key, qa_bucket: interval[:date].iso8601) %></td><% end %>
                </tr>
              <% end %>
            </tbody>
          </table></div>
        </details>
      </article>
    <% end %>
  </div>
</section>
