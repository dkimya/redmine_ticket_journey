<div class="autoscroll"><table class="list periodic-metric-table">
  <caption><%= measure == :count ? 'Tickets' : 'Complexity Weight' %> — <%= @selected_owners.size > 1 ? 'team totals' : 'selected owner' %></caption>
  <thead><tr><th>Metric</th><th>Plan / Expectation</th><th>Actual</th><th>Deviation</th><th>Deviation calculation</th><th>Deviation %</th></tr></thead>
  <tbody><% TicketJourneyPeriodicTickets.metric_rows(report, measure).each do |row| %>
    <tr class="<%= 'periodic-total-row' if %w[expected actual].include?(row[:key]) %>">
      <th><%= row[:key] == 'actual' ? 'Total Done' : TicketJourneyPeriodicTickets::LABELS.fetch(row[:key]) %></th>
      <% plan_tip = {
        'expected' => 'Expected Total = Debt at RSD + Planned Assigned Tasks + Assigned Hotfixes.',
        'actual' => 'Total Done plan = Completed from Expectation + Debt at RED.'
      }[row[:key]] %>
      <td>
        <%= row[:plan].positive? ? periodic_ticket_link(performance_number(row[:plan]), row[:key] == 'actual' ? 'expected' : row[:key], title: plan_tip) : performance_number(row[:plan]) %>
        <%= performance_tip(plan_tip) if plan_tip %>
      </td>
      <% actual_metric = %w[planned hotfix].include?(row[:key]) ? "completed_#{row[:key]}" : (row[:key] == 'expected' ? 'completed' : row[:key]) %>
      <% actual_tip = row[:key] == 'actual' ? 'Total Done actual = Completed from Expectation + Other Done.' : nil %>
      <td>
        <%= periodic_ticket_link(performance_number(row[:actual]), actual_metric, title: actual_tip) %>
        <%= performance_tip(actual_tip) if actual_tip %>
      </td>
      <td><%= periodic_ticket_link(periodic_deviation(row[:deviation][:value]), TicketJourneyPeriodicTickets::DEVIATION_METRICS.fetch(row[:key])) %></td>
      <td><%= row[:direction] == :plan_minus_actual ? 'P−A' : 'A−P' %><%= '*' if row[:key] == 'actual' %></td>
      <td><%= periodic_deviation(row[:deviation][:percent], percentage: true) %></td>
    </tr>
  <% end %></tbody>
</table></div>
<p class="performance-weight-note">P = Plan / Expectation. A = Actual. Debt's target is zero, while its opening workload contributes to Expected Total. Weight sums use usable visible values. * Total Done includes Other Done. Its deviation is capped at zero when Expected Total deviation is nonzero.</p>
