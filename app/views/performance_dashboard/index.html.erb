<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'performance', plugin: 'redmine_ticket_journey' %>
  <%= javascript_include_tag 'performance_owner_picker', plugin: 'redmine_ticket_journey', defer: true %>
  <%= javascript_include_tag 'performance_navigation', plugin: 'redmine_ticket_journey', defer: true %>
  <%= javascript_include_tag 'performance_leaderboard', plugin: 'redmine_ticket_journey', defer: true %>
<% end %>
<% html_title 'Performance' %>
<div class="performance-page">
  <%= render 'header' %>
  <% if @owner && !@owner.active? %>
    <p>Showing report for <strong><%= @owner.name %></strong> (inactive). The owner dropdown lists active users only.</p>
  <% end %>
  <p class="performance-context">Selected project and all subprojects · Current Ticket Owners · Visible tickets only <%= performance_tip('Includes Bug, Change Request / Improvement, Feature, and Task (Business Jobs). User Story and other trackers are excluded provisionally. Current Ticket Owner is used for all dates, cards and trends; reassignment updates historical attribution. Status is reconstructed at the selected date; current due dates and weights are used. Missing status history falls back to current status. Owner-change history remains available in the audit.') %></p>
  <% if @report %>
    <%= render 'comparison' %>
    <%= render 'leaderboard', entries: @leaderboard_entries if @leaderboard_entries %>
    <h3>Combined Results for selected owners (team)</h3>
    <% groups = @report[:groups]; total_weight = TicketJourneyPerformance.weight(groups.first) %>
    <section class="performance-section">
      <h3><span class="performance-step">1</span> Open Tickets <%= performance_tip('New and On-Hold at the selected report date are excluded from open-ticket counts, weights, breakdowns, and Due Soon. Other non-closed statuses, including Pending and Ongoing, remain included. Stopped means Pending only and is a subset of Total Open Tickets. Archived is closed and is not a delivery. Missing due dates are included in Not Overdue; due today is not overdue. Not Touched means the ticket has not been In Progress by the report date. Logged time, comments, and later workflow stages alone do not establish Started. Earlier In Progress history, including before reassignment, still counts. Section 2 retains its separate rules.') %></h3>
      <div class="performance-open">
        <% percentages = groups.drop(1).map { |g| performance_percent(g.size, groups.first.size) || 0 }; first = percentages[0]; second = first + percentages[1] %>
        <div class="performance-distribution">
          <h4 class="performance-distribution-title">Ticket distribution</h4>
          <div class="performance-chart-wrap"><div class="performance-donut" role="img" aria-label="<%= groups.first.size %> open tickets; Not overdue <%= performance_number(percentages[0]) %>%; Already started <%= performance_number(percentages[1]) %>%; Not touched <%= performance_number(percentages[2]) %>%" style="background: <%= groups.first.empty? ? '#e7edf3' : "conic-gradient(#00bc87 0% #{first}%, #ffad38 #{first}% #{second}%, #f65362 #{second}% 100%)" %>"><div><strong><%= groups.first.size %></strong><span>Open Tickets</span></div></div>
            <% offset = 0; percentages.each_with_index do |percent, i| %>
              <% angle = (offset + percent / 2) * Math::PI / 50; offset += percent %>
              <% if percent.positive? %><span class="performance-segment-label" style="left: <%= 50 + Math.sin(angle) * 46 %>%; top: <%= 50 - Math.cos(angle) * 46 %>%"><%= performance_detail_link("#{performance_number(percent)}%", %w[not_overdue started untouched][i]) %></span><% end %>
            <% end %>
          </div>
          <div class="performance-legend">
            <% ['Not Overdue', 'Overdue - Already Started', 'Overdue - Not Touched'].each_with_index do |label, i| %>
              <p><span class="performance-dot performance-color-<%= i %>"></span><%= performance_detail_link(label, %w[not_overdue started untouched][i]) %></p>
            <% end %>
          </div>
        </div>
        <div class="performance-cards">
          <% ['Total Open Tickets', 'Not Overdue Open Tickets', 'Overdue - Already Started', 'Overdue - Not Touched'].each_with_index do |label, i| %>
            <article class="performance-card performance-card-<%= i %>">
              <h4><%= label %></h4><strong class="performance-value"><%= performance_detail_link(groups[i].size, %w[open not_overdue started untouched][i]) %></strong>
              <div class="performance-secondary">
                <% if i == 0 %>
                  Stopped: <b><%= performance_detail_link(@report[:stopped], 'stopped') %></b> <%= performance_tip('Open tickets in Pending at the selected report date. New and On-Hold are excluded. Already included in Total Open Tickets and the three breakdown groups; do not add this count to the total.') %>
                <% elsif i == 1 %>
                  Due soon (&lt;3 days): <b><%= performance_detail_link(@report[:due_soon], 'due_soon') %></b> <%= performance_tip('Due today, tomorrow, or the following day. Tickets without a due date are excluded from Due Soon.') %>
                <% end %>
              </div>
              <p>Sum of Complexity Weight</p><div><strong class="performance-weight"><%= performance_number(TicketJourneyPerformance.weight(groups[i])) %></strong>
              <% if i > 0 %><span>(<%= total_weight.positive? ? "#{performance_number(performance_percent(TicketJourneyPerformance.weight(groups[i]), total_weight))}%" : 'N/A' %>)</span><% end %></div>
            </article>
          <% end %>
        </div>
      </div>
    </section>
    <section class="performance-section">
      <h3><span class="performance-step">2</span> Delivery Metrics (All Tickets Due by Date) <%= performance_tip('Cumulative delivery uses tickets with a current due date on or before the report date. The numerator includes only those tickets in Done / Closed at that date. Archived and Ongoing tickets at the selected report date are excluded from all Section 2 counts and weights, including the due denominator. Reopened tickets are not counted as done. No due date means excluded from both delivery ratios. Each ticket counts once.') %></h3>
      <div class="performance-delivery">
        <div class="performance-ratios">
          <% [['Done Tickets / Due Tickets', @report[:done].size, @report[:due].size], ['Done Weight / Due Weight', TicketJourneyPerformance.weight(@report[:done]), TicketJourneyPerformance.weight(@report[:due])]].each do |label, done, due| %>
            <% percent = performance_percent(done, due) %>
            <article class="performance-metric"><h4><%= label %></h4><div class="performance-donut performance-small" style="background: conic-gradient(#008fff 0% <%= percent || 0 %>%, #e7edf3 <%= percent || 0 %>% 100%)"><div><strong><%= percent ? "#{performance_number(percent)}%" : 'N/A' %></strong><span><%= performance_detail_link(performance_number(done), 'done') %> / <%= performance_detail_link(performance_number(due), 'due') %></span></div></div><p>Target: <%= performance_number(@delivery_target) %>% <%= performance_tip('Shared delivery target configured in Administration → Plugins → PMO Dashboard → Configure. Default: 90%. Applies to both delivery ratios for all employees and projects, including past report dates. No Extra Tasks adjustment. Monthly employee targets are separate.') %></p></article>
          <% end %>
        </div>
        <% [['No. of Tickets', @report[:monthly_count], @targets[0], 'delivered', @target_details[0]], ['Complexity Weight', @report[:monthly_weight], @targets[1], 'delivered_weight', @target_details[1]]].each do |label, actual, target, metric, target_detail| %>
          <article class="performance-metric performance-monthly">
<p>Last 3 completed months: <%= format_date(@report[:monthly_start_date]) %> – <%= format_date(@report[:monthly_end_date]) %></p>
            <% if @selected_owners.size > 1 %><p title="Actual = combined three-month total ÷ 3 ÷ selected owner count. Target = sum of selected owners’ monthly targets ÷ selected owner count. Owners with zero deliveries still count.">Per owner · <%= @selected_owners.size %> selected owners · arithmetic mean targets</p><% end %>
            <% if target_detail[:missing_owners].any? %><p>Target unavailable: <%= target_detail[:missing_owners].size %> selected owner(s) have a missing, hidden, invalid, or nonpositive target: <%= target_detail[:missing_owners].join(', ') %>. No owners are excluded to calculate a partial target.</p><% end %>
            <% if actual %><p><%= performance_detail_link('View contributing tickets', metric) %></p><% end %>
            <h4>Average Monthly Delivered<%= ' per Owner' if @selected_owners.size > 1 %><br>(<%= label %>) <%= performance_tip('Uses the three complete calendar months before the selected date’s month. Qualifying completed ticket count or current usable complexity weight is divided by 3, including zero-delivery months. With multiple owners, divide actuals again by the selected owner count and compare with the arithmetic mean of their monthly targets. Every selected owner counts, including zero-delivery owners. If any owner target is missing, hidden, invalid, or nonpositive, that metric’s combined target and deviation are unavailable. Tickets must be Done / Closed at the report date, with latest completion inside the window; Archived, Ongoing, and reopened tickets are excluded. Current Ticket Owner is used even for past dates. Current weights and targets are used; account creation and ticket Start dates do not change the window.') %></h4>
            <% if actual && target %>
              <% deviation = (actual - target) * 100 / target; scale = [actual, target].max * 1.2; actual_position = actual * 100 / scale; target_position = target * 100 / scale %>
              <p class="performance-deviation <%= deviation >= 0 ? 'performance-good' : 'performance-bad' %>"><%= '+' if deviation >= 0 %><%= performance_number(deviation) %>% vs Target <%= performance_tip('Green means at or above target; red means below target. The separate requirement allowing a shortfall below 10% awaits clarification; this color is not a final tolerance-based pass/fail result.') %></p>
              <div class="performance-bar-area"><div class="performance-bar"><span style="width: <%= actual_position %>%; background: <%= deviation >= 0 ? '#00bc87' : '#f65362' %>"></span><b class="performance-actual" style="left: <%= actual_position %>%"><%= performance_number(actual) %></b><i style="left: <%= target_position %>%"></i><span class="performance-target" style="left: <%= target_position %>%"><%= performance_number(target) %><br>Target</span></div></div>
            <% else %>
              <p class="performance-unavailable"><%= actual.nil? ? 'Average: N/A' : "Average: #{performance_number(actual)}" %></p><p><%= target.nil? ? 'Target: Not configured or unavailable' : "Target: #{performance_number(target)}" %></p>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>
    <% if @delivery_trend %>
      <div class="performance-ticket-trends">
        <section class="performance-section"><%= render 'delivery_trend', points: @delivery_trend %></section>
        <section class="performance-section"><%= render 'monthly_delivery_trend', points: @delivery_trend %></section>
      </div>
      <%= render 'owner_change_note' %>
    <% end %>
    <details class="performance-notes"><summary>Calculation notes and data quality</summary>
      <p>Both monthly metrics use <%= format_date(@report[:monthly_start_date]) %> through <%= format_date(@report[:monthly_end_date]) %>, the three completed calendar months before the selected date's month. Totals are divided by 3 even when a month has no deliveries, then by <%= @selected_owners.size %> selected owner(s) for per-owner actuals. Account creation and ticket Start dates are not used. Open-ticket and cumulative delivery ratios retain their existing date rules, including older backlog due by the report date.</p>
      <p><%= performance_detail_link(@report[:missing_due], 'missing_due') %> open tickets have no due date and are included in Not Overdue. <%= performance_detail_link(@report[:missing_weight], 'missing_weight') %> tickets have missing, hidden, or nonpositive weights; they contribute no weight but still count as tickets. <%= performance_detail_link(@report[:missing_delivery], 'missing_delivery') %> done tickets lack a recorded completion date and are excluded from monthly averages.</p>
      <p>Current issue permissions limit every result. Targets use current user field values, not historical snapshots. Monthly targets are arithmetic means across all selected owners; each metric requires a usable target for every owner. Single-owner calculations use that owner's target unchanged. Contributor lists retain the whole matching ticket set.</p>
    </details>
  <% else %><p class="nodata"><% if @initial_load %>Select a Ticket Owner and As of Date, then click Apply. No report has been calculated yet. The initial owner list shows members of visible projects in this hierarchy; report results also include current owners found on visible tickets.<% else %>No matching owner was found on visible tickets in the included trackers at the selected date. Choose another owner or date and click Apply.<% end %></p><% end %>
</div>
