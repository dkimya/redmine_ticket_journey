<div class="performance-return-trend performance-delivery-trend">
  <h4>Delivery ratio trend — last <%= points.size %> completed months <%= performance_tip('Each point uses the current Ticket Owner and reconstructs ticket status at that month-end. Includes all tickets with a current due date on or before that date; Done / Closed is the numerator. Archived and Ongoing are excluded. Current due dates and visible current complexity weights are used, so later edits can change historical results. Combined ratios use summed counts or weights, not averages of employee percentages. This is cumulative delivery, not output during that month. The target is the current configured delivery target.') %></h4>
  <p>Month-end snapshots · Same selected owners · Cards above show <%= format_date(@date) %></p>
  <ul class="performance-trend-legend">
    <li><span class="performance-trend-swatch"></span>Done Tickets / All Tickets Due</li>
    <li><span class="performance-trend-swatch performance-trend-adjusted"></span>Done Weight / All Weight Due</li>
    <li><span class="performance-trend-swatch performance-trend-target-swatch"></span>Target: <%= performance_number(@delivery_target) %>%</li>
  </ul>
  <% keys = [:count_ratio, :weight_ratio]; geometry = performance_return_trend_geometry(points, keys: keys, maximum: 100.0) %>
  <div class="autoscroll">
    <svg class="performance-trend-chart" viewBox="0 0 860 285" role="img" aria-labelledby="delivery-trend-title delivery-trend-description">
      <title id="delivery-trend-title">Delivery ratios at the last five month ends</title>
      <desc id="delivery-trend-description">Ticket and complexity-weight delivery percentages with the configured target. Missing points are not joined. Exact numerators and denominators are available in the table below.</desc>
      <% 0.upto(4) do |index| %>
        <% y = 235 - index * 50 %>
        <line class="performance-trend-grid" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>" />
        <text x="78" y="<%= y + 5 %>" text-anchor="end"><%= index * 25 %>%</text>
      <% end %>
      <% target_y = 235 - @delivery_target * 2 %>
      <line class="performance-trend-target-line" x1="90" x2="770" y1="<%= target_y %>" y2="<%= target_y %>"><title>Configured target: <%= performance_number(@delivery_target) %>%</title></line>
      <% points.each_with_index do |point, index| %>
        <text x="<%= geometry[:series].first[index][:x] %>" y="268" text-anchor="middle"><%= format_date(point[:date]) %></text>
      <% end %>
      <% geometry[:series].each_with_index do |series, series_index| %>
        <% label = series_index.zero? ? 'Done Tickets / All Tickets Due' : 'Done Weight / All Weight Due' %>
        <g class="performance-trend-series <%= 'performance-trend-adjusted' if series_index == 1 %>">
          <% series.each_cons(2) do |left, right| %>
            <% if left[:y] && right[:y] %><line x1="<%= left[:x] %>" y1="<%= left[:y] %>" x2="<%= right[:x] %>" y2="<%= right[:y] %>" /><% end %>
          <% end %>
          <% series.each do |coordinate| %>
            <% next unless coordinate[:y] %>
            <% point = points[coordinate[:index]]; done, due = series_index.zero? ? [point[:done], point[:due]] : [point[:done_weight], point[:due_weight]] %>
            <% description = "#{format_date(point[:date])}: #{label}, #{performance_number(point[keys[series_index]])}%; #{performance_number(done)} / #{performance_number(due)}" %>
            <circle cx="<%= coordinate[:x] %>" cy="<%= coordinate[:y] %>" r="<%= series_index.zero? ? 7 : 4 %>" tabindex="0" role="img" aria-label="<%= description %>"><title><%= description %></title></circle>
          <% end %>
        </g>
      <% end %>
    </svg>
  </div>
  <details class="performance-trend-values"><summary>View monthly values and counts</summary>
    <div class="autoscroll"><table class="list">
      <thead><tr><th>Month end</th><th>Done Tickets / All Tickets Due</th><th>Ticket Delivery</th><th>Done Weight / All Weight Due</th><th>Weight Delivery</th></tr></thead>
      <tbody><% points.each do |point| %><tr>
        <th><%= format_date(point[:date]) %></th><td><%= point[:done] %> / <%= point[:due] %></td>
        <td><%= point[:count_ratio].nil? ? 'N/A — no due tickets' : "#{performance_number(point[:count_ratio])}%" %></td>
        <td><%= performance_number(point[:done_weight]) %> / <%= performance_number(point[:due_weight]) %></td>
        <td><%= point[:weight_ratio].nil? ? 'N/A — no usable due weight' : "#{performance_number(point[:weight_ratio])}%" %></td>
      </tr><% end %></tbody>
    </table></div>
  </details>
  <p>Uses current due dates and visible current complexity weights. Gaps mean unavailable data, not zero. Monthly output averages above retain their existing calculation.</p>
</div>
