<% development_ids = @time_mix[:development_ids]; available = @time_mix[:available]; summary = TicketJourneyPeriodicTimeMix.summarize(records, development_ids, available: available); groups = TicketJourneyPeriodicTimeMix.group(records, key, development_ids, available: available); filter_key = { activity_id: :mix_activity, user_id: :mix_user, category: :mix_category }.fetch(key) %>
<section class="performance-section periodic-time-mix-donut">
  <h4><%= title %></h4>
  <div class="periodic-completion"><div class="performance-donut" role="img" aria-label="<%= title %>: <%= performance_number(summary[:total]) %> hours" style="background:<%= periodic_time_mix_gradient(groups, summary[:total], key: key) %>"><div><strong><%= performance_number(summary[:total]) %></strong><span>hours in period</span></div></div></div>
  <div class="autoscroll"><table class="list"><thead><tr><th><%= key == :user_id ? 'Logged user' : 'Activity' %></th><th>Hours</th><th>Share</th></tr></thead><tbody>
    <% groups.each do |group| %><tr><th><span class="performance-dot" style="background:<%= periodic_time_mix_color(key, group[:key]) %>"></span> <%= periodic_time_mix_link(periodic_time_mix_name(key, group[:key]), scope, filter_key => group[:key]) %></th><td><%= periodic_time_mix_link(performance_number(group[:report][:total]), scope, filter_key => group[:key]) %></td><td><%= summary[:total] && summary[:total].positive? && group[:report][:total] ? "#{performance_number(group[:report][:total] * 100 / summary[:total])}%" : 'N/A' %></td></tr><% end %>
  </tbody><tfoot><tr><th>Total</th><td><%= periodic_time_mix_link(performance_number(summary[:total]), scope) %></td><td><%= summary[:total] && summary[:total].positive? ? '100%' : 'N/A' %></td></tr></tfoot></table></div>
  <% if summary[:total].nil? %><p>Full total unavailable. Known visible valid hours: <%= performance_number(summary[:known]) %>; invalid records: <%= summary[:invalid] %>. A complete percentage is not inferred from partial data.</p><% end %>
</section>
