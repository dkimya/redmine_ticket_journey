<section class="performance-section performance-leaderboard" data-performance-leaderboard>
  <h3>Leaderboard — Individual Owner Trends <%= performance_tip(@return_mode ? 'One line per selected owner over the last five completed month ends. Return incidents, including Merge Conflict, divided by that owner’s open tickets at each date. Current Ticket Owner is used. No open tickets means N/A, shown as a gap. Compare workloads and sample sizes; no rank is assigned.' : 'One line per selected owner showing complexity points delivered during each of the last five completed months. Uses current Ticket Owner and visible current complexity weights. Tickets must be Done / Closed at month-end with their latest completion in that month; Archived and Ongoing are excluded. These are individual totals, not averages. No rank is assigned.') %></h3>
  <% metric = @return_mode ? :ratio : :delivered_weight %>
  <h4><%= @return_mode ? 'Return Incidents / Open Tickets' : 'Monthly Delivered Complexity Points' %></h4>
  <p>Current Ticket Owner · Five completed months · Select an owner’s legend button to hide or show their line.</p>
  <% dates = entries.first[:points].map { |point| point[:date] } %>
  <% keys = entries.map { |entry| entry[:owner].id.to_s } %>
  <% plot = dates.each_index.map { |index| entries.to_h { |entry| [entry[:owner].id.to_s, entry[:points][index][metric]] } } %>
  <% geometry = performance_return_trend_geometry(plot, keys: keys, minimum: @return_mode ? 10.0 : 1.0) %>
  <div class="performance-leaderboard-legend" aria-label="Selected owner lines">
    <% entries.each do |entry| %>
      <% owner = entry[:owner] %>
      <button type="button" data-leaderboard-toggle="<%= owner.id %>" aria-pressed="true" aria-label="Hide <%= owner.name %> line" data-owner-name="<%= owner.name %>"><span class="performance-leaderboard-swatch" style="border-color:<%= performance_owner_color(owner.id) %>" aria-hidden="true"></span><%= owner.name %></button>
    <% end %>
  </div>
  <div class="autoscroll">
    <svg class="performance-trend-chart performance-leaderboard-chart" viewBox="0 0 860 285" role="img" aria-labelledby="leaderboard-title leaderboard-description">
      <title id="leaderboard-title"><%= @return_mode ? 'Individual owner return ratios' : 'Individual owner monthly complexity point delivery' %></title>
      <desc id="leaderboard-description">One line per owner. Missing points are not joined. Exact monthly values and contributing counts appear in the expandable table below. Legend buttons control line visibility only.</desc>
      <% 0.upto(4) do |index| %>
        <% y = 235 - index * 50 %>
        <line class="performance-trend-grid" x1="90" x2="770" y1="<%= y %>" y2="<%= y %>" />
        <text x="78" y="<%= y + 5 %>" text-anchor="end"><%= performance_number(index * geometry[:step]) %><%= '%' if @return_mode %></text>
      <% end %>
      <% dates.each_with_index do |date, index| %><text x="<%= geometry[:series].first[index][:x] %>" y="268" text-anchor="middle"><%= date.strftime('%b %Y') %></text><% end %>
      <% entries.each_with_index do |entry, series_index| %>
        <% owner = entry[:owner]; series = geometry[:series][series_index] %>
        <g class="performance-trend-series" data-leaderboard-series="<%= owner.id %>" style="stroke:<%= performance_owner_color(owner.id) %>;fill:<%= performance_owner_color(owner.id) %>">
          <% series.each_cons(2) do |left, right| %><% if left[:y] && right[:y] %><line x1="<%= left[:x] %>" y1="<%= left[:y] %>" x2="<%= right[:x] %>" y2="<%= right[:y] %>" /><% end %><% end %>
          <% series.each do |coordinate| %>
            <% next unless coordinate[:y] %>
            <% point = entry[:points][coordinate[:index]] %>
            <% detail = @return_mode ? "#{performance_number(point[:ratio])}%; #{point[:incidents]} return incidents / #{point[:open]} open tickets" : "#{performance_number(point[:delivered_weight])} complexity points; #{point[:delivered_count]} delivered tickets; #{point[:missing_completion]} tickets missing completion dates" %>
            <% description = "#{owner.name} — #{format_date(point[:date])}: #{detail}" %>
            <circle cx="<%= coordinate[:x] %>" cy="<%= coordinate[:y] %>" r="5" tabindex="0" role="img" aria-label="<%= description %>"><title><%= description %></title></circle>
          <% end %>
        </g>
      <% end %>
    </svg>
  </div>
  <p><%= @return_mode ? 'Includes Merge Conflict. N/A means no open tickets at that month-end. Ratios can exceed 100%; compare incident and ticket counts alongside the percentage.' : 'Points are actual monthly totals for each owner. Missing or hidden weights contribute no points; eligible delivered tickets still count.' %></p>
  <details class="performance-trend-values"><summary>View individual monthly values and counts</summary>
    <div class="autoscroll"><table class="list"><thead><tr><th>Owner</th><th>Month</th><% if @return_mode %><th>Return Incidents</th><th>Open Tickets</th><th>Return Incidents / Open Tickets</th><% else %><th>Delivered Tickets</th><th>Delivered Complexity Points</th><th>Missing Completion Dates</th><% end %></tr></thead>
      <tbody><% entries.each do |entry| %><% entry[:points].each do |point| %><tr><th><%= entry[:owner].name %></th><td><%= format_date(point[:date]) %></td>
        <% if @return_mode %><td><%= point[:incidents] %></td><td><%= point[:open] %></td><td><%= point[:ratio].nil? ? 'N/A' : "#{performance_number(point[:ratio])}%" %></td>
        <% else %><td><%= point[:delivered_count] %></td><td><%= performance_number(point[:delivered_weight]) %></td><td><%= point[:missing_completion] %></td><% end %>
      </tr><% end %><% end %></tbody>
    </table></div>
  </details>
</section>
