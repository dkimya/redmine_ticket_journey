<div class="performance-navigation">
<nav class="performance-type-tabs" aria-label="Dashboard type">
  <% [['live', 'Live Dashboard'], ['periodic', 'Periodic Report']].each do |key, label| %>
    <% context = performance_owner_params.merge(as_of: @date.iso8601) %>
    <% context[:tab] = @performance_tab unless @performance_tab == 'tickets' %>
    <% context[:dashboard_type] = key unless key == 'live' %>
    <% context.merge!(rsd: @period_start.iso8601, red: @period_end.iso8601) if key == 'periodic' && @period_start && @period_end %>
    <%= link_to performance_dashboard_path(@project, **context), class: "performance-tab#{' is-active' if @dashboard_type == key}", title: (key == 'live' ? 'View a dashboard snapshot at the selected As of Date; this page does not automatically refresh.' : 'Calculation rules have been confirmed for Tickets and Returns; Time definitions remain provisional.'), aria: { current: (@dashboard_type == key ? 'page' : nil) } do %>
      <%= label %><% if key == 'periodic' %><span class="performance-tab-planned">Provisional</span><% end %>
    <% end %>
  <% end %>
</nav>
<nav class="performance-tabs" aria-label="Report section">
  <% [['tickets', 'Tickets'], ['returns', 'Returns'], ['time', 'Time']].each do |key, label| %>
    <% context = performance_owner_params.merge(as_of: @date.iso8601) %>
    <% context[:tab] = key unless key == 'tickets' %>
    <% context[:dashboard_type] = @dashboard_type if @dashboard_type == 'periodic' %>
    <% context.merge!(rsd: @period_start.iso8601, red: @period_end.iso8601) if @dashboard_type == 'periodic' && @period_start && @period_end %>
    <%= link_to performance_dashboard_path(@project, **context), class: "performance-tab#{' is-active' if @performance_tab == key}", aria: { current: (@performance_tab == key ? 'page' : nil) } do %>
      <%= label %><% if @dashboard_type == 'periodic' && key == 'time' %><span class="performance-tab-planned">Provisional</span><% end %>
    <% end %>
  <% end %>
</nav>
</div>
