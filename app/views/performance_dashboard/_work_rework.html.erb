<% calculator = TicketJourneyWorkRework %>
<% hours = ->(value) { value.nil? ? 'N/A' : "#{performance_number(value)} h" } %>
<% percent = ->(value) { value.nil? ? 'N/A' : "#{performance_number(value)}%" } %>
<section class="performance-section">
  <h3><%= @periodic_time ? 'Work / Rework Time for Tickets Completed During the Report Period' : 'Work / Rework Time' %></h3>
  <p><%= @periodic_time ? 'Includes all contributors’ visible hours logged directly on these tickets through the report end date, including hours logged before the report period.' : 'Tickets open at the report date, with visible hours through that date.' %> Ticket groups use the current Ticket Owner.</p>
  <p>Rework counts hours logged after a qualifying return in a status already reached before that return. Review rolls up under Development. Feedback, Ready to Merge and Final Check roll up under Test. On a return date, a recognized activity can identify the phase while Work / Rework remains pending.</p>
  <div class="autoscroll">
    <% if @selected_owners.one? %>
      <% summary = @work_rework.fetch(@selected_owners.first.id.to_s) %>
      <% time_visible = summary[:count].zero? || summary[:unavailable] < summary[:count] %>
      <% columns = [*calculator::PHASES.excluding(:unclassified), nil] %>
      <p><strong><%= summary[:count] %> tickets · <%= performance_number(summary[:weight]) %> usable CW</strong> · <%= summary[:missing_weight] %> without usable weight</p>
      <table class="list performance-work-rework-phase-table">
        <colgroup>
          <col class="performance-work-rework-row-label">
          <% columns.each do %><col><% end %>
        </colgroup>
        <thead><tr><th scope="col">Logged effort</th><% columns.each do |phase| %><th scope="col"><%= calculator::PHASE_LABELS.fetch(phase, 'Total') %></th><% end %></tr></thead>
        <tbody>
          <% total_label = @periodic_time ? 'Total' : 'Total visible hours' %>
          <% hour_rows = { work: 'Work', rework: 'Rework' } %>
          <% hour_rows[:unknown] = 'Pending classification' if @periodic_time %>
          <% hour_rows.merge(nil => total_label).each do |kind, label| %>
            <tr><th scope="row"><%= label %><% if @periodic_time && kind.nil? %> <small class="performance-work-rework-formula">(All contributors’ hours on completed tickets)</small><% end %></th><% columns.each do |phase| %><td><%= hours.call(time_visible ? calculator.total(summary, kind, phase) : nil) %></td><% end %></tr>
          <% end %>
          <% if @periodic_time %>
            <tr class="performance-work-rework-group-start"><th scope="row">Classified hours <small class="performance-work-rework-formula">(Work + Rework)</small></th><% columns.each do |phase| %><td><%= hours.call(time_visible ? calculator.classified_hours(summary, phase) : nil) %></td><% end %></tr>
          <% end %>
          <tr><th scope="row">Rework %<% if @periodic_time %> <small class="performance-work-rework-formula">(Rework ÷ classified hours)</small><% end %></th><% columns.each do |phase| %><td><%= percent.call(calculator.rework_percent(summary, phase)) %></td><% end %></tr>
          <% average_denominators = { count: pluralize(summary[:count], 'ticket'),
                                      weight: "#{performance_number(summary[:weight])} CW" } %>
          <% { count: 'Average hours per ticket', weight: 'Average hours per CW' }.each do |denominator, label| %>
            <% available = summary[:unavailable].zero? && summary[denominator].positive? && (denominator != :weight || summary[:missing_weight].zero?) %>
            <% formula = denominator == :weight && summary[:missing_weight].positive? ? 'Requires usable CW on every ticket' : "Total hours ÷ #{average_denominators.fetch(denominator)}" %>
            <tr<% if @periodic_time && denominator == :count %> class="performance-work-rework-group-start"<% end %>><th scope="row"><%= label %><% if @periodic_time %><br><small><%= formula %></small><% end %></th><% columns.each do |phase| %>
              <td><%= hours.call(available ? calculator.total(summary, nil, phase) / summary[denominator] : nil) %></td>
            <% end %></tr>
          <% end %>
        </tbody>
        <% if @periodic_time %>
          <tbody class="performance-work-rework-owner-totals">
            <tr class="performance-work-rework-group-start">
              <th scope="row">Total Owner Logged Time on Completed Tickets</th>
              <td colspan="<%= columns.size - 1 %>" rowspan="3">Owner hours across all phases</td>
              <td><%= hours.call(time_visible ? summary[:owner_hours] : nil) %></td>
            </tr>
            <% { count: 'Average Owner’s hours per ticket', weight: 'Average Owner’s hours per CW' }.each do |denominator, label| %>
              <% missing_weight = denominator == :weight && summary[:missing_weight].positive? %>
              <% available = summary[:unavailable].zero? && summary[denominator].positive? && !missing_weight %>
              <% formula = missing_weight ? 'Requires usable CW on every ticket' : "Owner hours ÷ #{average_denominators.fetch(denominator)}" %>
              <tr>
                <th scope="row"><%= label %><br><small><%= formula %></small></th>
                <td><%= hours.call(available ? summary[:owner_hours] / summary[denominator] : nil) %></td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
      <p><% unless @periodic_time %>Owner-booked hours on these tickets (<%= hours.call(time_visible ? summary[:owner_hours] : nil) %>) · <% end %><%= summary[:unavailable] %> tickets without time-view access.</p>
      <% if @periodic_time && time_visible %>
        <p>Of the <strong><%= hours.call(calculator.total(summary)) %></strong> on these completed tickets,
          <%= @selected_owners.first.name %> logged <strong><%= hours.call(summary[:owner_hours_in_period]) %></strong> within the report period
          and <strong><%= hours.call(summary[:owner_hours] - summary[:owner_hours_in_period]) %></strong> before it.
          Other contributors logged <strong><%= hours.call([calculator.total(summary) - summary[:owner_hours], 0.0].max) %></strong> through the report end date.</p>
      <% end %>
      <% if @periodic_time %>
        <% owner_report = @periodic_time_owners.first[:report] %>
        <% period_hours = owner_report[:metrics].fetch('total_hours') %>
        <% total = period_hours[:actual] %>
        <p><strong>Owner Hours Logged in the Report Period</strong><br>
          <% if total.nil? %>
            N/A
          <% else %>
            <% completed_ids = owner_report[:tickets][:sets].fetch('actual').map { |row| row[:id] }.to_set %>
            <% on_completed, on_other = period_hours[:rows].partition { |row| completed_ids.include?(row[:id]) } %>
            <%= hours.call(on_completed.sum { |row| row[:personal_hours] }) %> on these completed tickets
            + <%= hours.call(on_other.sum { |row| row[:personal_hours] }) %> on other in-scope tickets
            = <strong><%= periodic_time_link(hours.call(total), 'total_hours') %></strong>
          <% end %>
        </p>
      <% end %>
    <% else %>
      <table class="list">
        <thead><tr><th scope="col">Owner</th><th scope="col">Tickets</th><th scope="col">Usable CW</th><th scope="col">Total Logged Time on Tickets</th><th scope="col">Logged Time by Owner on These Tickets</th><th scope="col">Rework %</th><th scope="col">Average Hours per Ticket</th><th scope="col">Average Hours per CW</th><th scope="col">Tickets Without Time Access</th></tr></thead>
        <tbody><% @selected_owners.each do |owner| %>
          <% summary = @work_rework.fetch(owner.id.to_s); total = calculator.total(summary); available = summary[:unavailable].zero? %>
          <% time_visible = available || summary[:unavailable] < summary[:count] %>
          <tr>
            <th scope="row"><%= owner.name %></th>
            <td><%= summary[:count] %></td><td><%= performance_number(summary[:weight]) %><% if summary[:missing_weight].positive? %> (<%= summary[:missing_weight] %> missing)<% end %></td>
            <td><%= hours.call(time_visible ? total : nil) %></td><td><%= hours.call(time_visible ? summary[:owner_hours] : nil) %></td><td><%= percent.call(calculator.rework_percent(summary)) %></td>
            <td><%= hours.call(available && summary[:count].positive? ? total / summary[:count] : nil) %></td>
            <td><%= hours.call(available && summary[:weight].positive? && summary[:missing_weight].zero? ? total / summary[:weight] : nil) %></td>
            <td><%= summary[:unavailable] %></td>
          </tr>
        <% end %></tbody>
      </table>
    <% end %>
  </div>
  <% review_hours = @work_rework.values.sum { |summary| calculator.total(summary, :unknown) } %>
  <% if review_hours.positive? %>
    <details>
      <summary>Review <%= hours.call(review_hours) %> pending Work / Rework classification</summary>
      <% pending_by_phase = calculator::PHASES.map do |phase|
        pending = @work_rework.values.sum { |summary| calculator.total(summary, :unknown, phase) }
        "#{hours.call(pending)} #{phase == :unclassified ? 'without a phase' : calculator::PHASE_LABELS.fetch(phase)}" if pending.positive?
      end.compact %>
      <p><%= pending_by_phase.join(' · ') %></p>
      <p>Hours are grouped by ticket, work date and activity.</p>
      <div class="autoscroll"><table class="list">
        <thead><tr><th scope="col">Owner</th><th scope="col">Ticket</th><th scope="col">Work Date</th><th scope="col">Hours</th><th scope="col">Phase</th><th scope="col">Activity</th><th scope="col">Statuses</th><th scope="col">Reason</th></tr></thead>
        <tbody>
          <% @selected_owners.each do |owner| %>
            <% @work_rework.fetch(owner.id.to_s).fetch(:review).sort_by { |entry| [entry[:date], entry[:id]] }.each do |entry| %>
              <tr>
                <td><%= owner.name %></td>
                <td><%= performance_drilldown_link "##{entry[:id]}", issue_path(entry[:id]) %></td>
                <td><%= format_date(entry[:date]) %></td>
                <td><%= hours.call(entry[:hours]) %></td>
                <td><%= calculator::PHASE_LABELS.fetch(entry[:phase]) %></td>
                <td><%= entry[:activity].presence || 'Unavailable' %></td>
                <td><%= entry[:statuses].join(' → ') %></td>
                <td><%= entry[:reason] %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table></div>
    </details>
  <% end %>
  <p>Rework % divides rework hours by classified work plus rework hours. Pending hours with a known phase count in that phase’s total. The overall total also includes hours still pending a phase. <% if @periodic_time && @selected_owners.one? %>Calculations use unrounded hours. Displayed values can differ slightly when added or divided. <% end %>Missing time access makes ratios and averages unavailable. Time-entry visibility can also limit totals. Hours per CW requires usable weights for every ticket.</p>
  <%= render 'work_rework_trend' if @work_rework_months.any? %>
</section>
