<% html_title 'Performance', (@dashboard_type == 'periodic' ? 'Periodic Report' : @performance_tab.titleize) %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'performance', plugin: 'redmine_ticket_journey' %>
  <%= javascript_include_tag 'performance_owner_picker', plugin: 'redmine_ticket_journey', defer: true %>
<% end %>
<div class="performance-page">
  <%= render 'header' %>
  <section class="performance-section performance-planned-section">
    <h3><%= @dashboard_type == 'periodic' ? 'Periodic Report' : "#{@performance_tab.titleize} Performance" %> — Planned</h3>
    <p>This section is planned for a later implementation. No <%= @dashboard_type == 'periodic' ? 'periodic report' : @performance_tab %> performance metrics are calculated here yet.</p>
    <p>Your reporting period and selected Ticket Owners are retained when switching Periodic sections. Your Live Dashboard As of Date is retained separately.</p>
    <% if @performance_tab == 'tickets' %>
      <p>Tickets will compare expected work with completed expected work, show other completed work separately, and follow remaining debt through today. Assignment and hotfix definitions are still being confirmed before calculations are enabled.</p>
    <% end %>
  </section>
</div>
