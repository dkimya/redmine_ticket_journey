<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2>Bug Control Dashboard</h2>
        <p class="tj-page-sub">Bug source, leakage, related-page, and solved-bug analysis &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :bug_analysis } %>

  <%= form_tag(ticket_journey_bug_analysis_path(@project), method: :get, id: 'query_form') do %>
    <%= hidden_field_tag :support_section, params[:support_section] if params[:support_section].present? %>
    <%= render partial: 'queries/query_form' %>

    <div class="tj-filter-bar tj-bug-filter-bar">
      <div class="tj-filter-form">
      <div class="tj-filter-group">
        <label for="bug_start_date">Period Start</label>
        <%= date_field_tag :bug_start_date, @bug_start_date, class: 'tj-input' %>
      </div>
      <div class="tj-filter-group">
        <label for="bug_end_date">Period End</label>
        <%= date_field_tag :bug_end_date, @bug_end_date, class: 'tj-input' %>
      </div>
      <div class="tj-filter-group tj-flow-filter-note">
        <span>Uses the Redmine filters above, then counts Bug tracker issues in the current project and subprojects. Rows are grouped by custom field Bug Source.</span>
      </div>
      <div class="tj-filter-group">
        <%= submit_tag 'Apply', class: 'tj-btn tj-btn-primary' %>
      </div>
      </div>
    </div>
  <% end %>

  <%
    closed_report = @bug_closed_analysis_report || {}
    bug_kpi_help = {
      beginning: "Definition: Bug tickets open at the start of the selected period.\nCalculation: created on or before Period Start and not in a closed or terminal status at that start snapshot.",
      found: "Definition: new Bug tickets found during the selected period.\nCalculation: created from Period Start through Period End, inclusive.",
      closed: "Definition: distinct Bug tickets closed during the selected period.\nCalculation: entered a closed or terminal status at least once from Period Start through Period End.",
      ending: "Definition: Bug tickets still open at the end of the selected period.\nCalculation: created on or before Period End and not in a closed or terminal status at the end snapshot.",
      critical_open: "Definition: important Bug tickets still open at Period End.\nCalculation: Ending Bugs with Bug Impact Rating 3 or higher, or with an Urgent or Immediate priority.",
      leakage: "Bug Leakage = Escaped Bugs / Found Bugs x 100. Escaped Bugs are bugs found during the period whose Bug Source contains Test Escape, Coverage Gap, or Requirement Gap. The result is 0% when no bugs were found.",
      start_end_change: "Start-End Bug Change = (Ending Bugs - Beginning Bugs) / Beginning Bugs x 100. A negative value means the bug backlog decreased; a positive value means it increased. A dash is shown when Beginning Bugs is zero.",
      escaped: "Definition: bugs found during the selected period that indicate quality leakage.\nCalculation: Found Bugs whose Bug Source contains Test Escape, Coverage Gap, or Requirement Gap.",
      ending_impact: "Definition: total known impact of the bug backlog at Period End.\nCalculation: sum of positive Bug Impact Rating values across Ending Bugs; missing and zero ratings are excluded.",
      average_ending_impact: "Average Ending Impact = Ending Impact / number of Ending Bugs with a positive Bug Impact Rating. Ending Bugs with missing or zero ratings are excluded.",
      average_closed_cycle: "Definition: average active cycle time for bugs closed during the period.\nCalculation: from first In Progress, or ticket creation when In Progress is unavailable, to the first closure in the period, excluding configured pause time."
    }
  %>

  <div class="tj-summary-strip">
    <div class="tj-summary-card">
      <div class="tj-sc-label">Beginning Bugs <%= ticket_journey_kpi_tooltip(bug_kpi_help[:beginning]) %></div>
      <div class="tj-sc-value tj-sc-dim"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:beginning_issue_ids], @bug_analysis_totals[:beginning], title: 'Open bugs present at the beginning of the selected period') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Found <%= ticket_journey_kpi_tooltip(bug_kpi_help[:found]) %></div>
      <div class="tj-sc-value tj-sc-orange"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:found_issue_ids], @bug_analysis_totals[:found], title: 'Open bugs found during the selected period') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Closed <%= ticket_journey_kpi_tooltip(bug_kpi_help[:closed]) %></div>
      <div class="tj-sc-value tj-sc-green"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:closed_issue_ids], @bug_analysis_totals[:closed], title: 'Open bugs closed during the selected period') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Ending Bugs <%= ticket_journey_kpi_tooltip(bug_kpi_help[:ending]) %></div>
      <div class="tj-sc-value tj-sc-red"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:remaining_issue_ids], @bug_analysis_totals[:remaining], title: 'Open bugs remaining at the end of the selected period') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Critical Bugs Open <%= ticket_journey_kpi_tooltip(bug_kpi_help[:critical_open]) %></div>
      <div class="tj-sc-value <%= @bug_analysis_totals[:critical_open].positive? ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:critical_open_issue_ids], @bug_analysis_totals[:critical_open], title: 'Open critical bugs at the end of the selected period') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Bug Leakage (%) <%= ticket_journey_kpi_tooltip(bug_kpi_help[:leakage]) %></div>
      <div class="tj-sc-value <%= @bug_analysis_totals[:leakage_percent].to_f >= 0.3 ? 'tj-sc-red' : (@bug_analysis_totals[:leakage_percent].to_f.positive? ? 'tj-sc-orange' : 'tj-sc-dim') %>"><%= number_to_percentage(@bug_analysis_totals[:leakage_percent] * 100, precision: 1) %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Start-End Bug Change % <%= ticket_journey_kpi_tooltip(bug_kpi_help[:start_end_change]) %></div>
      <div class="tj-sc-value <%= @bug_analysis_totals[:change_percent].to_f.positive? ? 'tj-sc-red' : (@bug_analysis_totals[:change_percent].to_f.negative? ? 'tj-sc-green' : 'tj-sc-dim') %>"><%= @bug_analysis_totals[:change_percent].nil? ? '-' : number_to_percentage(@bug_analysis_totals[:change_percent] * 100, precision: 1) %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Escaped Bugs <%= ticket_journey_kpi_tooltip(bug_kpi_help[:escaped]) %></div>
      <div class="tj-sc-value <%= @bug_analysis_totals[:escaped].to_i.positive? ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:escaped_issue_ids], @bug_analysis_totals[:escaped], title: 'Open escaped bugs found during the selected period') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Ending Impact <%= ticket_journey_kpi_tooltip(bug_kpi_help[:ending_impact]) %></div>
      <div class="tj-sc-value tj-sc-orange"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:impact_issue_ids], @bug_analysis_totals[:impact_sum], title: 'Open ending bugs with impact rating') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Avg Ending Impact <%= ticket_journey_kpi_tooltip(bug_kpi_help[:average_ending_impact]) %></div>
      <div class="tj-sc-value tj-sc-blue"><%= duration_report_drilldown_link(@query, @bug_analysis_totals[:impact_issue_ids], number_with_precision(@bug_analysis_totals[:impact_average], precision: 1, strip_insignificant_zeros: true), title: 'Open ending bugs used for average impact') %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Avg Closed Cycle Time <%= ticket_journey_kpi_tooltip(bug_kpi_help[:average_closed_cycle]) %></div>
      <div class="tj-sc-value tj-sc-blue">
        <% if closed_report[:avg_cycle_hours].present? %>
          <%= duration_report_drilldown_link(@query, closed_report[:avg_cycle_issue_ids], format_hours(closed_report[:avg_cycle_hours]), title: 'Open closed bugs used for average cycle time') %>
        <% else %>
          -
        <% end %>
      </div>
    </div>
  </div>

  <% if @bug_analysis_rows.empty? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>No bug data found</h3>
      <p>No Bug tracker issues were found in this project or its subprojects.</p>
    </div>
  <% else %>
    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Ending Bugs by Bug Source</div>
      <div class="tj-bug-bars">
        <% max_remaining = @bug_analysis_rows.map { |row| row[:remaining].to_i }.max.to_i %>
        <% remaining_rows = @bug_analysis_rows.select { |row| row[:remaining].to_i.positive? }.sort_by { |row| [-row[:remaining].to_i, row[:reason].to_s.downcase] } %>
        <% if remaining_rows.empty? %>
          <div class="tj-flow-empty-note">No ending bugs in this period.</div>
        <% end %>
        <% remaining_rows.each do |row| %>
          <% width = max_remaining.positive? ? ((row[:remaining].to_f / max_remaining) * 100).round : 0 %>
          <%= link_to project_issues_path(@project, bug_analysis_issue_filter_params(row, :remaining)),
                class: 'tj-bug-bar-row',
                title: "Open ending Bug issues for #{row[:reason]}" do %>
            <span class="tj-bug-bar-label"><%= h(row[:reason]) %></span>
            <span class="tj-bug-bar-track">
              <span class="tj-bug-bar-fill" style="width:<%= width %>%"></span>
            </span>
            <span class="tj-bug-bar-count"><%= row[:remaining] %></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Bug Movement By Bug Source</div>
      <div class="tj-table-wrap">
        <table class="tj-table tj-bug-analysis-table">
          <thead>
            <tr>
              <th class="tj-th-title"><%= bug_analysis_sort_link(@query, :reason, 'Bug Source') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :beginning, 'Bugs at Beginning') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :beginning_percent, '%') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :found, 'Bugs Found') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :found_percent, '%') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :closed, 'Bugs Closed') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :closed_percent, '%') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :remaining, 'Ending Bugs') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :remaining_percent, '%') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :impact_sum, 'Ending Impact') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :impact_average, 'Avg Ending Impact') %></th>
              <th class="tj-th-native"><%= bug_analysis_sort_link(@query, :change_percent, 'Start-End Change') %></th>
            </tr>
          </thead>
          <tbody>
            <% @bug_analysis_rows.each do |row| %>
              <tr class="tj-row">
                <td class="tj-td-title"><%= h(row[:reason]) %></td>
                <td class="tj-td-native"><%= bug_analysis_count_link(row, :beginning, row[:beginning]) %></td>
                <td class="tj-td-native"><%= number_to_percentage(row[:beginning_percent] * 100, precision: 1) %></td>
                <td class="tj-td-native"><%= bug_analysis_count_link(row, :found, row[:found]) %></td>
                <td class="tj-td-native"><%= number_to_percentage(row[:found_percent] * 100, precision: 1) %></td>
                <td class="tj-td-native"><%= bug_analysis_count_link(row, :closed, row[:closed]) %></td>
                <td class="tj-td-native"><%= number_to_percentage(row[:closed_percent] * 100, precision: 1) %></td>
                <td class="tj-td-native"><%= bug_analysis_count_link(row, :remaining, row[:remaining]) %></td>
                <td class="tj-td-native"><%= number_to_percentage(row[:remaining_percent] * 100, precision: 1) %></td>
                <td class="tj-td-native"><%= bug_analysis_count_link(row, :impact, row[:impact_sum]) %></td>
                <td class="tj-td-native"><%= row[:impact_count].zero? ? '-' : number_with_precision(row[:impact_average], precision: 1, strip_insignificant_zeros: true) %></td>
                <td class="tj-td-native <%= row[:change_percent].to_f.positive? ? 'tj-flow-negative' : (row[:change_percent].to_f.negative? ? 'tj-flow-positive' : '') %>">
                  <%= row[:change_percent].nil? ? '-' : number_to_percentage(row[:change_percent] * 100, precision: 1) %>
                </td>
              </tr>
            <% end %>
            <tr class="tj-flow-total-row">
              <td class="tj-td-title tj-total-label">Total Bugs</td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:beginning] %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:beginning].positive? ? '100%' : '-' %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:found] %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:found].positive? ? '100%' : '-' %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:closed] %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:closed].positive? ? '100%' : '-' %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:remaining] %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:remaining].positive? ? '100%' : '-' %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:impact_sum] %></td>
              <td class="tj-td-native"><%= @bug_analysis_totals[:impact_count].positive? ? number_with_precision(@bug_analysis_totals[:impact_average], precision: 1, strip_insignificant_zeros: true) : '-' %></td>
              <td class="tj-td-native">
                <%= @bug_analysis_totals[:change_percent].nil? ? '-' : number_to_percentage(@bug_analysis_totals[:change_percent] * 100, precision: 1) %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% if @bug_impact_summary_rows.present? %>
    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Bug Impact Summary</div>
      <div class="tj-table-wrap">
        <table class="tj-table">
          <thead>
            <tr>
              <th class="tj-th-title">Item</th>
              <th class="tj-th-native">Beginning</th>
              <th class="tj-th-native">Found</th>
              <th class="tj-th-native">Closed</th>
              <th class="tj-th-native">Ending</th>
            </tr>
          </thead>
          <tbody>
            <% @bug_impact_summary_rows.each do |row| %>
              <tr class="tj-row">
                <td class="tj-td-title"><%= h(row[:item]) %></td>
                <td class="tj-td-native"><%= row[:beginning] %></td>
                <td class="tj-td-native"><%= row[:found] %></td>
                <td class="tj-td-native"><%= row[:closed] %></td>
                <td class="tj-td-native"><%= row[:remaining] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div class="tj-card tj-card-full">
    <div class="tj-card-title">Closed Bugs (Solved Bugs) Analysis</div>
    <% if closed_report[:total_closed].to_i.zero? %>
      <div class="tj-flow-empty-note">No bugs were closed in the selected period.</div>
    <% else %>
      <div class="tj-summary-strip tj-compact-summary-strip">
        <div class="tj-summary-card">
          <div class="tj-sc-label">Closed Bugs <%= ticket_journey_kpi_tooltip(bug_kpi_help[:closed]) %></div>
          <div class="tj-sc-value tj-sc-green"><%= closed_report[:total_closed] %></div>
        </div>
        <div class="tj-summary-card">
          <div class="tj-sc-label">Avg Cycle Time <%= ticket_journey_kpi_tooltip(bug_kpi_help[:average_closed_cycle]) %></div>
          <div class="tj-sc-value tj-sc-blue">
            <% if closed_report[:avg_cycle_hours].present? %>
              <%= duration_report_drilldown_link(@query, closed_report[:avg_cycle_issue_ids], format_hours(closed_report[:avg_cycle_hours]), title: 'Open closed bugs used for average cycle time') %>
            <% else %>
              -
            <% end %>
          </div>
        </div>
      </div>

      <div class="tj-detail-grid tj-bug-closed-panels">
        <div class="tj-subpanel">
          <div class="tj-card-title">Pie Chart of Bug Sources</div>
          <% source_rows = closed_report[:source_rows] || [] %>
          <% if source_rows.empty? %>
            <div class="tj-flow-empty-note">No bug source values found for closed bugs.</div>
          <% else %>
            <%
              pie_colors = ['#2563eb', '#dc2626', '#16a34a', '#f59e0b', '#7c3aed', '#0891b2', '#be123c', '#4b5563']
              cursor = 0.0
              segments = source_rows.each_with_index.map do |row, index|
                start_at = cursor
                cursor += row[:percent].to_f * 100
                "#{pie_colors[index % pie_colors.size]} #{start_at.round(2)}% #{cursor.round(2)}%"
              end
            %>
            <div class="tj-bug-source-pie-wrap">
              <div class="tj-bug-source-pie" style="background: conic-gradient(<%= segments.join(', ') %>);"></div>
              <div class="tj-bug-source-legend">
                <% source_rows.each_with_index do |row, index| %>
                  <div class="tj-bug-source-legend-row">
                    <span class="tj-bug-source-swatch" style="background:<%= pie_colors[index % pie_colors.size] %>"></span>
                    <span><%= duration_report_drilldown_link(@query, row[:issue_ids], row[:source].to_s, title: 'Open closed bugs for this source in Ticket Journey Report') %></span>
                    <strong><%= row[:count] %></strong>
                    <span><%= number_to_percentage(row[:percent] * 100, precision: 1) %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="tj-subpanel">
          <div class="tj-card-title">Histogram of Bug Related Pages</div>
          <% closed_page_rows = closed_report[:related_page_rows] || [] %>
          <% if closed_page_rows.empty? %>
            <div class="tj-flow-empty-note">No Related Page / Module values found for closed bugs.</div>
          <% else %>
            <div class="tj-bug-bars">
              <% max_closed_page_count = closed_page_rows.map { |row| row[:count].to_i }.max.to_i %>
              <% closed_page_rows.each do |row| %>
                <% width = max_closed_page_count.positive? ? ((row[:count].to_f / max_closed_page_count) * 100).round : 0 %>
                <div class="tj-bug-bar-row">
                  <span class="tj-bug-bar-label"><%= duration_report_drilldown_link(@query, row[:issue_ids], row[:page].to_s, title: 'Open closed bugs for this page/module in Ticket Journey Report') %></span>
                  <span class="tj-bug-bar-track">
                    <span class="tj-bug-bar-fill" style="width:<%= width %>%"></span>
                  </span>
                  <span class="tj-bug-bar-count"><%= row[:count] %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="tj-card tj-card-full">
    <div class="tj-card-title">Related Page / Module Histogram</div>
    <% if @bug_related_page_rows.blank? %>
      <div class="tj-flow-empty-note">No Related Page / Module values were found for ending bugs in this period.</div>
    <% else %>
      <div class="tj-bug-bars">
        <% max_page_count = @bug_related_page_rows.map { |row| row[:count].to_i }.max.to_i %>
        <% @bug_related_page_rows.each do |row| %>
          <% width = max_page_count.positive? ? ((row[:count].to_f / max_page_count) * 100).round : 0 %>
          <% bug_risk_class = row[:risk] == 'High' ? 'tj-release-risk-pill-red' : (row[:risk] == 'Medium' ? 'tj-release-risk-pill-amber' : 'tj-release-risk-pill-green') %>
          <div class="tj-bug-bar-row tj-bug-page-bar-row">
            <span class="tj-bug-bar-label"><%= duration_report_drilldown_link(@query, row[:issue_ids], row[:page].to_s, title: 'Open bugs for this page/module in Ticket Journey Report') %></span>
            <span class="tj-bug-bar-track">
              <span class="tj-bug-bar-fill" style="width:<%= width %>%"></span>
            </span>
            <span class="tj-bug-page-meta"><strong><%= row[:count] %></strong><span><%= number_to_percentage(row[:percent] * 100, precision: 1) %></span></span>
            <span class="tj-bug-page-impact"><%= row[:impact_average].positive? ? row[:impact_average] : '-' %></span>
            <span><span class="tj-release-risk-pill <%= bug_risk_class %>"><%= h(row[:risk]) %></span></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @bug_critical_open_rows.present? %>
    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Critical Bugs Open Detail</div>
      <div class="tj-table-wrap">
        <table class="tj-table">
          <thead>
            <tr>
              <th class="tj-th-issue">Bug ID</th>
              <th class="tj-th-title">Subject</th>
              <th class="tj-th-native">Page / Module</th>
              <th class="tj-th-native">Bug Source</th>
              <th class="tj-th-native">Priority</th>
              <th class="tj-th-native">Impact Rating</th>
              <th class="tj-th-native">Owner</th>
              <th class="tj-th-native">Status</th>
              <th class="tj-th-native">Last Update</th>
              <th class="tj-th-native">Risk</th>
            </tr>
          </thead>
          <tbody>
            <% @bug_critical_open_rows.each do |row| %>
              <tr class="tj-row">
                <td class="tj-td-issue"><%= link_to "##{row[:issue_id]}", issue_path(row[:issue]), class: 'tj-drilldown-link' %></td>
                <td class="tj-td-title" title="<%= h(row[:subject]) %>"><%= h(row[:subject]) %></td>
                <td class="tj-td-native"><%= h(row[:page_module]) %></td>
                <td class="tj-td-native"><%= h(row[:bug_source]) %></td>
                <td class="tj-td-native"><%= h(row[:priority]) %></td>
                <td class="tj-td-native"><%= row[:impact_rating] %></td>
                <td class="tj-td-native"><%= h(row[:owner]) %></td>
                <td class="tj-td-native"><span class="tj-status-badge"><%= h(row[:status]) %></span></td>
                <td class="tj-td-native"><%= row[:last_update_days].present? ? "#{row[:last_update_days]}d ago" : '-' %></td>
                <% critical_risk_class = row[:risk] == 'High' ? 'tj-release-risk-pill-red' : (row[:risk] == 'Medium' ? 'tj-release-risk-pill-amber' : 'tj-release-risk-pill-green') %>
                <td class="tj-td-native"><span class="tj-release-risk-pill <%= critical_risk_class %>"><%= h(row[:risk]) %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
