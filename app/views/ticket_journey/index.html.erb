<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">

  <!-- ── PAGE HEADER ── -->
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2>Ticket Journey Duration Report</h2>
        <p class="tj-page-sub">Ticket Journey Map &mdash; <%= @project.name %></p>
      </div>
    </div>
    <div class="tj-page-header-right">
      <%= link_to '⬇ Export CSV',
            ticket_journey_export_path(@project, @query.as_params.merge(format: :csv)),
            class: 'tj-btn tj-btn-export' %>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :duration } %>

  <!-- ── REDMINE QUERY FILTERS ── -->
  <%= form_tag(ticket_journey_path(@project), method: :get, id: 'query_form') do %>
    <%= render partial: 'queries/query_form' %>
  <% end %>

  <!-- ── SUMMARY STRIP ── -->
  <% if @query.valid? && @issues_data.any? %>
  <%
    total_issues = @issues_data.size
    totals       = @issues_data.map { |d| d[:durations][:TOTAL].to_f }.reject(&:zero?)
    avg_h        = totals.any? ? totals.sum / totals.size : 0
    max_h        = totals.max || 0
    c_total      = @issues_data.sum { |d| d[:durations][:C1] + d[:durations][:C2] + d[:durations][:C3] + d[:durations][:C4] }
    c1_t = @issues_data.sum { |d| d[:durations][:C1] }
    c2_t = @issues_data.sum { |d| d[:durations][:C2] }
    c3_t = @issues_data.sum { |d| d[:durations][:C3] }
    c4_t = @issues_data.sum { |d| d[:durations][:C4] }
    counter_totals = { C1: c1_t, C2: c2_t, C3: c3_t, C4: c4_t }
  %>
  <div class="tj-summary-strip">
    <div class="tj-summary-card">
      <div class="tj-sc-label">Issues</div>
      <div class="tj-sc-value tj-sc-accent"><%= total_issues %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Avg Cycle Time</div>
      <div class="tj-sc-value tj-sc-blue"><%= format_hours(avg_h) %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Max Cycle Time</div>
      <div class="tj-sc-value tj-sc-orange"><%= format_hours(max_h) %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Total Returns</div>
      <div class="tj-sc-value tj-sc-red"><%= c_total %></div>
    </div>
    <% counter_definitions.each do |counter| %>
      <% total = counter_totals[counter[:key]] %>
      <div class="tj-summary-card" title="<%= counter[:title] %>">
        <div class="tj-sc-label"><%= counter[:code] %></div>
        <div class="tj-sc-value <%= total > 0 ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= total %></div>
      </div>
    <% end %>
  </div>

  <div class="tj-legend-strip">
    <% counter_definitions.each do |counter| %>
      <div class="tj-legend-item">
        <div class="tj-legend-code"><%= counter[:code] %></div>
        <div class="tj-legend-copy">
          <div class="tj-legend-title"><%= counter[:title] %></div>
          <div class="tj-legend-sub"><%= counter[:transition] %></div>
        </div>
      </div>
    <% end %>
  </div>
  <% end %>

  <!-- ── MAIN TABLE ── -->
  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">📋</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% elsif @issues_data.empty? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">📋</div>
      <h3>No issues found</h3>
      <p>Try adjusting the Redmine query filters above.</p>
    </div>
  <% else %>
  <div class="tj-table-wrap">
    <table class="tj-table" id="tj-table">
      <% native_columns = visible_native_query_columns(@query) %>
      <% grouped_data = grouped_issues_data(@query, @issues_data) %>
      <% total_columns = 3 + native_columns.size + d_fields.size + 6 %>
      <thead>
        <tr>
          <th class="tj-th-issue"><%= query_sort_link(@query, :id, 'Issue') %></th>
          <th class="tj-th-title"><%= query_sort_link(@query, :subject, 'Subject') %></th>
          <th class="tj-th-status"><%= query_sort_link(@query, :status, 'Status') %></th>
          <% native_columns.each do |column| %>
            <th class="tj-th-native"><%= query_sort_link(@query, column) %></th>
          <% end %>
          <% d_fields.each do |f| %>
            <th class="<%= f[:aug] ? 'tj-th-aug' : 'tj-th-d' %>" title="<%= f[:desc] %>"><%= f[:label] %></th>
          <% end %>
          <th class="tj-th-peak">Peak D</th>
          <th class="tj-th-total">TOTAL</th>
          <% counter_definitions.each do |counter| %>
            <th class="tj-th-counter" title="<%= counter[:title] %>"><%= counter[:code] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% grouped_data.each do |label, items| %>
          <% if (heading = group_label(@query, label, items.size)) %>
            <% summary = group_summary(items) %>
            <tr class="tj-group-row">
              <td colspan="<%= total_columns %>" class="tj-group-cell">
                <div class="tj-group-head"><%= heading %></div>
                <div class="tj-group-summary">
                  <span>Issues: <strong><%= summary[:issues] %></strong></span>
                  <span>Avg Total: <strong><%= format_hours(summary[:avg_total]) %></strong></span>
                  <span>Max Total: <strong><%= format_hours(summary[:max_total]) %></strong></span>
                  <span>Returns: <strong><%= summary[:returns] %></strong></span>
                </div>
              </td>
            </tr>
          <% end %>
          <% items.each do |item| %>
            <% iss = item[:issue]; dur = item[:durations] %>
            <tr class="tj-row">
              <td class="tj-td-issue">
                <%= link_to "##{iss.id}", issue_path(iss), class: 'tj-issue-link' %>
              </td>
              <td class="tj-td-title" title="<%= h(iss.subject) %>">
                <%= link_to h(iss.subject), ticket_journey_issue_path(@project, iss.id), class: 'tj-subject-link' %>
              </td>
              <td class="tj-td-status">
                <span class="tj-status-badge"><%= h(iss.status.name) %></span>
              </td>
              <% native_columns.each do |column| %>
                <td class="tj-td-native"><%= column_content(column, iss) %></td>
              <% end %>
              <% d_fields.each do |f| %>
                <% val = dur[f[:key]].to_f %>
                <td class="<%= duration_css_class(val, aug: f[:aug]) %>">
                  <%= format_hours(val) %>
                </td>
              <% end %>
              <td class="tj-td-peak"><%= peak_duration_label(dur) %></td>
              <td class="tj-td-total"><%= format_hours(dur[:TOTAL]) %></td>
              <td class="<%= counter_css_class(dur[:C1]) %>"><%= dur[:C1] > 0 ? dur[:C1] : '—' %></td>
              <td class="<%= counter_css_class(dur[:C2]) %>"><%= dur[:C2] > 0 ? dur[:C2] : '—' %></td>
              <td class="<%= counter_css_class(dur[:C3]) %>"><%= dur[:C3] > 0 ? dur[:C3] : '—' %></td>
              <td class="<%= counter_css_class(dur[:C4]) %>"><%= dur[:C4] > 0 ? dur[:C4] : '—' %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>

</div><!-- /tj-wrap -->
