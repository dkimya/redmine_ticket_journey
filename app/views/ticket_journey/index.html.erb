<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2>Ticket Journey Duration Report</h2>
        <p class="tj-page-sub">Ticket Journey Map &mdash; <%= @project.name %></p>
      </div>
    </div>
    <% unless @detail_view_active %>
      <div class="tj-page-header-right">
        <%= link_to 'Export CSV',
              ticket_journey_export_path(@project, duration_report_params(@query).merge(format: :csv)),
              class: 'tj-btn tj-btn-export' %>
      </div>
    <% end %>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: (@detail_view_active ? :issue_detail : :duration) } %>

  <% unless @detail_view_active %>
    <% if params[:sprint_issue_ids].present? || params[:tj_issue_ids].present? %>
      <% drilldown_ids = (params[:sprint_issue_ids].presence || params[:tj_issue_ids].presence).to_s.split(',').reject(&:blank?) %>
      <div class="tj-drilldown-note">
        <%= params[:sprint_issue_ids].present? ? 'Sprint drill-down' : 'Report drill-down' %> is active. Results are limited to <strong><%= drilldown_ids.size %></strong> selected tickets.
      </div>
    <% end %>
    <%= form_tag(ticket_journey_path(@project), method: :get, id: 'query_form') do %>
      <% if params[:sprint_id].present? %>
        <%= hidden_field_tag :sprint_id, params[:sprint_id] %>
      <% end %>
      <% if params[:sprint_issue_ids].present? %>
        <%= hidden_field_tag :sprint_issue_ids, params[:sprint_issue_ids] %>
      <% end %>
      <% if params[:tj_issue_ids].present? %>
        <%= hidden_field_tag :tj_issue_ids, params[:tj_issue_ids] %>
      <% end %>
      <%= render partial: 'queries/query_form' %>
    <% end %>
  <% end %>

  <% if !@detail_view_active && @query.valid? && @issues_data.any? %>
    <%
      total_issues = @issues_data.size
      totals = @issues_data.map { |item| item[:durations][:TOTAL].to_f }.reject(&:zero?)
      avg_h = totals.any? ? totals.sum / totals.size : 0.0
      max_item = @issues_data.select { |item| item[:durations][:TOTAL].to_f > 0 }.max_by { |item| item[:durations][:TOTAL].to_f }
      max_h = max_item ? max_item[:durations][:TOTAL].to_f : 0.0
      max_detail_params = duration_report_params(@query).merge('view' => 'detail', 'issue_id' => max_item[:issue].id) if max_item
      total_returns_all = @issues_data.sum { |item| total_returns(item[:durations]) }
    %>
    <div class="tj-summary-strip">
      <div class="tj-summary-card">
        <div class="tj-sc-label">Issues</div>
        <div class="tj-sc-value tj-sc-accent"><%= total_issues %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Avg Cycle Time</div>
        <div class="tj-sc-value tj-sc-blue"><%= format_hours(avg_h) %></div>
      </div>
      <% if max_item %>
        <%= link_to ticket_journey_path(@project, max_detail_params), class: 'tj-summary-card tj-summary-link', title: "Open issue ##{max_item[:issue].id} detail" do %>
          <div class="tj-sc-label">Max Cycle Time</div>
          <div class="tj-sc-value tj-sc-orange"><%= format_hours(max_h) %></div>
        <% end %>
      <% else %>
        <div class="tj-summary-card">
          <div class="tj-sc-label">Max Cycle Time</div>
          <div class="tj-sc-value tj-sc-orange"><%= format_hours(max_h) %></div>
        </div>
      <% end %>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Total Returns</div>
        <div class="tj-sc-value tj-sc-red"><%= total_returns_all %></div>
      </div>
    </div>
  <% end %>

  <% if @detail_view_active %>
    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Issue Detail Search</div>
      <%= form_tag(ticket_journey_path(@project), method: :get, class: 'tj-detail-search-form') do %>
        <% duration_report_params(@query).except('issue_id', 'view').each do |key, value| %>
          <% if value.is_a?(Array) %>
            <% value.each do |item| %>
              <%= hidden_field_tag "#{key}[]", item %>
            <% end %>
          <% elsif value.is_a?(Hash) %>
            <% value.each do |subkey, subvalue| %>
              <% if subvalue.is_a?(Array) %>
                <% subvalue.each do |item| %>
                  <%= hidden_field_tag "#{key}[#{subkey}][]", item %>
                <% end %>
              <% else %>
                <%= hidden_field_tag "#{key}[#{subkey}]", subvalue %>
              <% end %>
            <% end %>
          <% else %>
            <%= hidden_field_tag key, value %>
          <% end %>
        <% end %>
        <%= hidden_field_tag :view, 'detail' %>
        <div class="tj-detail-search-fields">
          <%= label_tag :issue_id, 'Issue ID', class: 'tj-detail-search-label' %>
          <%= text_field_tag :issue_id, @detail_issue_id, class: 'tj-detail-search-input', placeholder: 'Enter issue ID, e.g. 10154' %>
          <%= submit_tag 'Open Detail', class: 'tj-btn tj-btn-primary' %>
        </div>
      <% end %>
      <% if @detail_issue_error.present? %>
        <div class="tj-detail-search-message is-error"><%= @detail_issue_error %></div>
      <% elsif @issue.blank? %>
        <div class="tj-detail-search-message">Enter an issue ID or click a subject from the Duration Report to open its detail view here.</div>
      <% end %>
    </div>

    <% if @issue.present? %>
      <%= render partial: 'issue_detail' %>
    <% end %>
  <% elsif !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% elsif @issues_data.empty? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>No issues found</h3>
      <p>Try adjusting the Redmine query filters above.</p>
    </div>
  <% else %>
    <% native_columns = visible_native_query_columns(@query) %>

    <% @report_sections.each do |section| %>
      <% family_key = section[:family_key] %>
      <% items = section[:items] %>
      <% duration_fields = duration_fields_for_family(family_key) %>
      <% planning_fields = duration_fields.select { |field| field[:counted_in_total] == false } %>
      <% cycle_fields = duration_fields.select { |field| field[:counted_in_total] != false } %>
      <% supplemental_fields = supplemental_duration_fields_for_family(family_key) %>
      <% calendar_total = calendar_total_field(family_key) %>
      <% counters = counter_definitions(family_key) %>
      <% summary = section_summary(items) %>
      <% summed_fields = duration_fields + supplemental_fields + [calendar_total] + [{ key: :TOTAL }] %>
      <% table_duration_totals = summed_fields.each_with_object({}) { |field, totals| totals[field[:key]] = items.sum { |item| item[:durations][field[:key]].to_f } } %>
      <% table_counter_totals = counters.each_with_object({}) { |counter, totals| totals[counter[:key]] = items.sum { |item| item[:durations][counter[:key]].to_i } } %>
      <% table_planning_total = planning_fields.sum { |field| table_duration_totals[field[:key]].to_f } %>
      <% table_paused_total = supplemental_fields.sum { |field| table_duration_totals[field[:key]].to_f } %>
      <% table_return_total = table_counter_totals.values.sum(&:to_i) %>

      <div class="tj-card tj-card-full tj-section-card" data-tj-section data-tj-family-key="<%= family_key %>">
        <div class="tj-section-header">
          <div>
            <h3 class="tj-section-title"><%= section[:label] %></h3>
            <div class="tj-group-summary">
              <span>Issues: <strong><%= summary[:issues] %></strong></span>
              <span>Avg Cycle: <strong><%= format_hours(summary[:avg_total]) %></strong></span>
              <span>Max Cycle: <strong><%= format_hours(summary[:max_total]) %></strong></span>
              <span>Returns: <strong><%= summary[:returns] %></strong></span>
              <span>Cycle Sum: <strong><%= format_hours(table_duration_totals[:TOTAL]) %></strong></span>
              <span>On-Hold: <strong><%= format_hours(table_duration_totals[:ON_HOLD]) %></strong></span>
              <% unless family_key.to_sym == :customer_support %>
                <span>Pending: <strong><%= format_hours(table_duration_totals[:PENDING]) %></strong></span>
              <% end %>
              <span>Calendar Sum: <strong><%= format_hours(table_duration_totals[:CALENDAR_TOTAL]) %></strong></span>
            </div>
          </div>
          <div class="tj-section-actions">
            <button type="button" class="tj-section-toggle tj-duration-detail-toggle" data-tj-duration-detail-toggle aria-pressed="false" title="Hide grouped detail columns and keep summary columns visible">
              <span class="tj-section-toggle-icon" aria-hidden="true">-</span>
              <span data-tj-duration-detail-toggle-label>Compact view</span>
            </button>
            <button type="button" class="tj-section-toggle" data-tj-section-toggle aria-expanded="true">
              <span class="tj-section-toggle-icon" aria-hidden="true">-</span>
              <span data-tj-section-toggle-label>Collapse</span>
            </button>
          </div>
        </div>

        <% if counters.any? %>
          <div class="tj-legend-strip tj-legend-strip-section" data-tj-section-body>
            <% counters.each do |counter| %>
              <% total = items.sum { |item| item[:durations][counter[:key]].to_i } %>
              <div class="tj-legend-item" title="<%= counter[:title] %>">
                <div class="tj-legend-code"><%= counter[:code] %></div>
                <div class="tj-legend-copy">
                  <div class="tj-legend-title"><%= counter[:title] %></div>
                  <div class="tj-legend-sub"><%= counter[:transition] %></div>
                </div>
                <div class="tj-legend-total <%= total > 0 ? 'is-active' : '' %>"><%= total %></div>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="tj-table-wrap" data-tj-section-body>
          <table class="tj-table">
            <thead>
              <tr>
                <th class="tj-th-issue"><%= query_sort_link(@query, :id, 'Issue') %></th>
                <th class="tj-th-title"><%= query_sort_link(@query, :subject, 'Subject') %></th>
                <% native_columns.each do |column| %>
                  <th class="tj-th-native"><%= query_sort_link(@query, column) %></th>
                <% end %>
                <% planning_fields.each do |field| %>
                  <% index = duration_fields.index(field) %>
                  <th class="<%= ['tj-planning-detail-col', duration_header_css_class(field), duration_group_css_class(field, duration_fields, index)].reject(&:blank?).join(' ') %>"><%= report_sort_link(@query, family_key, field[:key], field[:label], title: field[:desc]) %></th>
                <% end %>
                <th class="tj-th-total tj-summary-col tj-planning-summary-col tj-group-boundary-right">
                  <button type="button" class="tj-column-group-toggle" data-tj-column-group-toggle="planning" aria-expanded="true" title="Show or hide planning detail columns">
                    Planning Total
                  </button>
                </th>
                <% cycle_fields.each do |field| %>
                  <% index = duration_fields.index(field) %>
                  <th class="<%= ['tj-cycle-detail-col', duration_header_css_class(field), duration_group_css_class(field, duration_fields, index)].reject(&:blank?).join(' ') %>"><%= report_sort_link(@query, family_key, field[:key], field[:label], title: field[:desc]) %></th>
                <% end %>
                <th class="tj-th-peak"><%= report_sort_link(@query, family_key, :peak, 'Peak', title: 'Sort by the highest duration in this tracker family') %></th>
                <th class="tj-th-total tj-cycle-total-end">
                  <div class="tj-th-split">
                    <%= report_sort_link(@query, family_key, :TOTAL, 'Cycle Total', title: cycle_total_tooltip(family_key)) %>
                    <button type="button" class="tj-column-group-toggle" data-tj-column-group-toggle="cycle" aria-expanded="true" title="Show or hide cycle detail columns">Details</button>
                  </div>
                </th>
                <% supplemental_fields.each do |field| %>
                  <th class="<%= duration_header_css_class(field) %> tj-supplemental-col tj-paused-detail-col"><%= report_sort_link(@query, family_key, field[:key], field[:label], title: field[:desc]) %></th>
                <% end %>
                <th class="tj-th-hold tj-summary-col tj-paused-summary-col">
                  <button type="button" class="tj-column-group-toggle" data-tj-column-group-toggle="paused" aria-expanded="true" title="Show or hide paused time columns">
                    Paused Total
                  </button>
                </th>
                <th class="<%= duration_header_css_class(calendar_total) %> tj-group-boundary-right"><%= report_sort_link(@query, family_key, :CALENDAR_TOTAL, calendar_total[:label], title: calendar_total[:desc]) %></th>
                <% if counters.any? %>
                  <% counters.each do |counter| %>
                    <th class="tj-th-counter tj-return-detail-col"><%= report_sort_link(@query, family_key, counter[:key], counter[:code], title: counter[:title]) %></th>
                  <% end %>
                  <th class="tj-th-counter tj-summary-col tj-return-summary-col tj-group-boundary-right">
                    <button type="button" class="tj-column-group-toggle" data-tj-column-group-toggle="returns" aria-expanded="true" title="Show or hide return counter columns">
                      Total R
                    </button>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% grouped_issues_data(@query, items).each do |label, grouped_items| %>
                <% if (heading = group_label(@query, label, grouped_items.size)) %>
                  <% grouped_summary = section_summary(grouped_items) %>
                  <tr class="tj-group-row">
                    <td colspan="<%= section_table_column_count(@query, family_key) %>" class="tj-group-cell">
                      <div class="tj-group-head"><%= heading %></div>
                      <div class="tj-group-summary">
                        <span>Issues: <strong><%= grouped_summary[:issues] %></strong></span>
                        <span>Avg Cycle: <strong><%= format_hours(grouped_summary[:avg_total]) %></strong></span>
                        <span>Max Cycle: <strong><%= format_hours(grouped_summary[:max_total]) %></strong></span>
                        <span>Returns: <strong><%= grouped_summary[:returns] %></strong></span>
                      </div>
                    </td>
                  </tr>
                <% end %>

                <% grouped_items.each do |item| %>
                  <% issue = item[:issue] %>
                  <% durations = item[:durations] %>
                  <% row_planning_total = planning_fields.sum { |field| durations[field[:key]].to_f } %>
                  <% row_paused_total = supplemental_fields.sum { |field| durations[field[:key]].to_f } %>
                  <% row_return_total = total_returns(durations) %>
                  <tr class="tj-row">
                    <td class="tj-td-issue"><%= link_to "##{issue.id}", issue_path(issue), class: 'tj-issue-link' %></td>
                    <td class="tj-td-title" title="<%= h(issue.subject) %>"><%= link_to h(issue.subject), ticket_journey_path(@project, issue_detail_params(@query, issue)), class: 'tj-subject-link' %></td>
                    <% native_columns.each do |column| %>
                      <td class="tj-td-native"><%= column_content(column, issue) %></td>
                    <% end %>
                    <% planning_fields.each do |field| %>
                      <% index = duration_fields.index(field) %>
                      <% value = durations[field[:key]].to_f %>
                      <td class="<%= ['tj-planning-detail-col', duration_css_class(value, aug: field[:aug]), duration_group_css_class(field, duration_fields, index)].reject(&:blank?).join(' ') %>"><%= format_hours(value) %></td>
                    <% end %>
                    <td class="tj-td-total tj-summary-col tj-planning-summary-col tj-group-boundary-right"><%= format_hours(row_planning_total) %></td>
                    <% cycle_fields.each do |field| %>
                      <% index = duration_fields.index(field) %>
                      <% value = durations[field[:key]].to_f %>
                      <td class="<%= ['tj-cycle-detail-col', duration_css_class(value, aug: field[:aug]), duration_group_css_class(field, duration_fields, index)].reject(&:blank?).join(' ') %>"><%= format_hours(value) %></td>
                    <% end %>
                    <td class="tj-td-peak"><%= peak_duration_label(durations, family_key) %></td>
                    <td class="tj-td-total tj-cycle-total-end"><%= format_hours(durations[:TOTAL]) %></td>
                    <% supplemental_fields.each do |field| %>
                      <% value = durations[field[:key]].to_f %>
                      <td class="<%= duration_css_class(value, aug: field[:aug]) %> tj-supplemental-col tj-paused-detail-col"><%= format_hours(value) %></td>
                    <% end %>
                    <td class="tj-td-total tj-summary-col tj-paused-summary-col"><%= format_hours(row_paused_total) %></td>
                    <td class="tj-td-total tj-group-boundary-right"><%= format_hours(durations[:CALENDAR_TOTAL]) %></td>
                    <% if counters.any? %>
                      <% counters.each do |counter| %>
                        <% count = durations[counter[:key]].to_i %>
                        <td class="<%= counter_css_class(count) %> tj-return-detail-col"><%= count > 0 ? count : '-' %></td>
                      <% end %>
                      <td class="<%= counter_css_class(row_return_total) %> tj-summary-col tj-return-summary-col tj-group-boundary-right"><%= row_return_total.positive? ? row_return_total : '-' %></td>
                    <% end %>
                  </tr>
                <% end %>
              <% end %>
              <tr class="tj-total-row">
                <td class="tj-td-issue">Total</td>
                <td class="tj-td-title"><span class="tj-total-label"><%= "#{items.size} issues" %></span></td>
                <% native_columns.each do |_column| %>
                  <td class="tj-td-native">-</td>
                <% end %>
                <% planning_fields.each do |field| %>
                  <% index = duration_fields.index(field) %>
                  <% value = table_duration_totals[field[:key]].to_f %>
                  <td class="<%= ['tj-planning-detail-col', duration_css_class(value, aug: field[:aug]), duration_group_css_class(field, duration_fields, index)].reject(&:blank?).join(' ') %>"><%= format_hours(value) %></td>
                <% end %>
                <td class="tj-td-total tj-summary-col tj-planning-summary-col tj-group-boundary-right"><%= format_hours(table_planning_total) %></td>
                <% cycle_fields.each do |field| %>
                  <% index = duration_fields.index(field) %>
                  <% value = table_duration_totals[field[:key]].to_f %>
                  <td class="<%= ['tj-cycle-detail-col', duration_css_class(value, aug: field[:aug]), duration_group_css_class(field, duration_fields, index)].reject(&:blank?).join(' ') %>"><%= format_hours(value) %></td>
                <% end %>
                <td class="tj-td-peak">-</td>
                <td class="tj-td-total tj-cycle-total-end"><%= format_hours(table_duration_totals[:TOTAL]) %></td>
                <% supplemental_fields.each do |field| %>
                  <% value = table_duration_totals[field[:key]].to_f %>
                  <td class="<%= duration_css_class(value, aug: field[:aug]) %> tj-supplemental-col tj-paused-detail-col"><%= format_hours(value) %></td>
                <% end %>
                <td class="tj-td-total tj-summary-col tj-paused-summary-col"><%= format_hours(table_paused_total) %></td>
                <td class="tj-td-total tj-group-boundary-right"><%= format_hours(table_duration_totals[:CALENDAR_TOTAL]) %></td>
                <% if counters.any? %>
                  <% counters.each do |counter| %>
                    <% count = table_counter_totals[counter[:key]].to_i %>
                    <td class="<%= counter_css_class(count) %> tj-return-detail-col"><%= count > 0 ? count : '-' %></td>
                  <% end %>
                  <td class="<%= counter_css_class(table_return_total) %> tj-summary-col tj-return-summary-col tj-group-boundary-right"><%= table_return_total.positive? ? table_return_total : '-' %></td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-tj-section-toggle]').forEach(function (button) {
      if (button.dataset.tjToggleBound === 'true') return;
      button.dataset.tjToggleBound = 'true';

      button.addEventListener('click', function () {
        var section = button.closest('[data-tj-section]');
        var expanded = button.getAttribute('aria-expanded') !== 'false';
        var nextExpanded = !expanded;
        var label = button.querySelector('[data-tj-section-toggle-label]');
        var icon = button.querySelector('.tj-section-toggle-icon');

        button.setAttribute('aria-expanded', String(nextExpanded));
        section.classList.toggle('is-collapsed', !nextExpanded);
        if (label) label.textContent = nextExpanded ? 'Collapse' : 'Expand';
        if (icon) icon.textContent = nextExpanded ? '-' : '+';
      });
    });

    document.querySelectorAll('[data-tj-duration-detail-toggle]').forEach(function (button) {
      if (button.dataset.tjDurationToggleBound === 'true') return;
      button.dataset.tjDurationToggleBound = 'true';

      var section = button.closest('[data-tj-section]');
      var familyKey = section && section.dataset.tjFamilyKey ? section.dataset.tjFamilyKey : 'default';
      var groupButtons = section ? Array.prototype.slice.call(section.querySelectorAll('[data-tj-column-group-toggle]')) : [];
      var groups = groupButtons.map(function (groupButton) { return groupButton.dataset.tjColumnGroupToggle; });
      var label = button.querySelector('[data-tj-duration-detail-toggle-label]');
      var icon = button.querySelector('.tj-section-toggle-icon');

      function groupHiddenClass(group) {
        return 'is-' + group + '-details-hidden';
      }

      function groupStorageKey(group) {
        return 'ticketJourney.durationGroupHidden.' + familyKey + '.' + group;
      }

      function isGroupHidden(group) {
        return section.classList.contains(groupHiddenClass(group));
      }

      function setGroupHidden(group, hidden) {
        if (!section) return;
        section.classList.toggle(groupHiddenClass(group), hidden);
        localStorage.setItem(groupStorageKey(group), String(hidden));

        groupButtons.filter(function (groupButton) {
          return groupButton.dataset.tjColumnGroupToggle === group;
        }).forEach(function (groupButton) {
          groupButton.setAttribute('aria-expanded', String(!hidden));
          groupButton.classList.toggle('is-collapsed', hidden);
        });
      }

      function updateCompactButton() {
        var allHidden = groups.length > 0 && groups.every(isGroupHidden);
        if (section) section.classList.toggle('is-compact-duration-view', allHidden);
        button.setAttribute('aria-pressed', String(allHidden));
        button.setAttribute('title', allHidden ? 'Show all grouped detail columns' : 'Hide grouped detail columns and keep summary columns visible');
        if (label) label.textContent = allHidden ? 'Show all details' : 'Compact view';
        if (icon) icon.textContent = allHidden ? '+' : '-';
      }

      groups.forEach(function (group) {
        setGroupHidden(group, localStorage.getItem(groupStorageKey(group)) === 'true');
      });
      updateCompactButton();

      groupButtons.forEach(function (groupButton) {
        if (groupButton.dataset.tjColumnToggleBound === 'true') return;
        groupButton.dataset.tjColumnToggleBound = 'true';

        groupButton.addEventListener('click', function () {
          var group = groupButton.dataset.tjColumnGroupToggle;
          setGroupHidden(group, !isGroupHidden(group));
          updateCompactButton();
        });
      });

      button.addEventListener('click', function () {
        var allHidden = groups.length > 0 && groups.every(isGroupHidden);
        groups.forEach(function (group) {
          setGroupHidden(group, !allHidden);
        });
        updateCompactButton();
      });
    });
  });
</script>
