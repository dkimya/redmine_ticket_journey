<%
  pmo_params = pmo_control_params(@query)
  sprint_params = sprint_delivery_params(@query)
  planning_params = planning_estimation_params(@query)
  duration_params = duration_report_params(@query)
  owner_params = owner_returns_params(@query)
  qa_params = qa_returns_params(@query)
  workload_params = owner_workload_params(@query)
  aging_params = aging_risk_params(@query)
  priority_params = priority_risk_params(@query)
  cycle_params = cycle_distribution_params(@query)
  flow_params = flow_report_params(@query)
  health_params = project_health_params(@query)
  release_params = release_readiness_params(@query)
  bug_params = bug_analysis_params(@query)
  data_quality_tab_params = data_quality_params(@query)
  duration_params = duration_params.except('issue_id', 'view')
  detail_params =
    if @issue.present?
      duration_report_params(@query).merge('issue_id' => @issue.id, 'view' => 'detail')
    else
      issue_detail_tab_params(@query)
    end
  main_dashboard_tabs = [
    ['PMO Control', ticket_journey_pmo_control_path(@project, pmo_params), :pmo_control],
    ['Sprint Delivery', ticket_journey_sprint_delivery_path(@project, sprint_params), :sprint_delivery],
    ['Team / Ticket Owner Performance', ticket_journey_owner_returns_path(@project, owner_params), :owner_returns],
    ['QA & Returns', ticket_journey_qa_returns_path(@project, qa_params), :qa_returns],
    ['Bug Control', ticket_journey_bug_analysis_path(@project, bug_params), :bug_analysis],
    ['Planning & Estimation', ticket_journey_planning_estimation_path(@project, planning_params), :planning_estimation],
    ['Ticket Quality & Data Discipline', ticket_journey_data_quality_path(@project, data_quality_tab_params), :data_quality]
  ]
  supporting_tabs = [
    ['Duration Report', ticket_journey_path(@project, duration_params), :duration],
    ['Issue Detail', ticket_journey_path(@project, detail_params), :issue_detail],
    ['Owner Workload / Time Support', ticket_journey_owner_workload_path(@project, workload_params), :owner_workload],
    ['Aging / SLA Risk', ticket_journey_aging_risk_path(@project, aging_params), :aging_risk],
    ['Priority / SLA Risk', ticket_journey_priority_risk_path(@project, priority_params), :priority_risk],
    ['Cycle Distribution', ticket_journey_cycle_distribution_path(@project, cycle_params), :cycle_distribution],
    ['Flow Report', ticket_journey_flow_report_path(@project, flow_params), :flow_report],
    ['Project Health', ticket_journey_project_health_path(@project, health_params), :project_health],
    ['Release Readiness', ticket_journey_release_readiness_path(@project, release_params), :release_readiness]
  ]
%>
<div class="tj-report-tabs">
  <div class="tj-report-tab-group">
    <div class="tj-report-tab-group-title">Main Dashboards</div>
    <div class="tj-report-tab-row">
      <% main_dashboard_tabs.each do |label, path, tab_key| %>
        <%= link_to label, path, class: "tj-report-tab #{active_tab == tab_key ? 'is-active' : ''}" %>
      <% end %>
    </div>
  </div>
  <div class="tj-report-tab-group">
    <div class="tj-report-tab-group-title">Supporting Views</div>
    <div class="tj-report-tab-row">
      <% supporting_tabs.each do |label, path, tab_key| %>
        <%= link_to label, path, class: "tj-report-tab tj-report-tab-support #{active_tab == tab_key ? 'is-active' : ''}" %>
      <% end %>
    </div>
  </div>
</div>
