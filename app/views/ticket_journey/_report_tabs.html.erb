<%
  duration_params = duration_report_params(@query)
  owner_params = owner_returns_params(@query)
  workload_params = owner_workload_params(@query)
  aging_params = aging_risk_params(@query)
  priority_params = priority_risk_params(@query)
  cycle_params = cycle_distribution_params(@query)
  flow_params = flow_report_params(@query)
  health_params = project_health_params(@query)
  release_params = release_readiness_params(@query)
  bug_params = bug_analysis_params(@query)
  data_quality_tab_params = data_quality_params(@query)
  duration_params = duration_params.except('issue_id', 'view')
  detail_params =
    if @issue.present?
      duration_report_params(@query).merge('issue_id' => @issue.id, 'view' => 'detail')
    else
      issue_detail_tab_params(@query)
    end
%>
<div class="tj-report-tabs">
  <%= link_to 'Duration Report',
        ticket_journey_path(@project, duration_params),
        class: "tj-report-tab #{active_tab == :duration ? 'is-active' : ''}" %>
  <%= link_to 'Issue Detail',
        ticket_journey_path(@project, detail_params),
        class: "tj-report-tab #{active_tab == :issue_detail ? 'is-active' : ''}" %>
  <%= link_to 'Ticket Owner Performance',
        ticket_journey_owner_returns_path(@project, owner_params),
        class: "tj-report-tab #{active_tab == :owner_returns ? 'is-active' : ''}" %>
  <%= link_to 'Owner Workload',
        ticket_journey_owner_workload_path(@project, workload_params),
        class: "tj-report-tab #{active_tab == :owner_workload ? 'is-active' : ''}" %>
  <%= link_to 'Aging / SLA Risk',
        ticket_journey_aging_risk_path(@project, aging_params),
        class: "tj-report-tab #{active_tab == :aging_risk ? 'is-active' : ''}" %>
  <%= link_to 'Priority / SLA Risk',
        ticket_journey_priority_risk_path(@project, priority_params),
        class: "tj-report-tab #{active_tab == :priority_risk ? 'is-active' : ''}" %>
  <%= link_to 'Cycle Distribution',
        ticket_journey_cycle_distribution_path(@project, cycle_params),
        class: "tj-report-tab #{active_tab == :cycle_distribution ? 'is-active' : ''}" %>
  <%= link_to 'Flow Report',
        ticket_journey_flow_report_path(@project, flow_params),
        class: "tj-report-tab #{active_tab == :flow_report ? 'is-active' : ''}" %>
  <%= link_to 'Project Health',
        ticket_journey_project_health_path(@project, health_params),
        class: "tj-report-tab #{active_tab == :project_health ? 'is-active' : ''}" %>
  <%= link_to 'Release Readiness',
        ticket_journey_release_readiness_path(@project, release_params),
        class: "tj-report-tab #{active_tab == :release_readiness ? 'is-active' : ''}" %>
  <%= link_to 'Bugs Analysis',
        ticket_journey_bug_analysis_path(@project, bug_params),
        class: "tj-report-tab #{active_tab == :bug_analysis ? 'is-active' : ''}" %>
  <%= link_to 'Data Quality',
        ticket_journey_data_quality_path(@project, data_quality_tab_params),
        class: "tj-report-tab #{active_tab == :data_quality ? 'is-active' : ''}" %>
</div>
