<%
  clean_tab_params = ->(query_params) { query_params.except('support_section', :support_section) }

  pmo_params = clean_tab_params.call(pmo_control_params(@query))
  sprint_params = clean_tab_params.call(sprint_delivery_params(@query))
  planning_params = clean_tab_params.call(planning_estimation_params(@query))
  duration_params = clean_tab_params.call(duration_report_params(@query))
  owner_params = clean_tab_params.call(owner_returns_params(@query))
  qa_params = clean_tab_params.call(qa_returns_params(@query))
  workload_params = clean_tab_params.call(owner_workload_params(@query))
  snapshot_params = clean_tab_params.call(status_snapshot_params(@query))
  time_utilization_tab_params = clean_tab_params.call(time_utilization_params(@query))
  aging_params = clean_tab_params.call(aging_risk_params(@query))
  priority_params = clean_tab_params.call(priority_risk_params(@query))
  cycle_params = clean_tab_params.call(cycle_distribution_params(@query))
  flow_params = clean_tab_params.call(flow_report_params(@query))
  health_params = clean_tab_params.call(project_health_params(@query))
  release_params = clean_tab_params.call(release_readiness_params(@query))
  bug_params = clean_tab_params.call(bug_analysis_params(@query))
  data_quality_tab_params = clean_tab_params.call(data_quality_params(@query))
  original_sprint_tab_params = clean_tab_params.call(original_sprint_params(@query))
  duration_params = duration_params.except('issue_id', 'view')
  detail_params =
    if @issue.present?
      clean_tab_params.call(duration_report_params(@query)).merge('issue_id' => @issue.id, 'view' => 'detail')
    else
      clean_tab_params.call(issue_detail_tab_params(@query))
    end
  tabs_by_key = {
    pmo_control: ['Project Control', ticket_journey_pmo_control_path(@project, pmo_params)],
    sprint_delivery: ['Sprint Delivery', ticket_journey_sprint_delivery_path(@project, sprint_params)],
    owner_returns: ['Team Performance', ticket_journey_owner_returns_path(@project, owner_params)],
    qa_returns: ['Rework Analysis', ticket_journey_qa_returns_path(@project, qa_params)],
    bug_analysis: ['Bug Analysis', ticket_journey_bug_analysis_path(@project, bug_params)],
    planning_estimation: ['Planning Quality', ticket_journey_planning_estimation_path(@project, planning_params)],
    data_quality: ['Data Quality', ticket_journey_data_quality_path(@project, data_quality_tab_params)],
    original_sprint: ['Ticket Original Sprint', ticket_journey_original_sprint_path(@project, original_sprint_tab_params)],
    duration: ['Duration Report', ticket_journey_path(@project, duration_params)],
    issue_detail: ['Issue Detail', ticket_journey_path(@project, detail_params)],
    owner_workload: ['Owner Workload / Time Support', ticket_journey_owner_workload_path(@project, workload_params)],
    status_snapshot: ['Status Snapshot', ticket_journey_status_snapshot_path(@project, snapshot_params)],
    time_utilization: ['Time Utilization & Scope Control', ticket_journey_time_utilization_path(@project, time_utilization_tab_params)],
    aging_risk: ['Aging / SLA Risk', ticket_journey_aging_risk_path(@project, aging_params)],
    priority_risk: ['Priority / SLA Risk', ticket_journey_priority_risk_path(@project, priority_params)],
    cycle_distribution: ['Cycle Distribution', ticket_journey_cycle_distribution_path(@project, cycle_params)],
    flow_report: ['Flow Report', ticket_journey_flow_report_path(@project, flow_params)],
    project_health: ['Project Health', ticket_journey_project_health_path(@project, health_params)],
    release_readiness: ['Release Readiness', ticket_journey_release_readiness_path(@project, release_params)]
  }

  main_dashboard_keys = [
    :pmo_control,
    :sprint_delivery,
    :owner_returns,
    :qa_returns,
    :bug_analysis,
    :planning_estimation,
    :time_utilization,
    :data_quality
  ]

  support_sections = {
    pmo_control: {
      label: 'Project Control',
      keys: [:pmo_control, :project_health, :release_readiness, :aging_risk, :priority_risk, :issue_detail]
    },
    sprint_delivery: {
      label: 'Sprint Delivery',
      keys: [:sprint_delivery, :duration, :cycle_distribution, :flow_report, :priority_risk, :issue_detail]
    },
    owner_returns: {
      label: 'Team Performance',
      keys: [:owner_returns, :owner_workload, :status_snapshot, :duration, :issue_detail]
    },
    qa_returns: {
      label: 'Rework Analysis',
      keys: [:qa_returns, :flow_report, :issue_detail]
    },
    bug_analysis: {
      label: 'Bug Analysis',
      keys: [:bug_analysis, :aging_risk, :priority_risk, :release_readiness, :issue_detail]
    },
    planning_estimation: {
      label: 'Planning Quality',
      keys: [:planning_estimation, :duration, :owner_workload, :issue_detail]
    },
    time_utilization: {
      label: 'Time Utilization & Scope Control',
      keys: [:time_utilization, :owner_workload, :duration, :flow_report, :issue_detail]
    },
    data_quality: {
      label: 'Ticket Quality & Data Discipline',
      keys: [:data_quality, :original_sprint, :issue_detail]
    }
  }

  requested_support_section = params[:support_section].to_s.presence&.to_sym
  active_section_key =
    if requested_support_section && support_sections.key?(requested_support_section)
      requested_support_section
    else
      case active_tab
      when :pmo_control, :project_health, :release_readiness, :aging_risk
        :pmo_control
      when :sprint_delivery, :duration, :cycle_distribution, :flow_report, :priority_risk
        :sprint_delivery
      when :owner_returns, :owner_workload, :status_snapshot
        :owner_returns
      when :qa_returns
        :qa_returns
      when :bug_analysis
        :bug_analysis
      when :planning_estimation
        :planning_estimation
      when :time_utilization
        :time_utilization
      when :data_quality, :original_sprint
        :data_quality
      else
        :pmo_control
      end
    end

  active_support_section = support_sections.fetch(active_section_key)
  support_section_query = "support_section=#{active_section_key}"
%>
<div class="tj-report-tabs">
  <div class="tj-report-tab-group">
    <div class="tj-report-tab-group-title">Main Dashboards</div>
    <div class="tj-report-tab-row">
      <% main_dashboard_keys.each do |tab_key| %>
        <% label, path = tabs_by_key.fetch(tab_key) %>
        <%= link_to label, path, class: "tj-report-tab #{active_section_key == tab_key ? 'is-active' : ''}" %>
      <% end %>
    </div>
  </div>
  <div class="tj-report-tab-group">
    <div class="tj-report-tab-group-title"><%= active_support_section[:label] %> Views</div>
    <div class="tj-report-tab-row">
      <% active_support_section[:keys].each do |tab_key| %>
        <% label, path = tabs_by_key.fetch(tab_key) %>
        <% contextual_path = path.to_s.include?('?') ? "#{path}&#{support_section_query}" : "#{path}?#{support_section_query}" %>
        <%= link_to label, contextual_path, class: "tj-report-tab tj-report-tab-support #{active_tab == tab_key ? 'is-active' : ''}" %>
      <% end %>
    </div>
  </div>
</div>

<%= render partial: 'report_query_links' %>
