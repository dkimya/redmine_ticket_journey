<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2><%= ticket_journey_header_context_tag(:pmo_control) %>Project Health</h2>
        <p class="tj-page-sub">High-level open ticket health snapshot &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :project_health } %>

  <%= form_tag(ticket_journey_project_health_path(@project), method: :get, id: 'query_form') do %>
    <%= hidden_field_tag :support_section, params[:support_section] if params[:support_section].present? %>
    <%= render partial: 'queries/query_form' %>
  <% end %>

  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% else %>
  <div class="tj-summary-strip">
    <div class="tj-summary-card">
      <div class="tj-sc-label">Report Date</div>
      <div class="tj-sc-value tj-sc-accent"><%= format_date(@project_health_report[:report_date]) %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Projects</div>
      <div class="tj-sc-value tj-sc-blue"><%= @project_health_report[:project_count] %></div>
    </div>
    <div class="tj-summary-card">
      <div class="tj-sc-label">Total Open</div>
      <div class="tj-sc-value tj-sc-green">
        <%= duration_report_drilldown_link(@query, @project_health_report[:issue_ids], @project_health_report[:total_open], title: 'Open all health report tickets in Ticket Journey Report') %>
      </div>
    </div>
  </div>

  <div class="tj-health-grid">
    <% [:technical, :planned, :tasks, :milestones].each do |key| %>
      <% block = @project_health_report[key] %>
      <div class="tj-card tj-health-card">
        <div class="tj-health-card-header">
          <div>
            <div class="tj-card-title"><%= block[:title] %></div>
            <div class="tj-health-total">
              <%= duration_report_drilldown_link(@query, block[:issue_ids], block[:total], title: "Open #{block[:title]} tickets in Ticket Journey Report") %>
            </div>
          </div>
        </div>
        <div class="tj-health-note"><%= block[:note] %></div>

        <table class="tj-health-table">
          <tbody>
            <% block[:rows].each do |row| %>
              <tr>
                <td class="tj-health-label"><%= row[:label] %></td>
                <td class="tj-health-count">
                  <%= duration_report_drilldown_link(@query, row[:issue_ids], row[:count], title: "Open #{row[:label]} tickets in Ticket Journey Report") %>
                </td>
                <td class="tj-health-percent"><%= number_to_percentage(row[:percent] * 100, precision: 1) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <% end %>
</div>
