<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">

  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <%= ticket_journey_breadcrumb_tag(:owner_returns) %>
        <h2>Team / Ticket Owner Performance Dashboard</h2>
        <p class="tj-page-sub">Journey Report Summary &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :owner_returns } %>

  <%= form_tag(ticket_journey_owner_returns_path(@project), method: :get, id: 'query_form') do %>
    <%= render partial: 'queries/query_form' %>

    <div class="tj-filter-bar tj-owner-filter-bar">
      <div class="tj-filter-form">
        <div class="tj-filter-group">
          <label for="ticket_owner_role_id">Ticket Owner Role</label>
          <%= select_tag :ticket_owner_role_id,
                options_for_select([['All roles', 'all']] + @owner_roles.map { |role| [role.name, role.id] }, @selected_owner_role_option),
                class: 'tj-input',
                onchange: 'this.form.submit();' %>
        </div>
        <div class="tj-filter-group">
          <label for="stale_days">No Update Threshold</label>
          <%= number_field_tag :stale_days, @owner_performance_stale_days, min: 1, class: 'tj-input tj-small-number-input', onchange: 'this.form.submit();' %>
        </div>
      </div>
    </div>
  <% end %>

  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">📋</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% elsif @owner_return_rows.empty? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">📋</div>
      <h3>No ticket owner performance data found</h3>
      <p>Try adjusting the Redmine query filters above.</p>
    </div>
  <% else %>
    <%
      total_tickets = @owner_return_rows.sum { |row| row[:total_tickets] }
      returned_tickets = @owner_return_rows.sum { |row| row[:returned_tickets] }
      c1_total = @owner_return_rows.sum { |row| row[:c1] }
      c2_total = @owner_return_rows.sum { |row| row[:c2] }
      c3_total = @owner_return_rows.sum { |row| row[:c3] }
      c4_total = @owner_return_rows.sum { |row| row[:c4] }
      total_returns = @owner_return_rows.sum { |row| row[:total_returns] }
      done_tickets = @owner_return_rows.sum { |row| row[:done_tickets] }
      owner_debt = @owner_return_rows.sum { |row| row[:owner_debt] }
      tickets_without_updates = @owner_return_rows.sum { |row| row[:tickets_without_updates] }
      counter_totals = { C1: c1_total, C2: c2_total, C3: c3_total, C4: c4_total }
    %>

    <%
      throughput_total = @owner_return_rows.sum { |row| row[:total_tickets].to_f }
      total_open_all = @owner_return_rows.sum { |row| row[:open_tickets] }
    %>

    <div class="tj-summary-strip">
      <div class="tj-summary-card">
        <div class="tj-sc-label">Ticket Owners</div>
        <div class="tj-sc-value tj-sc-accent"><%= @owner_return_rows.size %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">No. of Tickets</div>
        <div class="tj-sc-value tj-sc-blue"><%= total_tickets %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">No. of Returned Tickets</div>
        <div class="tj-sc-value tj-sc-orange"><%= returned_tickets %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Completion Rate</div>
        <div class="tj-sc-value <%= done_tickets.positive? ? 'tj-sc-green' : 'tj-sc-dim' %>"><%= format_percentage(done_tickets, total_tickets) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Owner Throughput</div>
        <div class="tj-sc-value tj-sc-blue" title="Total tickets across all owners in current scope"><%= number_with_precision(throughput_total, precision: 0) %> total</div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Owner Debt</div>
        <div class="tj-sc-value <%= owner_debt.positive? ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= owner_debt %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">No Update <%= @owner_performance_stale_days %>d+</div>
        <div class="tj-sc-value <%= tickets_without_updates.positive? ? 'tj-sc-orange' : 'tj-sc-dim' %>"><%= tickets_without_updates %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Total Returns</div>
        <div class="tj-sc-value tj-sc-red"><%= total_returns %></div>
      </div>
      <% counter_definitions.each do |counter| %>
        <% total = counter_totals[counter[:key]] %>
        <div class="tj-summary-card" title="<%= counter[:title] %>">
          <div class="tj-sc-label"><%= counter[:code] %></div>
          <div class="tj-sc-value <%= total > 0 ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= total %></div>
        </div>
      <% end %>
    </div>

    <div class="tj-table-wrap">
      <table class="tj-table">
        <thead>
            <tr>
              <th class="tj-th-title"><%= owner_returns_sort_link(@query, :owner, 'Ticket Owner') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :total_tickets, 'No. of Tickets') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :ticket_share, '% of All Tickets') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :done_tickets, 'No. of Done Tickets', title: 'Done / Closed tickets in the current filtered result') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :completion_rate, 'Completion Rate', title: 'Done tickets divided by all tickets in the current filtered result') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :avg_done_cycle_time, 'Avg Cycle Time', title: 'Average active time from first In Progress to Done / Closed') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :avg_priority_done_cycle_time, 'Avg Priority Cycle Time', title: 'Average active cycle time for Urgent or Immediate done tickets') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :open_tickets, 'Open Tickets', title: 'Open tickets in the current filtered result') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :owner_debt, 'Owner Debt', title: 'Open overdue tickets') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :tickets_without_updates, "No Update #{@owner_performance_stale_days}d+", title: 'Open tickets not updated within the selected threshold') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :avg_idle_days, 'Avg Idle', title: 'Average days since update for open tickets') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :returned_tickets, 'No. of Returned Tickets') %></th>
              <th class="tj-th-native"><%= owner_returns_sort_link(@query, :return_rate, 'Return Rate') %></th>
              <th class="tj-th-counter"><%= owner_returns_sort_link(@query, :c1, counter_definitions[0][:code], title: counter_definitions[0][:title]) %></th>
              <th class="tj-th-counter"><%= owner_returns_sort_link(@query, :c2, counter_definitions[1][:code], title: counter_definitions[1][:title]) %></th>
              <th class="tj-th-counter"><%= owner_returns_sort_link(@query, :c3, counter_definitions[2][:code], title: counter_definitions[2][:title]) %></th>
            <th class="tj-th-counter"><%= owner_returns_sort_link(@query, :c4, counter_definitions[3][:code], title: counter_definitions[3][:title]) %></th>
            <th class="tj-th-total"><%= owner_returns_sort_link(@query, :total_returns, 'Total Returns') %></th>
          </tr>
        </thead>
        <tbody>
          <% @owner_return_rows.each do |row| %>
            <tr class="tj-row">
              <td class="tj-td-title">
                <%= link_to row[:owner],
                      ticket_journey_path(@project, ticket_owner_filter_params(@query, row[:owner_value])),
                      class: 'tj-subject-link' %>
              </td>
              <td class="tj-td-native"><%= duration_report_drilldown_link(@query, row[:all_issue_ids], row[:total_tickets]) %></td>
              <td class="tj-td-native"><%= format_percentage(row[:total_tickets], total_tickets) %></td>
              <td class="tj-td-native"><%= duration_report_drilldown_link(@query, row[:done_issue_ids], row[:done_tickets]) %></td>
              <td class="tj-td-native"><%= number_to_percentage(row[:completion_rate] * 100, precision: 1) %></td>
              <td class="tj-td-native"><%= format_hours(row[:avg_done_cycle_time]) %></td>
              <td class="tj-td-native"><%= format_hours(row[:avg_priority_done_cycle_time]) %></td>
              <td class="tj-td-native"><%= duration_report_drilldown_link(@query, row[:open_issue_ids], row[:open_tickets]) %></td>
              <td class="tj-td-native <%= row[:owner_debt].positive? ? 'tj-counter-active' : '' %>"><%= duration_report_drilldown_link(@query, row[:owner_debt_issue_ids], row[:owner_debt]) %></td>
              <td class="tj-td-native <%= row[:tickets_without_updates].positive? ? 'tj-counter-active' : '' %>"><%= duration_report_drilldown_link(@query, row[:no_update_issue_ids], row[:tickets_without_updates]) %></td>
              <td class="tj-td-native"><%= row[:open_tickets].positive? ? "#{number_with_precision(row[:avg_idle_days], precision: 1, strip_insignificant_zeros: true)}d" : '-' %></td>
              <td class="tj-td-native"><%= duration_report_drilldown_link(@query, row[:returned_issue_ids], row[:returned_tickets]) %></td>
              <td class="tj-td-native"><%= format_percentage(row[:returned_tickets], row[:total_tickets]) %></td>
              <td class="<%= counter_css_class(row[:c1]) %>"><%= row[:c1] > 0 ? row[:c1] : '—' %></td>
              <td class="<%= counter_css_class(row[:c2]) %>"><%= row[:c2] > 0 ? row[:c2] : '—' %></td>
              <td class="<%= counter_css_class(row[:c3]) %>"><%= row[:c3] > 0 ? row[:c3] : '—' %></td>
              <td class="<%= counter_css_class(row[:c4]) %>"><%= row[:c4] > 0 ? row[:c4] : '—' %></td>
              <td class="tj-td-total"><%= row[:total_returns] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @owner_avg_time_per_status_rows.present? %>
      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Average Time for Each Status</div>
        <div class="tj-table-wrap">
          <table class="tj-table">
            <thead>
              <tr>
                <th class="tj-th-title">Status</th>
                <th class="tj-th-native">Average Duration in Status</th>
                <th class="tj-th-native">Ticket Count (Visits)</th>
              </tr>
            </thead>
            <tbody>
              <% @owner_avg_time_per_status_rows.each do |row| %>
                <tr class="tj-row">
                  <td class="tj-td-title"><%= h(row[:status]) %></td>
                  <td class="tj-td-native"><%= row[:avg_hours].present? ? format_hours(row[:avg_hours]) : '-' %></td>
                  <td class="tj-td-native"><%= row[:ticket_count] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @owner_idle_detail_rows.present? %>
      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Owner Ticket Idle / No Update Detail</div>
        <div class="tj-table-wrap">
          <table class="tj-table">
            <thead>
              <tr>
                <th class="tj-th-title">Owner</th>
                <th class="tj-th-native">Active Tickets</th>
                <th class="tj-th-native">Without Updates</th>
                <th class="tj-th-native">Without Updates %</th>
                <th class="tj-th-native">Average Idle Time</th>
                <th class="tj-th-native">Highest Idle (Days)</th>
              </tr>
            </thead>
            <tbody>
              <% @owner_idle_detail_rows.each do |row| %>
                <tr class="tj-row">
                  <td class="tj-td-title">
                    <%= link_to row[:owner], ticket_journey_path(@project, ticket_owner_filter_params(@query, row[:owner_value])), class: 'tj-subject-link' %>
                  </td>
                  <td class="tj-td-native"><%= duration_report_drilldown_link(@query, row[:open_issue_ids], row[:active_tickets]) %></td>
                  <td class="tj-td-native <%= row[:tickets_without_updates].positive? ? 'tj-counter-active' : '' %>"><%= duration_report_drilldown_link(@query, row[:no_update_issue_ids], row[:tickets_without_updates]) %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:without_updates_percent] * 100, precision: 1) %></td>
                  <td class="tj-td-native"><%= "#{row[:avg_idle_days]}d" %></td>
                  <td class="tj-td-native <%= row[:highest_idle_days] >= @owner_performance_stale_days ? 'tj-counter-active' : '' %>"><%= "#{row[:highest_idle_days]}d" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>

</div>
