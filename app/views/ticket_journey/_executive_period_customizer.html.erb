<script>
  document.addEventListener('DOMContentLoaded', function () {
    var period = document.getElementById('exec_period');
    var startDate = document.getElementById('exec_start_date');
    var endDate = document.getElementById('exec_end_date');

    if (!period || !startDate || !endDate) return;

    function markCustomPeriod() {
      if (period.value !== 'custom') {
        period.value = 'custom';
      }
    }

    startDate.addEventListener('input', markCustomPeriod);
    startDate.addEventListener('change', markCustomPeriod);
    endDate.addEventListener('input', markCustomPeriod);
    endDate.addEventListener('change', markCustomPeriod);
  });
</script>
