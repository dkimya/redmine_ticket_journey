<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2>PMO Control Dashboard</h2>
        <p class="tj-page-sub">Executive project control snapshot &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :pmo_control } %>

  <%= form_tag(ticket_journey_pmo_control_path(@project), method: :get, id: 'query_form') do %>
    <%= hidden_field_tag :support_section, params[:support_section] if params[:support_section].present? %>
    <%= render partial: 'queries/query_form' %>

    <div class="tj-filter-bar tj-owner-filter-bar">
      <div class="tj-filter-form">
        <div class="tj-filter-group">
          <label for="stale_days">No Update Threshold</label>
          <%= number_field_tag :stale_days, @data_quality_stale_days, min: 1, class: 'tj-input tj-small-number-input', onchange: 'this.form.submit();' %>
        </div>
        <div class="tj-filter-group tj-flow-filter-note">
          <span>Default view focuses on planned active tickets. Redmine filters above can narrow the base, then the report combines ticket health, SLA risk, release readiness, bug health, and data discipline signals.</span>
        </div>
      </div>
    </div>
  <% end %>

  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% else %>
    <% report = @pmo_control_report %>
    <div class="tj-summary-strip">
      <div class="tj-summary-card">
        <div class="tj-sc-label">Report Date</div>
        <div class="tj-sc-value tj-sc-accent"><%= format_date(report[:report_date]) %></div>
      </div>
      <div class="tj-summary-card" title="<%= h(report[:overall_status][:note]) %>">
        <div class="tj-sc-label">Overall Health</div>
        <div class="tj-sc-value <%= pmo_control_value_class(report[:overall_status][:tone]) %>"><%= report[:overall_status][:label] %></div>
      </div>
      <% report[:kpis].each do |kpi| %>
        <%= pmo_control_card({ class: "tj-summary-card #{kpi[:path].present? ? 'tj-summary-link' : ''}", title: h(kpi[:help]) }, kpi[:path].present? ? pmo_control_attention_path(kpi) : nil) do %>
          <div class="tj-sc-label"><%= h(kpi[:label]) %></div>
          <div class="tj-sc-value <%= pmo_control_value_class(kpi[:tone]) %>"><%= kpi[:value] %></div>
        <% end %>
      <% end %>
    </div>

    <div class="tj-card tj-card-full">
      <div class="tj-card-title">PMO Control Health Rule</div>
      <div class="tj-flow-empty-note">
        Overall Health becomes <strong>Risk</strong> when priority SLA, overdue, stopped, release risk, or high missing-data signals exist.
        It becomes <strong>Watch</strong> when aging, missing data, or stale-update cleanup is still needed.
      </div>
    </div>

    <div class="tj-detail-grid">
      <div class="tj-card">
        <div class="tj-card-title">Executive Attention</div>
        <% if report[:attention_items].empty? %>
          <div class="tj-flow-empty-note">No high-priority PMO Control attention items for the current filters.</div>
        <% else %>
          <table class="tj-health-table">
            <tbody>
              <% report[:attention_items].each do |item| %>
                <tr>
                  <td class="tj-health-label"><%= link_to item[:label], pmo_control_attention_path(item), class: 'tj-drilldown-link' %></td>
                  <td class="tj-health-count <%= item[:tone] == :red ? 'tj-counter-active' : '' %>"><%= item[:value] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>

      <div class="tj-card">
        <div class="tj-card-title">Open Work Mix</div>
        <table class="tj-health-table">
          <tbody>
            <% [:technical, :planned, :tasks, :milestones].each do |key| %>
              <% block = report[:health][key] %>
              <tr>
                <td class="tj-health-label"><%= block[:title] %></td>
                <td class="tj-health-count"><%= duration_report_drilldown_link(@query, block[:issue_ids], block[:total], title: "Open #{block[:title]}") %></td>
                <td class="tj-health-percent"><%= number_to_percentage(block[:total].to_f / [report[:health][:total_open].to_i, 1].max * 100, precision: 1) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% unless report[:open_technical_snapshot].empty? %>
      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Open Technical Tickets Snapshot</div>
        <div class="tj-table-wrap">
          <table class="tj-table">
            <thead>
              <tr>
                <th class="tj-th-title">Project</th>
                <th class="tj-th-native">Total Open</th>
                <th class="tj-th-native">Backlog</th>
                <th class="tj-th-native">Backlog %</th>
                <th class="tj-th-native">Under Work</th>
                <th class="tj-th-native">Under Work %</th>
                <th class="tj-th-native">Ongoing</th>
                <th class="tj-th-native">Ongoing %</th>
                <th class="tj-th-native">Stopped</th>
                <th class="tj-th-native">Stopped %</th>
              </tr>
            </thead>
            <tbody>
              <% report[:open_technical_snapshot].each do |row| %>
                <tr class="tj-row">
                  <td class="tj-td-title"><%= h(row[:project_name]) %></td>
                  <td class="tj-td-native"><strong><%= row[:total_open] %></strong></td>
                  <td class="tj-td-native">
                    <% if row[:backlog_issue_ids].present? %>
                      <%= link_to row[:backlog],
                            ticket_journey_path(@project, duration_report_drilldown_params(@query, row[:backlog_issue_ids]).merge('support_section' => 'pmo_control')),
                            class: 'tj-drilldown-link',
                            title: 'Open backlog tickets in Duration Report' %>
                    <% else %>
                      <%= row[:backlog] %>
                    <% end %>
                  </td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:backlog_percent] * 100, precision: 1) %></td>
                  <td class="tj-td-native"><%= row[:under_work] %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:under_work_percent] * 100, precision: 1) %></td>
                  <td class="tj-td-native"><%= row[:ongoing] %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:ongoing_percent] * 100, precision: 1) %></td>
                  <td class="tj-td-native <%= row[:stopped].positive? ? 'tj-counter-active' : '' %>"><%= row[:stopped] %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:stopped_percent] * 100, precision: 1) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% unless report[:cross_project_risk_rows].empty? %>
      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Cross-Project Risk Summary</div>
        <div class="tj-table-wrap">
          <table class="tj-table">
            <thead>
              <tr>
                <th class="tj-th-title">Project</th>
                <th class="tj-th-native">Sprint Status</th>
                <th class="tj-th-native">Blocked Tickets</th>
                <th class="tj-th-native">Missing Fields %</th>
                <th class="tj-th-native">No Update %</th>
                <th class="tj-th-native">Overall Risk</th>
              </tr>
            </thead>
            <tbody>
              <% report[:cross_project_risk_rows].each do |row| %>
                <tr class="tj-row">
                  <td class="tj-td-title"><%= h(row[:project_name]) %></td>
                  <td class="tj-td-native"><%= h(row[:sprint_status]) %></td>
                  <td class="tj-td-native <%= row[:blocked_tickets].positive? ? 'tj-counter-active' : '' %>"><%= row[:blocked_tickets] %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:missing_fields_percent] * 100, precision: 1) %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:no_update_percent] * 100, precision: 1) %></td>
                  <td class="tj-td-native"><span class="tj-release-risk-pill <%= data_quality_status_class(row[:overall_risk].downcase) %>"><%= h(row[:overall_risk]) %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Data Discipline Attention</div>
      <% if report[:data_quality_field_rows].empty? %>
        <div class="tj-flow-empty-note">No missing data or stale-update signals for the current filters.</div>
      <% else %>
        <div class="tj-data-quality-bars">
          <% max_data_count = report[:data_quality_field_rows].map { |row| row[:count].to_i }.max.to_i %>
          <% report[:data_quality_field_rows].each do |row| %>
            <% width = max_data_count.positive? ? ((row[:count].to_f / max_data_count) * 100).round : 0 %>
            <% data_quality_path = row[:issue_ids].present? ? ticket_journey_path(@project, duration_report_drilldown_params(@query, row[:issue_ids]).merge('support_section' => 'pmo_control')) : project_issues_path(@project, data_quality_issue_filter_params(nil, row[:scope])) %>
            <%= link_to data_quality_path,
                  class: 'tj-workload-bar-row tj-data-quality-bar-row',
                  title: "Open exact ticket list: #{row[:label]}" do %>
              <span class="tj-workload-bar-label"><%= h(row[:label]) %></span>
              <span class="tj-workload-bar-track">
                <span class="tj-workload-bar-fill" style="width:<%= width %>%"></span>
              </span>
              <span class="tj-workload-bar-meta">
                <strong><%= row[:count] %></strong>
                <span><%= number_to_percentage(row[:percent] * 100, precision: 1) %></span>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="tj-detail-grid">
      <div class="tj-card">
        <div class="tj-card-title">Owner Workload Watch</div>
        <% if report[:owner_attention_rows].empty? %>
          <div class="tj-flow-empty-note">No owner workload data for the current filters.</div>
        <% else %>
          <table class="tj-health-table">
            <tbody>
              <% report[:owner_attention_rows].each do |row| %>
                <tr>
                  <td class="tj-health-label"><%= link_to h(row[:owner]), project_issues_path(@project, owner_workload_issue_filter_params(row, :total_open)), class: 'tj-drilldown-link' %></td>
                  <td class="tj-health-count"><%= owner_workload_count_link(row, :total_open, row[:total_open]) %></td>
                  <td class="tj-health-percent">Overdue <%= owner_workload_count_link(row, :overdue, row[:overdue]) %> / Stopped <%= owner_workload_count_link(row, :stopped, row[:stopped]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>

      <div class="tj-card">
        <div class="tj-card-title">Priority Ticket Watch</div>
        <% if report[:priority_rows].empty? %>
          <div class="tj-flow-empty-note">No open Urgent or Immediate tickets for the current filters.</div>
        <% else %>
          <table class="tj-health-table">
            <tbody>
              <% report[:priority_rows].each do |row| %>
                <tr>
                  <td class="tj-health-label"><%= link_to "##{row[:issue_id]} #{row[:subject]}", issue_path(row[:issue]), class: 'tj-subject-link', title: row[:subject] %></td>
                  <td class="tj-health-count"><%= row[:age_days] %>d</td>
                  <td class="tj-health-percent"><%= h(row[:owner]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>

    <div class="tj-detail-grid">
      <div class="tj-card">
        <div class="tj-card-title">Release Watch</div>
        <% if report[:release_attention_rows].empty? %>
          <div class="tj-flow-empty-note">No red or amber releases for the current project scope.</div>
        <% else %>
          <table class="tj-health-table">
            <tbody>
              <% report[:release_attention_rows].each do |row| %>
                <tr>
                  <td class="tj-health-label"><%= h(row[:name]) %></td>
                  <td class="tj-health-count"><%= release_readiness_count_link(row, :open, row[:open]) %></td>
                  <td class="tj-health-percent"><%= row[:due_date].present? ? format_date(row[:due_date]) : '-' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>

      <div class="tj-card">
        <div class="tj-card-title">Bug Health</div>
        <div class="tj-flow-empty-note">
          Uses the Bug Analysis period to summarize Bug tracker tickets found, closed, and still remaining in the selected project scope.
        </div>
        <table class="tj-health-table">
          <tbody>
            <tr>
              <td class="tj-health-label">Period</td>
              <td class="tj-health-count" colspan="2"><%= format_date(report[:bug_period].first) %> - <%= format_date(report[:bug_period].last) %></td>
            </tr>
            <tr>
              <td class="tj-health-label">Found</td>
              <td class="tj-health-count"><%= report[:bug][:found] %></td>
              <td class="tj-health-percent">Closed <%= report[:bug][:closed] %></td>
            </tr>
            <tr>
              <td class="tj-health-label">Remaining</td>
              <td class="tj-health-count <%= report[:bug][:remaining].to_i.positive? ? 'tj-counter-active' : '' %>"><%= report[:bug][:remaining] %></td>
              <td class="tj-health-percent">Impact <%= report[:bug][:impact_sum] %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
