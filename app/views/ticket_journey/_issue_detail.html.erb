<%
  duration_fields = duration_fields_for_family(@tracker_family_key)
  supplemental_fields = supplemental_duration_fields_for_family(@tracker_family_key)
  calendar_total = calendar_total_field(@tracker_family_key)
  counters = counter_definitions(@tracker_family_key)
  max_val = (duration_fields + supplemental_fields + [calendar_total]).map { |field| @duration_data[field[:key]].to_f }.max
  max_val = 1 if max_val.to_f <= 0
  bar_colors = {
    D0: '#4fc3f7', D0aug: '#8b5e3c',
    D1: '#4fc3f7', D1aug: '#e07b39',
    D2: '#f5c518', D2aug: '#e07b39',
    D3: '#4caf7d', D3aug: '#e07b39',
    D4: '#2e8b6d', D4aug: '#e07b39',
    D5: '#9c7ff0', D5aug: '#e07b39',
    D6: '#7c6ee6', D6aug: '#e07b39',
    D7: '#f28e2b', D8: '#d95f5f', D9: '#8b5e3c',
    DC1: '#4fc3f7', DC2: '#e07b39', DC3: '#f5c518', DC4: '#4caf7d', DC5: '#9c7ff0', DC6: '#8bc34a', DC7: '#00acc1',
    DT0: '#4fc3f7', DT1: '#4fc3f7', DT1aug: '#e07b39', DT2: '#f5c518', DT2aug: '#e07b39', DT3: '#4caf7d', DT3aug: '#e07b39', DT4: '#9c7ff0', DT4aug: '#e07b39',
    DP0: '#4fc3f7', DP1: '#4fc3f7', DP2: '#4caf7d', DP3: '#9c7ff0',
    ON_HOLD: '#7b8794', PENDING: '#94a3b8'
  }
  total_color = '#4caf7d'
  calendar_total_color = '#2e7d5b'
%>

<div class="tj-page-header">
  <div class="tj-page-header-left">
    <div>
      <h2><%= link_to "##{@issue.id}", issue_path(@issue), class: 'tj-issue-link' %> &mdash; <%= h(@issue.subject) %></h2>
      <p class="tj-page-sub">
        Family: <strong><%= TicketJourneyController::TRACKER_FAMILY_DEFINITIONS[@tracker_family_key][:label] %></strong> &nbsp;|&nbsp;
        Status: <strong><%= @issue.status.name %></strong> &nbsp;|&nbsp;
        Assignee: <strong><%= @issue.assigned_to&.name || '-' %></strong> &nbsp;|&nbsp;
        Created: <strong><%= format_date(@issue.created_on) %></strong>
      </p>
    </div>
  </div>
</div>

<div class="tj-summary-strip">
  <div class="tj-summary-card">
    <div class="tj-sc-label">Cycle Total</div>
    <div class="tj-sc-value tj-sc-green"><%= format_hours(@duration_data[:TOTAL]) %></div>
  </div>
  <div class="tj-summary-card">
    <div class="tj-sc-label">Status Changes</div>
    <div class="tj-sc-value tj-sc-blue"><%= @status_change_count %></div>
  </div>
  <% counters.each do |counter| %>
    <div class="tj-summary-card">
      <div class="tj-sc-label"><%= counter[:code] %></div>
      <div class="tj-sc-value <%= @duration_data[counter[:key]].to_i > 0 ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= @duration_data[counter[:key]] %></div>
    </div>
  <% end %>
</div>

<% if counters.any? %>
  <div class="tj-legend-strip tj-legend-strip-section">
    <% counters.each do |counter| %>
      <% total = @duration_data[counter[:key]].to_i %>
      <div class="tj-legend-item" title="<%= counter[:title] %>">
        <div class="tj-legend-code"><%= counter[:code] %></div>
        <div class="tj-legend-copy">
          <div class="tj-legend-title"><%= counter[:title] %></div>
          <div class="tj-legend-sub"><%= counter[:transition] %></div>
        </div>
        <div class="tj-legend-total <%= total > 0 ? 'is-active' : '' %>"><%= total %></div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="tj-detail-grid">
  <div class="tj-card">
    <div class="tj-card-title">Duration Breakdown</div>
    <div class="tj-bars">
      <% duration_fields.each do |field| %>
        <% value = @duration_data[field[:key]].to_f %>
        <% pct = (value / max_val * 100).round %>
        <% share_base = field[:counted_in_total] == false ? @duration_data[:CALENDAR_TOTAL] : @duration_data[:TOTAL] %>
        <% share_label = field[:counted_in_total] == false ? 'Share of Calendar Total' : 'Share of Cycle Total' %>
        <% tooltip = [field[:desc], "#{share_label}: #{format_percentage(value, share_base)}"].join("\n") %>
        <div class="tj-bar-row">
          <div class="tj-bar-label"><%= field[:desc] %> <span>(<%= field[:label] %>)</span></div>
          <div class="tj-bar-track" title="<%= tooltip %>">
            <div class="tj-bar-fill <%= 'is-zero' if value <= 0 %>" style="width:<%= pct %>%;background:<%= bar_colors[field[:key]] || '#4fc3f7' %>">
              <% if pct > 12 %><span><%= format_hours(value) %></span><% end %>
            </div>
          </div>
          <div class="tj-bar-val"><%= format_hours(value) %></div>
        </div>
      <% end %>
      <% total_value = @duration_data[:TOTAL].to_f %>
      <% total_width_pct = total_value > 0 ? 100 : 0 %>
      <% total_tooltip = ["Cycle total", "Share of Calendar Total: #{format_percentage(total_value, @duration_data[:CALENDAR_TOTAL])}"].join("\n") %>
      <div class="tj-bar-row tj-bar-total">
        <div class="tj-bar-label"><strong>Cycle total</strong> <span>(Cycle Total)</span></div>
        <div class="tj-bar-track" title="<%= total_tooltip %>">
          <div class="tj-bar-fill <%= 'is-zero' if total_width_pct <= 0 %>" style="width:<%= total_width_pct %>%;background:<%= total_color %>">
            <% if total_value > 0 %><span><%= format_hours(total_value) %></span><% end %>
          </div>
        </div>
        <div class="tj-bar-val"><strong><%= format_hours(total_value) %></strong></div>
      </div>
      <% supplemental_fields.each do |field| %>
        <% value = @duration_data[field[:key]].to_f %>
        <% pct = (value / max_val * 100).round %>
        <% tooltip = [field[:desc], "Share of Calendar Total: #{format_percentage(value, @duration_data[:CALENDAR_TOTAL])}"].join("\n") %>
        <div class="tj-bar-row">
          <div class="tj-bar-label"><%= field[:desc] %> <span>(<%= field[:label] %>)</span></div>
          <div class="tj-bar-track" title="<%= tooltip %>">
            <div class="tj-bar-fill <%= 'is-zero' if value <= 0 %>" style="width:<%= pct %>%;background:<%= bar_colors[field[:key]] || '#7b8794' %>">
              <% if pct > 12 %><span><%= format_hours(value) %></span><% end %>
            </div>
          </div>
          <div class="tj-bar-val"><%= format_hours(value) %></div>
        </div>
      <% end %>
      <% calendar_total_value = @duration_data[:CALENDAR_TOTAL].to_f %>
      <% calendar_total_pct = (calendar_total_value / max_val * 100).round %>
      <% calendar_total_tooltip = calendar_total[:desc] %>
      <div class="tj-bar-row tj-bar-total">
        <div class="tj-bar-label"><strong><%= calendar_total[:desc] %></strong> <span>(<%= calendar_total[:label] %>)</span></div>
        <div class="tj-bar-track" title="<%= calendar_total_tooltip %>">
          <div class="tj-bar-fill <%= 'is-zero' if calendar_total_value <= 0 %>" style="width:<%= calendar_total_pct %>%;background:<%= calendar_total_color %>">
            <% if calendar_total_value > 0 %><span><%= format_hours(calendar_total_value) %></span><% end %>
          </div>
        </div>
        <div class="tj-bar-val"><strong><%= format_hours(calendar_total_value) %></strong></div>
      </div>
    </div>
  </div>

  <% if counters.any? %>
    <div class="tj-card">
      <div class="tj-card-title">Return Counters</div>
      <div class="tj-counters-grid tj-counters-grid-dynamic">
        <% counters.each do |counter| %>
          <% count = @duration_data[counter[:key]].to_i %>
          <div class="tj-counter-item <%= count > 0 ? 'tj-counter-hit' : '' %>">
            <div class="tj-counter-num"><%= count %></div>
            <div class="tj-counter-label"><%= counter[:code] %> &mdash; <%= counter[:title] %></div>
            <div class="tj-counter-sub"><%= counter[:transition] %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<div class="tj-card tj-card-full tj-section-card tj-history-card" data-tj-section>
  <div class="tj-section-header">
    <div>
      <h3 class="tj-section-title">History Summary</h3>
      <div class="tj-group-summary">
        <span>Status groups: <strong><%= @status_time_summary.size %></strong></span>
        <span>Assignment groups: <strong><%= @assignment_time_summary.size %></strong></span>
        <span>Summary Total: <strong><%= format_hours(@history_summary_total) %></strong></span>
        <span>Window: <strong><%= @history_summary_until.present? ? 'Before terminal status' : 'Current journey' %></strong></span>
        <span>Assignment: <strong>Active time only</strong></span>
      </div>
    </div>
    <button type="button" class="tj-section-toggle" data-tj-section-toggle aria-expanded="true">
      <span class="tj-section-toggle-icon" aria-hidden="true">-</span>
      <span data-tj-section-toggle-label>Collapse</span>
    </button>
  </div>

  <div class="tj-history-summary-grid" data-tj-section-body>
    <div class="tj-history-panel">
      <div class="tj-history-panel-title">Status Time Summary</div>
      <% if @status_time_summary.any? %>
        <div class="tj-history-chart-list">
          <% @status_time_summary.each_with_index do |row, index| %>
            <% color = index.zero? ? '#1a6db5' : '#4fc3f7' %>
            <div class="tj-history-row">
              <div class="tj-history-pie" style="background: conic-gradient(<%= color %> 0 <%= row[:percentage] %>%, #eef0f5 <%= row[:percentage] %>% 100%);"></div>
              <div class="tj-history-main">
                <div class="tj-history-label"><%= h(row[:label]) %></div>
                <div class="tj-history-meta">
                  <span><%= row[:count] %> times</span>
                  <span><%= format_hours(row[:hours]) %></span>
                  <span><%= row[:percentage] %>%</span>
                </div>
                <div class="tj-history-bar-track">
                  <div class="tj-history-bar-fill" style="width:<%= row[:percentage] %>%;background:<%= color %>"></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="tj-history-empty">No status history found.</div>
      <% end %>
    </div>

    <div class="tj-history-panel">
      <div class="tj-history-panel-title">Assignment Time Summary</div>
      <% if @assignment_time_summary.any? %>
        <div class="tj-history-chart-list">
          <% @assignment_time_summary.each_with_index do |row, index| %>
            <% color = index.zero? ? '#2e7d46' : '#8bc34a' %>
            <div class="tj-history-row">
              <div class="tj-history-pie" style="background: conic-gradient(<%= color %> 0 <%= row[:percentage] %>%, #eef0f5 <%= row[:percentage] %>% 100%);"></div>
              <div class="tj-history-main">
                <div class="tj-history-label"><%= h(row[:label]) %></div>
                <div class="tj-history-meta">
                  <span><%= row[:count] %> times</span>
                  <span><%= format_hours(row[:hours]) %></span>
                  <span><%= row[:percentage] %>%</span>
                </div>
                <div class="tj-history-bar-track">
                  <div class="tj-history-bar-fill" style="width:<%= row[:percentage] %>%;background:<%= color %>"></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="tj-history-empty">No assignment history found.</div>
      <% end %>
    </div>
  </div>
</div>

<div class="tj-card tj-card-full tj-history-detail-heading">
  <h3 class="tj-section-title">History Detail</h3>
  <div class="tj-group-summary">
    <span>Status changes: <strong><%= @status_change_count %></strong></span>
    <span>Assignment changes: <strong><%= [@assignment_periods.size - 1, 0].max %></strong></span>
  </div>
</div>

<div class="tj-card tj-card-full tj-section-card tj-status-detail-card is-collapsed" data-tj-section>
  <div class="tj-section-header">
    <div>
      <h3 class="tj-section-title">Status Time Detail</h3>
      <div class="tj-group-summary">
        <span>Changes: <strong><%= @status_change_count %></strong></span>
        <span>Current: <strong><%= h(@issue.status.name) %></strong></span>
      </div>
    </div>
    <button type="button" class="tj-section-toggle" data-tj-section-toggle aria-expanded="false">
      <span class="tj-section-toggle-icon" aria-hidden="true">+</span>
      <span data-tj-section-toggle-label>Expand</span>
    </button>
  </div>

  <div class="tj-timeline" data-tj-section-body>
    <% @transitions.each_with_index do |transition, index| %>
      <%
        is_return = transition[:to_status].to_s.downcase.include?('return')
        is_done = ['done', 'closed'].include?(transition[:to_status].to_s.downcase)
        dot_class = is_return ? 'tj-tl-dot-return' : (is_done ? 'tj-tl-dot-done' : 'tj-tl-dot-forward')
        next_transition = @transitions[index + 1]
        period_h = next_transition ? (next_transition[:changed_at] - transition[:changed_at]) / 3600.0 : nil
      %>
      <div class="tj-tl-item <%= is_return ? 'tj-tl-return' : '' %>">
        <div class="tj-tl-dot <%= dot_class %>"></div>
        <div class="tj-tl-content">
          <div class="tj-tl-header">
            <% if transition[:from_status] %>
              <span class="tj-tl-from"><%= h(transition[:from_status]) %></span>
              <span class="tj-tl-arrow">-&gt;</span>
            <% end %>
            <span class="tj-tl-to <%= is_return ? 'tj-tl-to-return' : '' %>"><%= h(transition[:to_status]) %></span>
            <span class="tj-tl-time"><%= format_time(transition[:changed_at]) %></span>
          </div>
          <div class="tj-tl-meta">
            by <strong><%= h(transition[:changed_by_name].presence || transition[:changed_by]) %></strong>
            <% if period_h %>
              &nbsp;|&nbsp; spent: <span class="tj-tl-spent"><%= format_hours(period_h) %></span>
            <% end %>
          </div>
          <% if transition[:notes].present? %>
            <div class="tj-tl-notes">
              <div class="tj-tl-notes-label">Note</div>
              <%= simple_format(h(transition[:notes]), {}, wrapper_tag: 'div') %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="tj-card tj-card-full tj-section-card tj-assignment-timeline-card is-collapsed" data-tj-section>
  <div class="tj-section-header">
    <div>
      <h3 class="tj-section-title">Assignment Time Detail</h3>
      <div class="tj-group-summary">
        <span>Changes: <strong><%= [@assignment_periods.size - 1, 0].max %></strong></span>
        <span>Current: <strong><%= h(@issue.assigned_to&.name || 'Unassigned') %></strong></span>
      </div>
    </div>
    <button type="button" class="tj-section-toggle" data-tj-section-toggle aria-expanded="false">
      <span class="tj-section-toggle-icon" aria-hidden="true">+</span>
      <span data-tj-section-toggle-label>Expand</span>
    </button>
  </div>

  <div class="tj-table-wrap tj-assignment-timeline-wrap" data-tj-section-body>
    <table class="tj-table tj-assignment-timeline-table">
      <thead>
        <tr>
          <th>Assigned To</th>
          <th>From</th>
          <th>To</th>
          <th>Duration</th>
          <th>Changed By</th>
        </tr>
      </thead>
      <tbody>
        <% @assignment_periods.each do |period| %>
          <% period_duration = period[:enter] && period[:exit] ? ((period[:exit] - period[:enter]) / 3600.0) : 0.0 %>
          <tr>
            <td><strong><%= h(period[:assignee]) %></strong></td>
            <td><%= format_time(period[:enter]) %></td>
            <td><%= period[:changed_by] == 'Current' ? 'Now' : format_time(period[:exit]) %></td>
            <td><%= format_hours(period_duration) %></td>
            <td><%= h(period[:changed_by] || '-') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-tj-section-toggle]').forEach(function (button) {
      if (button.dataset.tjToggleBound === 'true') return;
      button.dataset.tjToggleBound = 'true';

      button.addEventListener('click', function () {
        var section = button.closest('[data-tj-section]');
        var expanded = button.getAttribute('aria-expanded') !== 'false';
        var nextExpanded = !expanded;
        var label = button.querySelector('[data-tj-section-toggle-label]');
        var icon = button.querySelector('.tj-section-toggle-icon');

        button.setAttribute('aria-expanded', String(nextExpanded));
        section.classList.toggle('is-collapsed', !nextExpanded);
        if (label) label.textContent = nextExpanded ? 'Collapse' : 'Expand';
        if (icon) icon.textContent = nextExpanded ? '-' : '+';
      });
    });
  });
</script>
