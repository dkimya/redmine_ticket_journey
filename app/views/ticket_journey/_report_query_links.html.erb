<% saved_queries = ticket_journey_saved_issue_queries %>
<% active_saved_query = saved_queries.find { |saved_query| @query&.id == saved_query.id } %>

<% if saved_queries.any? %>
  <details class="tj-report-query-links">
    <summary class="tj-report-query-summary">
      <span>Saved Report Queries</span>
      <% if active_saved_query %>
        <strong><%= active_saved_query.name %></strong>
      <% else %>
        <em><%= saved_queries.size %> available</em>
      <% end %>
    </summary>
    <div class="tj-report-query-row">
      <% saved_queries.each do |saved_query| %>
        <% report_query_path = ticket_journey_report_query_path(saved_query) %>
        <% next if report_query_path.blank? %>
        <%= link_to saved_query.name,
              report_query_path,
              class: "tj-report-query-link #{@query&.id == saved_query.id ? 'is-active' : ''}" %>
      <% end %>
    </div>
  </details>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var backUrl = window.location.pathname + window.location.search;
    document.querySelectorAll('a[href*="/queries/new"]').forEach(function (link) {
      try {
        var url = new URL(link.href, window.location.origin);
        url.searchParams.set('back_url', backUrl);
        link.href = url.toString();
      } catch (error) {
        return;
      }
    });
  });
</script>
