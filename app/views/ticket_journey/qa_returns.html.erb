<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2>QA &amp; Returns</h2>
        <p class="tj-page-sub">Return behavior, rework effort, and first-pass quality &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :qa_returns } %>

  <%= form_tag(ticket_journey_qa_returns_path(@project), method: :get, id: 'query_form') do %>
    <%= render partial: 'queries/query_form' %>
  <% end %>

  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% else %>
    <%
      totals = @qa_returns_report[:totals]
      drilldowns = @qa_returns_report[:drilldowns]
      counter_rows = @qa_returns_report[:counter_rows]
      rework_rows = @qa_returns_report[:rework_rows]
      reason_rows = @qa_returns_report[:reason_rows]
      owner_rows = @qa_returns_report[:owner_rows]
      returned_ticket_rows = @qa_returns_report[:returned_ticket_rows]
      max_rework = [rework_rows.map { |row| row[:hours].to_f }.max.to_f, 1.0].max
      max_reason = [reason_rows.map { |row| row[:count].to_i }.max.to_i, 1].max
      max_ticket_returns = [returned_ticket_rows.map { |row| row[:total_returns].to_i }.max.to_i, 1].max
    %>

    <div class="tj-summary-strip">
      <%= duration_report_drilldown_block(@query, drilldowns[:done_tickets], class: 'tj-summary-card tj-summary-link', title: 'Open done tickets in Duration Report') do %>
        <div class="tj-sc-label">Done Tickets</div>
        <div class="tj-sc-value tj-sc-blue"><%= totals[:done_tickets] %></div>
      <% end %>
      <%= duration_report_drilldown_block(@query, drilldowns[:done_tickets_with_returns], class: 'tj-summary-card tj-summary-link', title: 'Open done tickets with returns in Duration Report') do %>
        <div class="tj-sc-label">Tickets With Returns</div>
        <div class="tj-sc-value <%= totals[:done_tickets_with_returns].positive? ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= totals[:done_tickets_with_returns] %></div>
      <% end %>
      <%= duration_report_drilldown_block(@query, drilldowns[:done_tickets_without_returns], class: 'tj-summary-card tj-summary-link', title: 'Open first-pass done tickets in Duration Report') do %>
        <div class="tj-sc-label">First-Time Pass</div>
        <div class="tj-sc-value <%= totals[:first_pass_rate] >= 0.8 ? 'tj-sc-green' : 'tj-sc-orange' %>"><%= number_to_percentage(totals[:first_pass_rate] * 100, precision: 1) %></div>
      <% end %>
      <%= duration_report_drilldown_block(@query, drilldowns[:done_tickets_with_returns], class: 'tj-summary-card tj-summary-link', title: 'Open done tickets with returns in Duration Report') do %>
        <div class="tj-sc-label">Return Rate</div>
        <div class="tj-sc-value <%= totals[:return_rate].positive? ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= number_to_percentage(totals[:return_rate] * 100, precision: 1) %></div>
      <% end %>
      <%= duration_report_drilldown_block(@query, drilldowns[:tickets_with_returns], class: 'tj-summary-card tj-summary-link', title: 'Open all tickets with returns in Duration Report') do %>
        <div class="tj-sc-label">Total Returns</div>
        <div class="tj-sc-value <%= totals[:return_events].positive? ? 'tj-sc-red' : 'tj-sc-dim' %>"><%= totals[:return_events] %></div>
      <% end %>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Rework Time</div>
        <div class="tj-sc-value <%= totals[:total_rework_hours].positive? ? 'tj-sc-orange' : 'tj-sc-dim' %>"><%= format_hours(totals[:total_rework_hours]) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Rework Ratio</div>
        <div class="tj-sc-value <%= totals[:rework_ratio].positive? ? 'tj-sc-orange' : 'tj-sc-dim' %>"><%= number_to_percentage(totals[:rework_ratio] * 100, precision: 1) %></div>
      </div>
    </div>

    <% if totals[:issues].zero? %>
      <div class="tj-empty">
        <div class="tj-empty-icon">QA</div>
        <h3>No QA return data found</h3>
        <p>Try adjusting the Redmine query filters above.</p>
      </div>
    <% else %>
      <div class="tj-legend-strip tj-legend-strip-section">
        <% counter_rows.each do |counter| %>
          <%= duration_report_drilldown_block(@query, counter[:issue_ids], class: 'tj-legend-item tj-legend-link', title: "Open #{counter[:code]} tickets in Duration Report") do %>
            <div class="tj-legend-code"><%= counter[:code] %></div>
            <div class="tj-legend-copy">
              <div class="tj-legend-title"><%= h(counter[:title]) %></div>
              <div class="tj-legend-sub"><%= h(counter[:transition]) %></div>
            </div>
            <div class="tj-legend-total <%= counter[:count].positive? ? 'is-active' : '' %>"><%= counter[:count] %></div>
          <% end %>
        <% end %>
      </div>

      <div class="tj-health-grid">
        <div class="tj-card tj-health-card">
          <div class="tj-card-title">Done Tickets Analysis</div>
          <table class="tj-health-table">
            <tbody>
              <tr>
                <td class="tj-health-label">Tickets with Min 1 Return</td>
                <td class="tj-health-count"><%= duration_report_drilldown_link(@query, drilldowns[:done_tickets_with_returns], totals[:done_tickets_with_returns].zero? ? '-' : totals[:done_tickets_with_returns], title: 'Open tickets with returns') %></td>
                <td class="tj-health-percent"><%= number_to_percentage(totals[:return_rate] * 100, precision: 1) %></td>
              </tr>
              <tr>
                <td class="tj-health-label">Tickets with No Return</td>
                <td class="tj-health-count"><%= duration_report_drilldown_link(@query, drilldowns[:done_tickets_without_returns], totals[:done_tickets_without_returns].zero? ? '-' : totals[:done_tickets_without_returns], title: 'Open tickets with no return') %></td>
                <td class="tj-health-percent"><%= number_to_percentage(totals[:first_pass_rate] * 100, precision: 1) %></td>
              </tr>
              <tr>
                <td class="tj-health-label">Total Done Tickets</td>
                <td class="tj-health-count"><%= duration_report_drilldown_link(@query, drilldowns[:done_tickets], totals[:done_tickets], title: 'Open done tickets') %></td>
                <td class="tj-health-percent">100%</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="tj-card tj-health-card">
          <div class="tj-card-title">Work &amp; Rework Ratio</div>
          <table class="tj-health-table">
            <tbody>
              <tr>
                <td class="tj-health-label">Total Work Duration</td>
                <td class="tj-health-count"><%= format_hours(totals[:total_work_hours]) %></td>
                <td class="tj-health-percent"><%= number_to_percentage((1.0 - totals[:rework_ratio]) * 100, precision: 1) %></td>
              </tr>
              <tr>
                <td class="tj-health-label">Total Rework Duration</td>
                <td class="tj-health-count"><%= format_hours(totals[:total_rework_hours]) %></td>
                <td class="tj-health-percent"><%= number_to_percentage(totals[:rework_ratio] * 100, precision: 1) %></td>
              </tr>
              <tr>
                <td class="tj-health-label">Total Durations</td>
                <td class="tj-health-count"><%= format_hours(totals[:total_duration_hours]) %></td>
                <td class="tj-health-percent">100%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Returned Tickets Analysis - Duration</div>
        <div class="tj-workload-bars">
          <% rework_rows.each do |row| %>
            <% width = (row[:hours].to_f / max_rework * 100).round(1) %>
            <div class="tj-workload-bar-row">
              <div class="tj-workload-bar-label">
                <strong><%= duration_report_drilldown_link(@query, row[:issue_ids], h(row[:label]), title: "Open #{row[:label]} tickets") %></strong>
                <span><%= h(row[:description]) %></span>
              </div>
              <div class="tj-workload-bar-track">
                <div class="tj-workload-bar-fill" style="width:<%= width %>%"></div>
              </div>
              <div class="tj-workload-bar-meta"><strong><%= format_hours(row[:hours]) %></strong></div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Return Reason Analysis</div>
        <% if reason_rows.empty? %>
          <div class="tj-flow-empty-note">No returned tickets found in the current filtered result.</div>
        <% else %>
          <div class="tj-bug-bars">
            <% reason_rows.each do |row| %>
              <% width = (row[:count].to_f / max_reason * 100).round(1) %>
              <div class="tj-bug-bar-row">
                <div class="tj-bug-bar-label"><%= duration_report_drilldown_link(@query, row[:issue_ids], h(row[:reason]), title: "Open #{row[:reason]} tickets") %></div>
                <div class="tj-bug-bar-track">
                  <div class="tj-bug-bar-fill" style="width:<%= width %>%"></div>
                </div>
                <div class="tj-bug-bar-count"><%= row[:count] %> <span><%= number_to_percentage(row[:percent] * 100, precision: 0) %></span></div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="tj-card tj-card-full">
        <div class="tj-card-title">QA Returns by Ticket Owner</div>
        <% if owner_rows.empty? %>
          <div class="tj-flow-empty-note">No returned tickets found by ticket owner in the current filtered result.</div>
        <% else %>
          <div class="tj-table-wrap">
            <table class="tj-table">
              <thead>
                <tr>
                  <th class="tj-th-title">Ticket Owner</th>
                  <th class="tj-th-native">Done Tickets</th>
                  <th class="tj-th-native">Returned Tickets</th>
                  <th class="tj-th-native">Return Rate</th>
                  <th class="tj-th-counter">R1</th>
                  <th class="tj-th-counter">R2</th>
                  <th class="tj-th-counter">R3</th>
                  <th class="tj-th-counter">R4</th>
                  <th class="tj-th-total">Total Returns</th>
                  <th class="tj-th-native">Rework Time</th>
                  <th class="tj-th-title">Top Reason</th>
                </tr>
              </thead>
              <tbody>
                <% owner_rows.each do |row| %>
                  <tr class="tj-row">
                    <td class="tj-td-title"><%= duration_report_drilldown_link(@query, row[:issue_ids], h(row[:owner]), title: "Open returned tickets for #{row[:owner]}") %></td>
                    <td class="tj-td-native"><%= row[:done_tickets].positive? ? row[:done_tickets] : '-' %></td>
                    <td class="tj-td-native"><%= row[:returned_tickets].positive? ? duration_report_drilldown_link(@query, row[:issue_ids], row[:returned_tickets], title: "Open returned tickets for #{row[:owner]}") : '-' %></td>
                    <td class="tj-td-native"><%= number_to_percentage(row[:return_rate] * 100, precision: 1) %></td>
                    <td class="<%= counter_css_class(row[:c1]) %>"><%= row[:c1].positive? ? row[:c1] : '-' %></td>
                    <td class="<%= counter_css_class(row[:c2]) %>"><%= row[:c2].positive? ? row[:c2] : '-' %></td>
                    <td class="<%= counter_css_class(row[:c3]) %>"><%= row[:c3].positive? ? row[:c3] : '-' %></td>
                    <td class="<%= counter_css_class(row[:c4]) %>"><%= row[:c4].positive? ? row[:c4] : '-' %></td>
                    <td class="tj-td-total"><%= row[:return_events] %></td>
                    <td class="tj-td-native"><%= format_hours(row[:rework_hours]) %></td>
                    <td class="tj-td-title"><%= h(row[:top_reason]) %><% if row[:top_reason_count].positive? %> (<%= row[:top_reason_count] %>)<% end %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>

      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Top Returned Tickets</div>
        <% if returned_ticket_rows.empty? %>
          <div class="tj-flow-empty-note">No returned tickets found in the current filtered result.</div>
        <% else %>
          <div class="tj-bug-bars">
            <% returned_ticket_rows.first(10).each do |row| %>
              <% width = (row[:total_returns].to_f / max_ticket_returns * 100).round(1) %>
              <div class="tj-bug-bar-row">
                <div class="tj-bug-bar-label"><%= link_to "##{row[:issue_id]} - #{row[:subject]}", ticket_journey_path(@project, issue_detail_params(@query, row[:issue])), class: 'tj-drilldown-link', title: 'Open issue detail' %></div>
                <div class="tj-bug-bar-track">
                  <div class="tj-bug-bar-fill" style="width:<%= width %>%"></div>
                </div>
                <div class="tj-bug-bar-count"><%= row[:total_returns] %> <span><%= format_hours(row[:rework_hours]) %></span></div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="tj-card tj-card-full">
        <div class="tj-card-title">Returned Ticket Detail</div>
        <% if returned_ticket_rows.empty? %>
          <div class="tj-flow-empty-note">No returned tickets found in the current filtered result.</div>
        <% else %>
          <div class="tj-table-wrap">
            <table class="tj-table">
              <thead>
                <tr>
                  <th class="tj-th-issue">Issue</th>
                  <th class="tj-th-title">Subject</th>
                  <th class="tj-th-native">Tracker</th>
                  <th class="tj-th-native">Status</th>
                  <th class="tj-th-native">Ticket Owner</th>
                  <th class="tj-th-native">Return Reason</th>
                  <th class="tj-th-counter">R1</th>
                  <th class="tj-th-counter">R2</th>
                  <th class="tj-th-counter">R3</th>
                  <th class="tj-th-counter">R4</th>
                  <th class="tj-th-total">Total Returns</th>
                  <th class="tj-th-native">Rework Time</th>
                  <th class="tj-th-total">Cycle Time</th>
                </tr>
              </thead>
              <tbody>
                <% returned_ticket_rows.first(150).each do |row| %>
                  <tr class="tj-row">
                    <td class="tj-td-issue"><%= link_to "##{row[:issue_id]}", issue_path(row[:issue]), class: 'tj-issue-link' %></td>
                    <td class="tj-td-title" title="<%= h(row[:subject]) %>"><%= link_to h(row[:subject]), ticket_journey_path(@project, issue_detail_params(@query, row[:issue])), class: 'tj-subject-link' %></td>
                    <td class="tj-td-native"><%= h(row[:tracker]) %></td>
                    <td class="tj-td-native"><span class="tj-status-badge"><%= h(row[:status]) %></span></td>
                    <td class="tj-td-native"><%= h(row[:owner]) %></td>
                    <td class="tj-td-title"><%= h(row[:return_reason]) %></td>
                    <td class="<%= counter_css_class(row[:c1]) %>"><%= row[:c1].positive? ? row[:c1] : '-' %></td>
                    <td class="<%= counter_css_class(row[:c2]) %>"><%= row[:c2].positive? ? row[:c2] : '-' %></td>
                    <td class="<%= counter_css_class(row[:c3]) %>"><%= row[:c3].positive? ? row[:c3] : '-' %></td>
                    <td class="<%= counter_css_class(row[:c4]) %>"><%= row[:c4].positive? ? row[:c4] : '-' %></td>
                    <td class="tj-td-total"><%= row[:total_returns] %></td>
                    <td class="tj-td-native"><%= format_hours(row[:rework_hours]) %></td>
                    <td class="tj-td-total"><%= format_hours(row[:cycle_hours]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
