<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">
  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2><%= ticket_journey_header_context_tag(:executive_dashboards) %>Executive Overview</h2>
        <p class="tj-page-sub">CEO-focused throughput, quality, rework, and debt snapshot &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :executive_overview } %>

  <%= form_tag(ticket_journey_executive_overview_path(@project), method: :get, id: 'query_form') do %>
    <%= hidden_field_tag :support_section, params[:support_section] if params[:support_section].present? %>
    <%= render partial: 'queries/query_form' %>

    <div class="tj-filter-bar tj-owner-filter-bar">
      <div class="tj-filter-form">
        <div class="tj-filter-group">
          <label for="exec_period">Executive Period</label>
          <%= select_tag :exec_period,
                options_for_select([['Last Month', 'last_month'], ['Last 3 Months', 'last_3_months'], ['Custom Period', 'custom']], @executive_period_key),
                class: 'tj-input' %>
        </div>
        <div class="tj-filter-group">
          <label for="exec_start_date">Period Start</label>
          <%= date_field_tag :exec_start_date, @executive_start_date, class: 'tj-input' %>
        </div>
        <div class="tj-filter-group">
          <label for="exec_end_date">Period End</label>
          <%= date_field_tag :exec_end_date, @executive_end_date, class: 'tj-input' %>
        </div>
        <div class="tj-filter-group tj-flow-filter-note">
          <span>Redmine filters choose the ticket population. The executive period is used for completed tickets, bug movement, and rework totals.</span>
        </div>
        <div class="tj-filter-group tj-filter-actions">
          <%= submit_tag 'Apply', class: 'tj-btn tj-btn-primary' %>
        </div>
      </div>
    </div>
  <% end %>
  <%= render partial: 'executive_period_customizer' %>

  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% else %>
    <% report = @executive_overview_report %>
    <% kpis = report[:kpis] %>
    <div class="tj-summary-strip">
      <div class="tj-summary-card">
        <div class="tj-sc-label">Executive Period</div>
        <div class="tj-sc-value tj-sc-accent"><%= format_date(report[:period_start]) %> - <%= format_date(report[:period_end]) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Number of tickets matching the current Redmine filters that were completed during the selected executive period.">Whole Team Throughput</div>
        <div class="tj-sc-value tj-sc-blue"><%= duration_report_drilldown_link(@query, report[:links][:throughput], kpis[:throughput], title: 'Filtered tickets completed in the executive period') %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Formula: bugs resolved during the executive period / bugs created during the executive period.">Bug Burn-down Rate</div>
        <div class="tj-sc-value <%= kpis[:bug_burndown_rate].to_f >= 1.0 ? 'tj-sc-green' : 'tj-sc-orange' %>">
          <%= link_to number_to_percentage(kpis[:bug_burndown_rate] * 100, precision: 1),
                ticket_journey_bug_analysis_path(@project, bug_analysis_params(@query).merge('bug_start_date' => report[:period_start], 'bug_end_date' => report[:period_end], 'support_section' => 'bug_analysis')),
                class: 'tj-drilldown-link',
                title: 'Open Bug Analysis for this period' %>
        </div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Average active journey duration for tickets completed during the executive period. This is based on status timing, not logged spent time.">Avg Ticket Closure Cycle</div>
        <div class="tj-sc-value tj-sc-blue"><%= format_hours(kpis[:average_closure_hours]) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Average Redmine logged time during the executive period for tickets completed in that same period.">Avg Logged Time / Closed Ticket</div>
        <div class="tj-sc-value <%= kpis[:average_logged_hours_per_completed].to_f.positive? ? 'tj-sc-blue' : 'tj-sc-dim' %>"><%= format_spent_hours(kpis[:average_logged_hours_per_completed]) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Journey-duration formula: rework duration divided by total active journey duration for tickets completed in the executive period. This is not logged spent time.">Journey Rework Ratio</div>
        <div class="tj-sc-value <%= kpis[:work_rework_ratio].to_f.positive? ? 'tj-sc-orange' : 'tj-sc-dim' %>"><%= number_to_percentage(kpis[:work_rework_ratio] * 100, precision: 1) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Logged time in the executive period on completed tickets that did not have return events.">Work Logged Time</div>
        <div class="tj-sc-value <%= kpis[:work_logged_hours].to_f.positive? ? 'tj-sc-green' : 'tj-sc-dim' %>"><%= duration_report_drilldown_link(@query, report[:links][:logged_work], format_spent_hours(kpis[:work_logged_hours]), title: 'Completed tickets without return events') %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Logged time in the executive period on completed tickets that had at least one return event.">Rework Logged Time</div>
        <div class="tj-sc-value <%= kpis[:rework_logged_hours].to_f.positive? ? 'tj-sc-orange' : 'tj-sc-dim' %>"><%= duration_report_drilldown_link(@query, report[:links][:logged_rework], format_spent_hours(kpis[:rework_logged_hours]), title: 'Completed tickets with return events') %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Formula: logged time on completed tickets with return events / all logged time on completed tickets during the executive period.">Rework Logged Ratio</div>
        <div class="tj-sc-value <%= kpis[:rework_logged_ratio].to_f.positive? ? 'tj-sc-orange' : 'tj-sc-dim' %>"><%= number_to_percentage(kpis[:rework_logged_ratio] * 100, precision: 1) %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label" title="Tickets with Due date on or before the executive period end date that were not closed as of that date.">Technical Debt Count</div>
        <div class="tj-sc-value <%= kpis[:technical_debt_count].to_i.positive? ? 'tj-sc-red' : 'tj-sc-green' %>"><%= duration_report_drilldown_link(@query, report[:links][:technical_debt], kpis[:technical_debt_count], title: 'Open due-date technical debt at period end') %></div>
      </div>
    </div>

    <div class="tj-detail-grid">
      <div class="tj-card">
        <div class="tj-card-title">Average Closure Cycle by Tracker</div>
        <table class="tj-health-table">
          <thead>
            <tr>
              <th class="tj-th-title">Tracker</th>
              <th class="tj-th-native">Number of Tickets</th>
              <th class="tj-th-native">Total Cycle</th>
              <th class="tj-th-native">Avg Cycle / Ticket</th>
              <th class="tj-th-native">Total Logged Time</th>
              <th class="tj-th-native">Avg Logged / Ticket</th>
            </tr>
          </thead>
          <tbody>
            <% if report[:cycle_by_tracker_rows].empty? %>
              <tr><td class="tj-flow-empty-note" colspan="6">No tickets were closed in the selected period.</td></tr>
            <% end %>
            <% report[:cycle_by_tracker_rows].first(8).each do |row| %>
              <tr>
                <td class="tj-health-label"><%= h(row[:tracker]) %></td>
                <td class="tj-health-count"><%= duration_report_drilldown_link(@query, row[:issue_ids], row[:count]) %></td>
                <td class="tj-health-count"><%= format_hours(row[:total_cycle_hours]) %></td>
                <td class="tj-health-count"><%= format_hours(row[:avg_cycle_hours]) %></td>
                <td class="tj-health-count"><%= format_spent_hours(row[:total_logged_hours]) %></td>
                <td class="tj-health-count"><%= format_spent_hours(row[:avg_logged_hours]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="tj-card">
        <div class="tj-card-title">Work vs Rework for Selected Period</div>
        <%
          work_rework_rows = report[:work_rework_rows]
          work_spent_row = work_rework_rows.find { |row| row[:label] == 'Work Time' }
          rework_spent_row = work_rework_rows.find { |row| row[:label] == 'Rework Time' }
          logged_rework_percent = (rework_spent_row&.fetch(:spent_share, 0.0).to_f * 100).round(1)
          logged_work_percent = (work_spent_row&.fetch(:spent_share, 0.0).to_f * 100).round(1)
          logged_total_hours = work_rework_rows.find { |row| row[:label] == 'Total' }&.fetch(:spent_hours, 0.0).to_f
        %>
        <div class="tj-pie-summary">
          <% if logged_total_hours.positive? %>
            <div class="tj-pie-chart"
                 style="background: conic-gradient(var(--tj-orange) 0 <%= logged_rework_percent %>%, var(--tj-green) <%= logged_rework_percent %>% 100%);"
                 title="Logged spent time split: work <%= logged_work_percent %>%, rework <%= logged_rework_percent %>%"></div>
          <% else %>
            <div class="tj-pie-chart tj-pie-chart-empty" title="No logged work or rework time in the selected period"></div>
          <% end %>
          <div class="tj-pie-legend">
            <div><span class="tj-pie-key tj-pie-key-work"></span> Work logged time <strong><%= number_to_percentage(logged_work_percent, precision: 1) %></strong></div>
            <div><span class="tj-pie-key tj-pie-key-rework"></span> Rework logged time <strong><%= number_to_percentage(logged_rework_percent, precision: 1) %></strong></div>
          </div>
        </div>
        <div class="tj-compact-metrics">
          <div class="tj-compact-metric-row tj-compact-metric-head">
            <div></div>
            <div class="tj-compact-metric-values">
              <span>Cycle</span>
              <span>Logged</span>
            </div>
          </div>
          <% work_rework_rows.each do |row| %>
            <div class="tj-compact-metric-row">
              <div class="tj-compact-metric-label"><%= h(row[:label]) %></div>
              <div class="tj-compact-metric-values">
                <span title="Duration cycle"><%= duration_report_drilldown_link(@query, row[:issue_ids], format_hours(row[:duration_hours])) %> <small><%= number_to_percentage(row[:duration_share] * 100, precision: 1) %></small></span>
                <span title="Logged spent time"><%= duration_report_drilldown_link(@query, row[:issue_ids], format_spent_hours(row[:spent_hours])) %> <small><%= number_to_percentage(row[:spent_share] * 100, precision: 1) %></small></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="tj-detail-grid">
      <div class="tj-card">
        <div class="tj-card-title">Bugs Created vs Resolved Trend</div>
        <table class="tj-health-table">
          <thead>
            <tr>
              <th class="tj-th-title">Period</th>
              <th class="tj-th-native">Created</th>
              <th class="tj-th-native">Resolved</th>
            </tr>
          </thead>
          <tbody>
            <% report[:bug_trend_rows].each do |row| %>
              <tr>
                <td class="tj-health-label"><%= h(row[:period]) %></td>
                <td class="tj-health-count tj-sc-orange"><%= row[:found] %></td>
                <td class="tj-health-count tj-sc-green"><%= row[:resolved] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="tj-card">
        <div class="tj-card-title">Technical Debt by Project</div>
        <table class="tj-health-table">
          <tbody>
            <% if report[:technical_debt_rows].empty? %>
              <tr><td class="tj-flow-empty-note">No open due-date technical debt found at the period end.</td></tr>
            <% end %>
            <% report[:technical_debt_rows].each do |row| %>
              <tr>
                <td class="tj-health-label"><%= h(row[:project]) %></td>
                <td class="tj-health-count"><%= duration_report_drilldown_link(@query, row[:issue_ids], row[:count]) %></td>
                <td class="tj-health-percent">open debt</td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="tj-flow-empty-note">Technical debt uses Due date and historical status at the executive period end.</div>
      </div>
    </div>
  <% end %>
</div>
