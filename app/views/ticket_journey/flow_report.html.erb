<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ticket_journey', plugin: 'redmine_ticket_journey' %>
<% end %>

<div id="tj-wrap">

  <div class="tj-page-header">
    <div class="tj-page-header-left">
      <div>
        <h2><%= ticket_journey_header_context_tag(:sprint_delivery) %>Flow Report</h2>
        <p class="tj-page-sub">Status and tracker trend snapshots &mdash; <%= @project.name %></p>
      </div>
    </div>
  </div>

  <%= render partial: 'report_tabs', locals: { active_tab: :flow_report } %>

  <%= form_tag(ticket_journey_flow_report_path(@project), method: :get, id: 'query_form') do %>
    <%= hidden_field_tag :support_section, params[:support_section] if params[:support_section].present? %>
    <%= render partial: 'queries/query_form' %>

    <div class="tj-filter-bar tj-owner-filter-bar">
      <div class="tj-filter-form">
        <div class="tj-filter-group">
          <label for="flow_start_date">Period Start</label>
          <%= date_field_tag :flow_start_date, @flow_start_date, class: 'tj-input' %>
        </div>
        <div class="tj-filter-group">
          <label for="flow_end_date">Period End</label>
          <%= date_field_tag :flow_end_date, @flow_end_date, class: 'tj-input' %>
        </div>
        <div class="tj-filter-group">
          <label for="ticket_owner_role_id">Ticket Owner Role</label>
          <%= select_tag :ticket_owner_role_id,
                options_for_select([['All roles', 'all']] + @owner_roles.map { |role| [role.name, role.id] }, @selected_owner_role_option),
                class: 'tj-input' %>
        </div>
        <div class="tj-filter-group tj-flow-filter-note">
          <span>Default: Any Status, including closed tickets. Saved queries and explicitly selected filters are respected. Use the Redmine filters above for project/subprojects, tracker, ticket owner, status, and other issue fields.</span>
        </div>
      </div>
    </div>
  <% end %>

  <% if !@query.valid? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>Invalid filters</h3>
      <p>Please review the Redmine query filters above.</p>
    </div>
  <% elsif @flow_issues.empty? %>
    <div class="tj-empty">
      <div class="tj-empty-icon">Report</div>
      <h3>No flow data found</h3>
      <p>Try adjusting the date range, role, or Redmine query filters above.</p>
    </div>
  <% else %>
    <div class="tj-summary-strip">
      <div class="tj-summary-card">
        <div class="tj-sc-label">Issues</div>
        <div class="tj-sc-value tj-sc-accent"><%= @flow_summary[:issues] %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Snapshots</div>
        <div class="tj-sc-value tj-sc-blue"><%= @flow_summary[:snapshots] %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">Start Total</div>
        <div class="tj-sc-value tj-sc-dim"><%= @flow_summary[:start_total] %></div>
      </div>
      <div class="tj-summary-card">
        <div class="tj-sc-label">End Total</div>
        <div class="tj-sc-value tj-sc-green"><%= @flow_summary[:end_total] %></div>
      </div>
    </div>

    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Status Trend</div>
      <%
        status_column_totals = @flow_dates.each_index.map { |index| @flow_status_rows.sum { |row| row[:counts][index].to_i } }
        status_change_total = @flow_status_rows.sum { |row| row[:change].to_i }
        status_rate_total = @flow_status_rows.sum { |row| row[:rate].to_f }
      %>
      <div class="tj-table-wrap tj-flow-table-wrap">
        <table class="tj-table tj-flow-table tj-status-trend-table">
          <thead>
            <tr>
              <th class="tj-th-title">Status</th>
              <% @flow_dates.each do |date| %>
                <th class="tj-th-native"><%= format_date(date) %></th>
              <% end %>
              <th class="tj-th-native">Change</th>
              <th class="tj-th-native">Rate / Week</th>
            </tr>
          </thead>
          <tbody>
            <% @flow_status_rows.each do |row| %>
              <tr class="tj-row <%= row[:separator_before] ? 'tj-flow-group-start' : '' %>">
                <td class="tj-td-title"><%= h(row[:label]) %></td>
                <% row[:counts].each do |count| %>
                  <td class="tj-td-native"><%= count.zero? ? '-' : count %></td>
                <% end %>
                <td class="tj-td-native <%= row[:change].positive? ? 'tj-flow-positive' : (row[:change].negative? ? 'tj-flow-negative' : '') %>"><%= row[:change] %></td>
                <td class="tj-td-native"><%= number_with_precision(row[:rate], precision: 1, strip_insignificant_zeros: true) %></td>
              </tr>
            <% end %>
            <tr class="tj-flow-total-row">
              <td class="tj-td-title tj-total-label">Total</td>
              <% status_column_totals.each do |count| %>
                <td class="tj-td-native"><%= count.zero? ? '-' : count %></td>
              <% end %>
              <td class="tj-td-native <%= status_change_total.positive? ? 'tj-flow-positive' : (status_change_total.negative? ? 'tj-flow-negative' : '') %>"><%= status_change_total %></td>
              <td class="tj-td-native"><%= number_with_precision(status_rate_total, precision: 1, strip_insignificant_zeros: true) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Tracker Trend</div>
      <%
        tracker_column_totals = @flow_dates.each_index.map { |index| @flow_tracker_rows.sum { |row| row[:counts][index].to_i } }
        tracker_change_total = @flow_tracker_rows.sum { |row| row[:change].to_i }
        tracker_rate_total = @flow_tracker_rows.sum { |row| row[:rate].to_f }
      %>
      <div class="tj-table-wrap tj-flow-table-wrap">
        <table class="tj-table tj-flow-table">
          <thead>
            <tr>
              <th class="tj-th-title">Tracker</th>
              <% @flow_dates.each do |date| %>
                <th class="tj-th-native"><%= format_date(date) %></th>
              <% end %>
              <th class="tj-th-native">Change</th>
              <th class="tj-th-native">Rate / Week</th>
            </tr>
          </thead>
          <tbody>
            <% @flow_tracker_rows.each do |row| %>
              <tr class="tj-row">
                <td class="tj-td-title"><%= h(row[:label]) %></td>
                <% row[:counts].each do |count| %>
                  <td class="tj-td-native"><%= count.zero? ? '-' : count %></td>
                <% end %>
                <td class="tj-td-native <%= row[:change].positive? ? 'tj-flow-positive' : (row[:change].negative? ? 'tj-flow-negative' : '') %>"><%= row[:change] %></td>
                <td class="tj-td-native"><%= number_with_precision(row[:rate], precision: 1, strip_insignificant_zeros: true) %></td>
              </tr>
            <% end %>
            <tr class="tj-flow-total-row">
              <td class="tj-td-title tj-total-label">Total</td>
              <% tracker_column_totals.each do |count| %>
                <td class="tj-td-native"><%= count.zero? ? '-' : count %></td>
              <% end %>
              <td class="tj-td-native <%= tracker_change_total.positive? ? 'tj-flow-positive' : (tracker_change_total.negative? ? 'tj-flow-negative' : '') %>"><%= tracker_change_total %></td>
              <td class="tj-td-native"><%= number_with_precision(tracker_rate_total, precision: 1, strip_insignificant_zeros: true) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="tj-card tj-card-full">
      <div class="tj-card-title">Return Reason Analysis</div>
      <% if @flow_return_reason_rows.empty? %>
        <div class="tj-flow-empty-note">No tickets entered Returned during this period.</div>
      <% else %>
        <%
          return_reason_total = @flow_return_reason_rows.sum { |row| row[:count].to_i }
          reason_colors = %w[#2563eb #d97706 #059669 #9333ea #dc2626 #0891b2 #be185d #64748b]
          reason_offset = 0.0
          reason_segments = @flow_return_reason_rows.each_with_index.map do |row, index|
            segment_start = reason_offset
            reason_offset += return_reason_total.positive? ? row[:count].to_f / return_reason_total * 100 : 0
            start_angle = segment_start / 100 * 2 * Math::PI - Math::PI / 2
            end_angle = reason_offset / 100 * 2 * Math::PI - Math::PI / 2
            middle_angle = (start_angle + end_angle) / 2
            {
              path: "M 120 120 L #{120 + 112 * Math.cos(start_angle)} #{120 + 112 * Math.sin(start_angle)} A 112 112 0 #{reason_offset - segment_start > 50 ? 1 : 0} 1 #{120 + 112 * Math.cos(end_angle)} #{120 + 112 * Math.sin(end_angle)} Z",
              full: row[:count].to_i == return_reason_total,
              percent: reason_offset - segment_start,
              x: 120 + 76 * Math.cos(middle_angle),
              y: 120 + 76 * Math.sin(middle_angle)
            }
          end
        %>
        <div class="tj-flow-reason-layout">
        <div class="tj-table-wrap tj-flow-reason-wrap">
          <table class="tj-table tj-flow-reason-table">
            <thead>
              <tr>
                <th class="tj-th-title">Return Reason</th>
                <th class="tj-th-native">Count</th>
                <th class="tj-th-native">%</th>
              </tr>
            </thead>
            <tbody>
              <% @flow_return_reason_rows.each_with_index do |row, index| %>
                <tr class="tj-row" data-reason-index="<%= index %>">
                  <td class="tj-td-title"><span class="tj-flow-reason-key" style="background-color: <%= reason_colors[index % reason_colors.size] %>;" aria-hidden="true"></span><%= h(row[:reason]) %></td>
                  <td class="tj-td-native"><%= row[:count] %></td>
                  <td class="tj-td-native"><%= number_to_percentage(row[:percent] * 100, precision: 0) %></td>
                </tr>
              <% end %>
              <tr class="tj-total-row">
                <td class="tj-td-title tj-total-label">Total</td>
                <td class="tj-td-native"><%= return_reason_total %></td>
                <td class="tj-td-native">100%</td>
              </tr>
            </tbody>
          </table>
        </div>
        <% if return_reason_total.positive? %>
          <figure class="tj-flow-reason-chart">
            <svg class="tj-flow-reason-pie" viewBox="0 0 240 240" role="group" aria-label="Return reasons pie chart">
              <% @flow_return_reason_rows.each_with_index do |row, index| %>
                <% segment = reason_segments[index]; tooltip = "#{row[:reason]}: #{row[:count]} returns (#{number_to_percentage(row[:percent] * 100, precision: 0)})" %>
                <g class="tj-flow-reason-slice" data-reason-index="<%= index %>" tabindex="0" role="img" aria-label="<%= tooltip %>">
                  <title><%= tooltip %></title>
                  <% if segment[:full] %>
                    <circle cx="120" cy="120" r="112" fill="<%= reason_colors[index % reason_colors.size] %>" />
                  <% else %>
                    <path d="<%= segment[:path] %>" fill="<%= reason_colors[index % reason_colors.size] %>" />
                  <% end %>
                  <% if segment[:percent].round >= 7 %>
                    <text x="<%= segment[:full] ? 120 : segment[:x] %>" y="<%= segment[:full] ? 120 : segment[:y] %>" class="tj-flow-reason-percent" aria-hidden="true"><%= number_to_percentage(row[:percent] * 100, precision: 0) %></text>
                  <% end %>
                </g>
              <% end %>
            </svg>
            <div class="tj-flow-reason-tooltip" aria-live="polite">Hover a slice or focus it to see details.</div>
            <figcaption>Return reasons — <%= return_reason_total %> total<br>Colors match the table.</figcaption>
          </figure>
        <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

</div>

<script>
  (function () {
    document.querySelectorAll('.tj-flow-reason-layout').forEach(function (layout) {
      var tooltip = layout.querySelector('.tj-flow-reason-tooltip');
      if (!tooltip) return;
      var items = layout.querySelectorAll('[data-reason-index]');
      function highlight(index) {
        items.forEach(function (item) {
          item.classList.toggle('is-highlighted', item.dataset.reasonIndex === index);
        });
        var slice = layout.querySelector('.tj-flow-reason-slice[data-reason-index="' + index + '"]');
        tooltip.textContent = slice ? slice.getAttribute('aria-label') : 'Hover a slice or focus it to see details.';
      }
      items.forEach(function (item) {
        item.addEventListener('mouseenter', function () { highlight(item.dataset.reasonIndex); });
        item.addEventListener('mouseleave', function () {
          var focused = layout.querySelector('.tj-flow-reason-slice:focus');
          highlight(focused ? focused.dataset.reasonIndex : '');
        });
        item.addEventListener('focus', function () { highlight(item.dataset.reasonIndex); });
        item.addEventListener('blur', function () { highlight(''); });
      });
    });
  })();
</script>
